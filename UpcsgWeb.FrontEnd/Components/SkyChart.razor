@using System.Globalization

<figure class="upcsg-sky @(Points.Count == 0 ? "upcsg-sky--empty" : null)" aria-label="@Summary">
    <svg class="upcsg-sky__svg" viewBox="0 0 @W @H" preserveAspectRatio="xMidYMax meet" role="img">
        <title>@Summary</title>

        <defs>
            <linearGradient id="upcsg-sky-arc" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color="#F6C875" stop-opacity="0.9" />
                <stop offset="0.5" stop-color="#CCAEDE" stop-opacity="0.65" />
                <stop offset="1" stop-color="#CCAEDE" stop-opacity="0.12" />
            </linearGradient>
        </defs>

        @for (var r = 1; r <= 3; r++)
        {
            <path class="upcsg-sky__grid" d="@Dome(Peak * r / 3.0)" />
        }

        <line class="upcsg-sky__horizon" x1="0" y1="@Fmt(Base)" x2="@W" y2="@Fmt(Base)" />

        @for (var d = 0; d <= Days; d++)
        {
            var date = Today.AddDays(d);
            var x = X(d);
            var major = date.Day == 1;
            var week = !major && date.DayOfWeek == DayOfWeek.Monday;
            <line class="upcsg-sky__tick @(major ? "upcsg-sky__tick--month" : week ? "upcsg-sky__tick--week" : null)"
                  x1="@Fmt(x)" y1="@Fmt(Base)" x2="@Fmt(x)" y2="@Fmt(Base + (major ? 18 : week ? 10 : 5))" />

            @if (major)
            {
                <g><text class="upcsg-sky__month" x="@Fmt(x + 6)" y="@Fmt(Base + 30)">@date.ToString("MMM", CultureInfo.InvariantCulture).ToUpperInvariant()</text></g>
            }
        }

        <path class="upcsg-sky__arc" d="@Dome(Peak)" pathLength="1" stroke="url(#upcsg-sky-arc)" />

        <g class="upcsg-sky__today">
            <line x1="@Fmt(X(0))" y1="@Fmt(Base - 8)" x2="@Fmt(X(0))" y2="@Fmt(Base + 18)" />
            <text x="@Fmt(X(0) + 6)" y="@Fmt(Base + 30)">TODAY</text>
        </g>

        @foreach (var (p, i) in Placed.Select((p, i) => (p, i)))
        {
            var x = X(p.Offset);
            var y = Y(p.Offset);
            var size = p.Kind == SkyKind.Event ? 15 : 11;
            var anchor = p.AnchorEnd ? "end" : "start";
            var lx = p.LabelX;
            var ly = p.LabelY;

            <a class="upcsg-sky__point upcsg-sky__point--@p.Kind.ToString().ToLowerInvariant() @(p.Urgent ? "upcsg-sky__point--urgent" : null)"
               href="@p.Href"
               style="--i: @i">
                <title>@p.Title, @p.KindLabel @p.When.ToString("MMMM d", CultureInfo.InvariantCulture)</title>

                <line class="upcsg-sky__plumb" x1="@Fmt(x)" y1="@Fmt(y + size)" x2="@Fmt(x)" y2="@Fmt(Base)" />
                <circle class="upcsg-sky__halo" cx="@Fmt(x)" cy="@Fmt(y)" r="@(size + 9)" />
                <path class="upcsg-sky__star" d="@Star(x, y, size)" />

                <g class="upcsg-sky__label">
                    @if (Math.Abs(lx - x) > 24 || Math.Abs(ly - y) > 40)
                    {
                        <line class="upcsg-sky__leader" x1="@Fmt(x)" y1="@Fmt(y)" x2="@Fmt(lx)" y2="@Fmt(ly + 4)" />
                    }
                    <text class="upcsg-sky__when" x="@Fmt(lx)" y="@Fmt(ly)" text-anchor="@anchor">
                        @p.When.ToString("MMM d", CultureInfo.InvariantCulture).ToUpperInvariant() &#183; @p.KindLabel.ToUpperInvariant()
                    </text>
                    <text class="upcsg-sky__title" x="@Fmt(lx)" y="@Fmt(ly + 19)" text-anchor="@anchor">@Clip(p.Title)</text>
                </g>
            </a>
        }

        @if (Points.Count == 0)
        {
            <g><text class="upcsg-sky__none" x="@Fmt(W / 2)" y="@Fmt(Base - Peak * 0.42)" text-anchor="middle">Nothing charted for the next @Days days</text></g>
        }
    </svg>

    @if (Placed.Count > 0)
    {
        <ol class="upcsg-sky__list">
            @foreach (var p in Placed)
            {
                <li>
                    <a href="@p.Href" class="upcsg-sky__item upcsg-sky__item--@p.Kind.ToString().ToLowerInvariant()">
                        <span class="upcsg-sky__item-when">@p.When.ToString("MMM d", CultureInfo.InvariantCulture)</span>
                        <span class="upcsg-sky__item-title">@p.Title</span>
                        <span class="upcsg-sky__item-kind">@p.KindLabel</span>
                    </a>
                </li>
            }
        </ol>
    }

    <figcaption class="upcsg-sky__legend">
        <span><i class="upcsg-sky__key upcsg-sky__key--event"></i> Event</span>
        <span><i class="upcsg-sky__key upcsg-sky__key--deadline"></i> Deadline</span>
        <span><i class="upcsg-sky__key upcsg-sky__key--happens"></i> Competition day</span>
        <span class="upcsg-sky__span">Next @Days days</span>
    </figcaption>
</figure>

@code {
    public enum SkyKind
    {
        Event,
        Deadline,
        Happens,
    }

    public sealed record SkyPoint(DateTime When, string Title, string Href, SkyKind Kind, bool Urgent = false);

    private sealed record Plot(DateTime When, string Title, string Href, SkyKind Kind, bool Urgent, double Offset,
        double LabelX, double LabelY, bool AnchorEnd)
    {
        public string KindLabel => Kind switch
        {
            SkyKind.Event => "Event",
            SkyKind.Deadline => "Deadline",
            _ => "Happens",
        };
    }

    private const double W = 1200;
    private const double H = 380;
    private const double Base = 320;
    private const double Peak = 230;
    private const double Inset = 36;
    private const int MaxPlotted = 7;

    [Parameter] public IReadOnlyList<SkyPoint> Points { get; set; } = [];

    [Parameter] public int Days { get; set; } = 60;

    private static DateTime Today => DateTime.Today;

    private List<Plot> Placed { get; set; } = [];

    private string Summary => Placed.Count == 0
        ? $"Sky chart of the next {Days} days: nothing scheduled yet."
        : $"Sky chart of the next {Days} days: {Placed.Count} thing{(Placed.Count == 1 ? "" : "s")} coming up.";

    protected override void OnParametersSet()
    {
        var horizon = Today.AddDays(Days);
        var upcoming = Points
            .Where(p => p.When >= Today && p.When <= horizon)
            .OrderBy(p => p.When)
            .Take(MaxPlotted)
            .ToList();

        Placed = [];

        var stars = upcoming.Select(p => (X: X((p.When - Today).TotalDays), Y: Y((p.When - Today).TotalDays))).ToList();
        var boxes = new List<(double L, double T, double R, double B)>();

        for (var i = 0; i < upcoming.Count; i++)
        {
            var p = upcoming[i];
            var offset = (p.When - Today).TotalDays;
            var (x, y) = stars[i];
            var width = Math.Max(Math.Min(p.Title.Length, 30) * 8.3, 140);

            var chosen = (X: x + 16, Y: y - 30, End: false);
            var found = false;

            foreach (var (dx, dy, end) in Candidates)
            {
                var lx = end ? x - dx : x + dx;
                var ly = y + dy;
                var box = end
                    ? (L: lx - width, T: ly - 13, R: lx, B: ly + 24)
                    : (L: lx, T: ly - 13, R: lx + width, B: ly + 24);

                if (box.L < 0 || box.R > W || box.T < 0 || box.B > Base - 6)
                {
                    continue;
                }

                if (boxes.Any(o => Overlaps(o, box)) ||
                    stars.Any(s => s.X > box.L - 14 && s.X < box.R + 14 && s.Y > box.T - 14 && s.Y < box.B + 14) ||
                    CrossesArc(box))
                {
                    continue;
                }

                chosen = (lx, ly, end);
                boxes.Add(box);
                found = true;
                break;
            }

            if (!found)
            {
                boxes.Add((chosen.X, chosen.Y - 13, chosen.X + width, chosen.Y + 24));
            }

            Placed.Add(new Plot(p.When, p.Title, p.Href, p.Kind, p.Urgent, offset, chosen.X, chosen.Y, chosen.End));
        }
    }

    private static readonly (double Dx, double Dy, bool End)[] Candidates =
    [
        (16, -34, false), (16, 30, false), (16, -34, true), (16, 30, true),
        (20, 2, false), (20, 2, true),
        (22, -74, false), (22, 70, false), (22, -74, true), (22, 70, true),
        (26, -114, false), (26, 110, false), (26, -114, true), (26, 110, true),
        (60, 40, false), (60, -150, false), (60, -150, true),
    ];

    private static bool Overlaps((double L, double T, double R, double B) a, (double L, double T, double R, double B) b) =>
        a.L < b.R + 10 && b.L < a.R + 10 && a.T < b.B + 4 && b.T < a.B + 4;

    private bool CrossesArc((double L, double T, double R, double B) box)
    {
        for (var x = box.L; x <= box.R; x += 8)
        {
            var t = (x - Inset) / (W - 2 * Inset);
            if (t is < 0 or > 1)
            {
                continue;
            }

            var y = Base - Peak * Math.Sin(Math.PI * t);
            if (y > box.T - 6 && y < box.B + 6)
            {
                return true;
            }
        }

        return false;
    }

    private double X(double day) => Inset + (W - 2 * Inset) * Math.Clamp(day / Days, 0, 1);

    private double Y(double day) => Base - Peak * Math.Sin(Math.PI * Math.Clamp(day / Days, 0, 1));

    private string Dome(double peak)
    {
        var sb = new System.Text.StringBuilder();
        const int steps = 48;
        for (var s = 0; s <= steps; s++)
        {
            var t = (double)s / steps;
            var x = Inset + (W - 2 * Inset) * t;
            var y = Base - peak * Math.Sin(Math.PI * t);
            sb.Append(s == 0 ? "M" : " L").Append(Fmt(x)).Append(' ').Append(Fmt(y));
        }

        return sb.ToString();
    }

    private static string Star(double cx, double cy, double r)
    {
        var w = r * 0.2;
        return $"M{Fmt(cx)} {Fmt(cy - r)} L{Fmt(cx + w)} {Fmt(cy - w)} L{Fmt(cx + r)} {Fmt(cy)} L{Fmt(cx + w)} {Fmt(cy + w)} " +
               $"L{Fmt(cx)} {Fmt(cy + r)} L{Fmt(cx - w)} {Fmt(cy + w)} L{Fmt(cx - r)} {Fmt(cy)} L{Fmt(cx - w)} {Fmt(cy - w)} Z";
    }

    private static string Clip(string title) => title.Length <= 30 ? title : title[..29].TrimEnd() + "…";

    private static string Fmt(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}
