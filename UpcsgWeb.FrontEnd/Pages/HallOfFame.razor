@page "/hall-of-fame"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IAchievementService AchievementService

<PageTitle>Hall of Fame - UPCSG</PageTitle>

<PageMasthead Section="Hall of Fame"
              Meta="@([_loading ? null : $"{_all.Count} on the record", "Verified by the ExeCom"])"
              Title="What we've"
              Accent="won">
    <Lede>
        The wins, awards, and milestones our members and the guild have collected over the
        years, each one written up properly, not just listed.
    </Lede>
</PageMasthead>

<div class="upcsg-page upcsg-page--after-hero">

    @if (_loading)
    {
        <section class="upcsg-section">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="280px" Class="upcsg-skeleton mb-6" />
            <div class="upcsg-cardgrid upcsg-cardgrid--3">
                @for (var i = 0; i < 3; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="upcsg-skeleton" />
                }
            </div>
        </section>
    }
    else if (_all.Count == 0)
    {
        <section class="upcsg-section">
            <Reveal Variant="Reveal.RevealMotion.Fade">
                <div class="upcsg-empty upcsg-empty--tall">
                    <img src="img/upcsg-crest.png" alt="" aria-hidden="true" />
                    <h2 class="upcsg-title-xl">The record is empty</h2>
                    <p>
                        Nothing has been verified for the record yet. If you brought something home
                        for the guild, we'd rather hear about it than miss it.
                    </p>
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="contact">
                        Tell us about a win
                    </MudButton>
                </div>
            </Reveal>
        </section>
    }
    else
    {
        @if (Lead is not null)
        {
            <section class="upcsg-section">
                <Reveal Variant="Reveal.RevealMotion.Scale">
                    <AchievementCard Entry="Lead" Variant="AchievementCard.Density.Lead" />
                </Reveal>
            </section>
        }

        <section class="upcsg-section">
            <SectionHeading Kicker="@(_activeCategory is null ? "All categories" : $"Filtered by {_activeCategory}")"
                            Title="The Record"
                            Lede="We only list achievements the ExeCom can verify. Wins from earlier years are being confirmed and added as we go. If one is missing, tell us and we'll chase the record down." />

            @if (_categories.Count > 1)
            {
                <Reveal Variant="Reveal.RevealMotion.Fade" Class="upcsg-filterrow">
                    <MudChipSet T="string"
                                SelectionMode="SelectionMode.SingleSelection"
                                SelectedValue="@(_activeCategory ?? AllFilter)"
                                SelectedValueChanged="SetCategory"
                                CheckMark="true">
                        <MudChip T="string" Value="@AllFilter" Variant="Variant.Outlined">
                            All (@_all.Count)
                        </MudChip>

                        @foreach (var category in _categories)
                        {
                            <MudChip T="string" Value="@category" Variant="Variant.Outlined">
                                @category (@_all.Count(a => a.Category == category))
                            </MudChip>
                        }
                    </MudChipSet>
                </Reveal>
            }

            @if (Visible.Count == 0)
            {
                <Reveal Variant="Reveal.RevealMotion.Fade">
                    <div class="upcsg-empty">
                        <p>Nothing else recorded under this category yet.</p>
                    </div>
                </Reveal>
            }
            else
            {
                @foreach (var group in Visible.GroupBy(a => a.Year).OrderByDescending(g => g.Key))
                {
                    <Reveal Variant="Reveal.RevealMotion.Fade" Class="upcsg-yearrule">
                        <h3 class="upcsg-yearrule__year">@group.Key</h3>
                        <span class="upcsg-yearrule__line"></span>
                        <span class="upcsg-yearrule__count">@group.Count() entr@(group.Count() == 1 ? "y" : "ies")</span>
                    </Reveal>

                    <div class="upcsg-cardgrid upcsg-cardgrid--3 upcsg-recordgrid">
                        @foreach (var (entry, i) in group.OrderBy(a => a.Title).Select((a, i) => (a, i)))
                        {
                            <Reveal Variant="Reveal.RevealMotion.Scale" Delay="@(i * 70)">
                                <AchievementCard Entry="entry" />
                            </Reveal>
                        }
                    </div>
                }
            }
        </section>
    }

    <section class="upcsg-section upcsg-closing">

        <Reveal Variant="Reveal.RevealMotion.Up" Class="upcsg-closing__inner">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Missing something?</p>
            <h2 class="upcsg-title-xl">Tell us about a win</h2>
            <p class="upcsg-lede">
                If you or a batchmate brought something home for the guild and it isn't here,
                send it our way and we'll add it to the record.
            </p>
            <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8" Href="contact">
                Get in Touch
            </MudButton>
        </Reveal>
    </section>

</div>

@code {
    private const string AllFilter = "all";

    private List<AchievementDto> _all = [];
    private List<string> _categories = [];
    private string? _activeCategory;
    private bool _loading = true;

    private AchievementDto? Lead => _all
        .OrderByDescending(a => a.Year)
        .ThenByDescending(a => a.Id)
        .FirstOrDefault();

    private List<AchievementDto> Visible =>
        [.. (_activeCategory is null ? _all : _all.Where(a => a.Category == _activeCategory))
            .Where(a => a.Id != Lead?.Id)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _all = await AchievementService.GetAchievementsAsync();

            _categories = [.. _all
                .Select(a => a.Category)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c!)
                .Distinct()
                .OrderBy(c => c)];
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetCategory(string? category) =>
        _activeCategory = category is null or AllFilter ? null : category;
}
