@page "/contact"

<PageTitle>Contact - UPCSG</PageTitle>

<section class="upcsg-banner">
    <img class="upcsg-banner__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
    <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 26%; right: 32%;"><span class="upcsg-star" style="width: 1rem; height: 1rem;"></span></span>
    <span class="upcsg-sparkle upcsg-sparkle--lilac upcsg-sparkle--delay-2" style="bottom: 30%; right: 44%;"><span class="upcsg-star" style="width: 0.65rem; height: 0.65rem;"></span></span>

    <div class="upcsg-banner__inner">
        <p class="upcsg-eyebrow"><span class="upcsg-star"></span> Reach the guild</p>
        <h1 class="upcsg-banner__title">Get in Touch</h1>
        <p class="upcsg-lede" style="margin-bottom: 0;">
            Questions about events, merch, or getting involved? Every channel below reaches the
            same set of officers &mdash; pick whichever you already have open.
        </p>
    </div>
</section>

<Marquee Items="@Ticker" DurationSeconds="48" Class="upcsg-marquee--hero" />

<div class="upcsg-page upcsg-page--after-hero">

    <section class="upcsg-section">
        <SectionHeading Kicker="Where to reach us" Title="Pick a channel" />

        <div class="upcsg-cardgrid upcsg-cardgrid--3 upcsg-recordgrid">
            <Reveal Variant="Reveal.RevealMotion.Scale">
                <ChannelCard Href="https://facebook.com/upcsg"
                             Icon="@Icons.Custom.Brands.Facebook"
                             Label="Facebook"
                             Handle="/UPCSG"
                             Cue="Open page"
                             External="true">
                    Where announcements go up first. Best for anything time-sensitive &mdash;
                    event changes, deadlines, drop dates.
                </ChannelCard>
            </Reveal>

            <Reveal Variant="Reveal.RevealMotion.Scale" Delay="70">
                <ChannelCard Href="https://instagram.com/upcsg"
                             Icon="@Icons.Custom.Brands.Instagram"
                             Label="Instagram"
                             Handle="@("@upcsg")"
                             Cue="Open profile"
                             External="true">
                    Photos from events, merch drops, and the occasional story poll. Drop us a DM
                    if that's easier than a form.
                </ChannelCard>
            </Reveal>

            <Reveal Variant="Reveal.RevealMotion.Scale" Delay="140">
                <ChannelCard Href="mailto:upcsg.upcebu@gmail.com"
                             Icon="@Icons.Material.Filled.Email"
                             Label="Email"
                             Handle="upcsg.upcebu@gmail.com"
                             Cue="Compose">
                    For anything that needs a paper trail: partnerships, sponsorships, requests
                    from other orgs, and documents.
                </ChannelCard>
            </Reveal>
        </div>
    </section>

    <section class="upcsg-section upcsg-feature">
        <Reveal Variant="Reveal.RevealMotion.Left" Class="upcsg-feature__body">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Membership</p>
            <h2 class="upcsg-title-xl">You're already a guilder</h2>
            <p class="upcsg-lede">
                Every Computer Science student at UP Cebu is part of the guild from day one.
                There is no form to fill in and nothing to pay for &mdash; if you're taking the
                degree, you're in.
            </p>
            <p class="upcsg-lede">
                What's up to you is how involved you get. Committees always need hands, teams
                need people to compete, and events need someone to run them. Message us and
                we'll point you at whoever is organising what.
            </p>

            <dl class="upcsg-contact__facts">
                <div>
                    <dt>Campus</dt>
                    <dd>University of the Philippines Cebu</dd>
                </div>
                <div>
                    <dt>Who's a guilder</dt>
                    <dd>Every CS student, automatically</dd>
                </div>
                <div>
                    <dt>To get involved</dt>
                    <dd>Message an officer</dd>
                </div>
            </dl>
        </Reveal>

        <Reveal Variant="Reveal.RevealMotion.Right" Class="upcsg-feature__visual" Delay="120">
            <div class="upcsg-quoteplate">
                <span class="upcsg-quoteplate__mark" aria-hidden="true">&ldquo;</span>
                <blockquote class="upcsg-quoteplate__text">
                    You don't join the guild. You're already in it &mdash; the only question is
                    what you do with it.
                </blockquote>
                <img class="upcsg-quoteplate__burst" src="img/starburst.png" alt="" aria-hidden="true" />
            </div>
        </Reveal>
    </section>

    <section class="upcsg-section">
        <SectionHeading Kicker="Before you message" Title="Asked a lot" />

        <Reveal Variant="Reveal.RevealMotion.Up">
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="upcsg-faq">
                <MudExpansionPanel Text="Do I need to sign up to be a guilder?">
                    No. Every Computer Science student at UP Cebu is a guilder automatically —
                    there's no drive, no form and no fee. Signing in here just links your UP
                    account so officers can see whose merch order is whose.
                </MudExpansionPanel>

                <MudExpansionPanel Text="How do I actually get involved?">
                    Message us. Committees take on people through the year, teams get put
                    together ahead of competitions, and events usually need volunteers the week
                    before. Officers are listed on <MudLink Href="about">the About page</MudLink>.
                </MudExpansionPanel>

                <MudExpansionPanel Text="How do merch orders work?">
                    Add what you want to your cart and check out. You'll then send the GCash
                    reference for your payment, an officer verifies it, and the order moves through
                    confirmed &rarr; released &rarr; received. You can follow all of that from
                    <MudLink Href="orders">My Orders</MudLink>.
                </MudExpansionPanel>

                <MudExpansionPanel Text="Why does the events page only show one month?">
                    Because anything further out is still subject to change, and a calendar full of
                    dates that later move is worse than no calendar. The current month is the one
                    we're confident about.
                </MudExpansionPanel>

                <MudExpansionPanel Text="I won something for the guild and it isn't in the Hall of Fame.">
                    Send it our way. We only list achievements the ExeCom can verify, so entries from
                    earlier years get added as we confirm them &mdash; nothing is being left out on
                    purpose. See <MudLink Href="hall-of-fame">the record</MudLink>.
                </MudExpansionPanel>

                <MudExpansionPanel Text="Can I edit something on this site?">
                    Signing in gives you a guilder account, but editing site content is limited to
                    executive committee accounts. If something here is wrong, message us and we'll
                    fix it.
                </MudExpansionPanel>
            </MudExpansionPanels>
        </Reveal>
    </section>

    <section class="upcsg-section upcsg-closing">
        <div class="upcsg-flare upcsg-closing__flare"></div>

        <Reveal Variant="Reveal.RevealMotion.Up" Class="upcsg-closing__inner">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Still stuck?</p>
            <h2 class="upcsg-title-xl">Just message us</h2>
            <p class="upcsg-lede">
                No question is too small. If you're not sure who to ask, ask us &mdash; we'll route it
                to whoever handles it.
            </p>
            <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8"
                       Href="https://facebook.com/upcsg" Target="_blank">
                Message on Facebook
            </MudButton>
        </Reveal>
    </section>

</div>

@code {
    private static readonly string[] Ticker =
    [
        "Announcements", "Event changes", "Merch drops", "Partnerships",
        "Sponsorships", "Committee sign-ups", "Questions", "UP Cebu",
    ];
}
