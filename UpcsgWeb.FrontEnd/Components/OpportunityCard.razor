@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services

<a class="upcsg-oppcard @(Opportunity.IsFeatured ? "upcsg-oppcard--featured" : null)"
   href="@($"opportunities/{Opportunity.Id}")">

    <CosmicImage Src="@Opportunity.PosterUrl"
                 Alt="@Opportunity.Title"
                 Seed="@Opportunity.Title"
                 Class="upcsg-oppcard__poster" />

    <span class="upcsg-oppcard__body">
        <span class="upcsg-oppcard__meta">
            <span class="upcsg-chip">@OpportunityText.KindLabel(Opportunity.Kind)</span>

            @if (Opportunity.IsFeatured)
            {
                <span class="upcsg-chip upcsg-chip--gold">Featured</span>
            }
        </span>

        <span class="upcsg-oppcard__title">@Opportunity.Title</span>

        @if (!string.IsNullOrWhiteSpace(Opportunity.Organiser))
        {
            <span class="upcsg-oppcard__org">@Opportunity.Organiser</span>
        }

        @if (!string.IsNullOrWhiteSpace(Opportunity.Description))
        {
            <span class="upcsg-oppcard__blurb">@OpportunityText.Summarise(Opportunity.Description)</span>
        }

        <span class="upcsg-oppcard__foot">
            <span class="upcsg-oppcard__deadline">@OpportunityText.Deadline(Opportunity)</span>
            <span class="upcsg-oppcard__arrow" aria-hidden="true">&rarr;</span>
        </span>
    </span>
</a>

@code {
    [Parameter, EditorRequired] public OpportunityDto Opportunity { get; set; } = default!;
}
