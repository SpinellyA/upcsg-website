<nav class="upcsg-drawer__nav" aria-label="Site">
    @foreach (var (href, label) in Links)
    {
        <NavLink class="upcsg-drawer__link"
                 href="@href"
                 Match="@(href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                 @onclick="OnNavigate">
            @label
        </NavLink>
    }
</nav>

@code {
    public static readonly (string Href, string Label)[] Links =
    [
        ("", "Home"),
        ("about", "About"),
        ("events", "Events"),
        ("opportunities", "Opportunities"),
        ("merch", "Merch"),
        ("hall-of-fame", "Hall of Fame"),
        ("contact", "Contact"),
    ];

    [Parameter] public EventCallback OnNavigate { get; set; }
}
