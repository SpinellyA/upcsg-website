@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services

<a class="upcsg-eventcard upcsg-eventcard--@Variant.ToString().ToLowerInvariant() @(Quiet ? "upcsg-eventcard--quiet" : null)"
   href="@($"events/{Event.Id}")">

    @if (Variant != Density.Row)
    {
        <CosmicImage Src="@Event.PosterUrl"
                     Alt="@Event.Title"
                     Seed="@Event.Title"
                     Badge="@(ShowStatus ? EventTiming.StatusLabel(Event) : null)"
                     Class="upcsg-eventcard__poster" />
    }

    <span class="upcsg-eventcard__body">
        @* A coming-soon event has no day to put in the chip. It gets a TBA plate instead of
           a fabricated date; the line under the title carries the rough month if there is one. *@
        @if (Starts is { } starts && !Event.IsComingSoon)
        {
            <span class="upcsg-datechip">
                <span class="upcsg-datechip__month">@starts.ToString("MMM")</span>
                <span class="upcsg-datechip__day">@starts.Day</span>
            </span>
        }
        else
        {
            <span class="upcsg-datechip upcsg-datechip--soon">
                <span class="upcsg-datechip__soon">TBA</span>
            </span>
        }

        <span class="upcsg-eventcard__text">
            <span class="upcsg-eventcard__title">@Event.Title</span>
            <span class="upcsg-eventcard__meta">
                @EventTiming.TimeRange(Event)
                @if (!string.IsNullOrWhiteSpace(Event.Location))
                {
                    <text> &middot; @Event.Location</text>
                }
            </span>

            @if (Variant == Density.Feature && !string.IsNullOrWhiteSpace(Event.Description))
            {
                <span class="upcsg-eventcard__blurb">@FirstParagraph</span>
            }

            @if (Variant == Density.Feature)
            {
                <span class="upcsg-eventcard__countdown upcsg-eventcard__countdown--@EventTiming.StatusSlug(Event)">
                    @EventTiming.Countdown(Event)
                </span>
            }
        </span>

        <span class="upcsg-eventcard__arrow" aria-hidden="true">&rarr;</span>
    </span>
</a>

@code {
    public enum Density
    {
        Card,

        Feature,

        Row,
    }

    [Parameter, EditorRequired] public EventDto Event { get; set; } = default!;

    [Parameter] public Density Variant { get; set; } = Density.Card;

    [Parameter] public bool Quiet { get; set; }

    [Parameter] public bool ShowStatus { get; set; }

    private DateTime? Starts => EventTiming.Starts(Event);

    private string FirstParagraph
    {
        get
        {
            var text = (Event.Description ?? string.Empty).Replace("\r\n", "\n");
            var end = text.IndexOf("\n\n", StringComparison.Ordinal);
            return (end > 0 ? text[..end] : text).Replace('\n', ' ').Trim();
        }
    }
}
