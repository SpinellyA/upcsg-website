@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject ICartService CartService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@* Variant picker plus add button. Signed-out visitors are sent to login rather than
   shown a control that fails on click. *@
<AuthorizeView>
    <Authorized>
        @if (!Item.InStock)
        {
            <MudButton Variant="Variant.Outlined" FullWidth="@FullWidth" Disabled="true">Sold Out</MudButton>
        }
        else
        {
            @if (Item.Variants.Count > 1)
            {
                <MudSelect T="string"
                           @bind-Value="_variant"
                           Label="Variant"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="mb-2">
                    @foreach (var variant in Item.Variants)
                    {
                        <MudSelectItem T="string" Value="@variant">@variant</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudButton Variant="@(Primary ? Variant.Filled : Variant.Outlined)"
                       Size="@(Primary ? Size.Large : Size.Medium)"
                       FullWidth="@FullWidth"
                       Class="@(Primary ? "upcsg-cta-button px-8" : "upcsg-ghost-button")"
                       Disabled="_busy"
                       OnClick="AddAsync">
                @(_busy ? "Adding…" : "Add to Cart")
            </MudButton>
        }
    </Authorized>

    <NotAuthorized>
        <MudButton Variant="@(Primary ? Variant.Filled : Variant.Outlined)"
                   Size="@(Primary ? Size.Large : Size.Medium)"
                   FullWidth="@FullWidth"
                   Class="@(Primary ? "upcsg-cta-button px-8" : "upcsg-ghost-button")"
                   OnClick="GoToLogin">
            Sign in to order
        </MudButton>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter, EditorRequired] public MerchItemDto Item { get; set; } = default!;

    /// <summary>Renders as the page's main call to action.</summary>
    [Parameter] public bool Primary { get; set; }

    [Parameter] public bool FullWidth { get; set; } = true;

    private string? _variant;
    private bool _busy;

    protected override void OnParametersSet()
    {
        // Single-variant items ("One size") shouldn't force a pointless choice.
        _variant ??= Item.Variants.FirstOrDefault();
    }

    private void GoToLogin() => Navigation.NavigateTo("login?returnUrl=merch");

    private async Task AddAsync()
    {
        _busy = true;

        try
        {
            await CartService.AddAsync(Item.Id, _variant, 1);
            Snackbar.Add($"{Item.Name} added to your cart.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
