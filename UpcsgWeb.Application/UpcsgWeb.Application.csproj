<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UpcsgWeb.Domain\UpcsgWeb.Domain.csproj" />

    <!-- Handlers return wire contracts so the API layer has nothing left to do but
         choose a status code. Shared is a DTO-only project with no dependencies of its
         own, so this does not drag delivery concerns into the application layer. -->
    <ProjectReference Include="..\UpcsgWeb.Shared\UpcsgWeb.Shared.csproj" />
  </ItemGroup>

  <!-- Versions match the Scholaris application layer, which is the shape this follows. -->
  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
