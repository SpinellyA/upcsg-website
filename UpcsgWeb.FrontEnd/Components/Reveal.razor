@using UpcsgWeb.FrontEnd.Services
@inject MotionInterop Motion
@implements IAsyncDisposable

<div @ref="_element"
     class="upcsg-reveal upcsg-reveal--@Variant.ToString().ToLowerInvariant() @Class"
     style="--reveal-delay: @(Delay)ms; @Style">
    @ChildContent
</div>

@code {
    public enum RevealMotion
    {
        Up,

        Fade,

        Scale,

        Left,

        Right,
    }

    private ElementReference _element;
    private bool _observed;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RevealMotion Variant { get; set; } = RevealMotion.Up;

    [Parameter] public int Delay { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Style { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_observed)
        {
            return;
        }

        _observed = true;
        await Motion.RevealAsync(_element);
    }

    public async ValueTask DisposeAsync()
    {
        if (_observed)
        {
            await Motion.ReleaseAsync(_element);
        }
    }
}
