@page "/orders/{Id:guid}"
@attribute [Authorize]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IOrderService OrderService
@inject IMediaUploadService Media
@inject ISnackbar Snackbar

<PageTitle>Order #@Id - UPCSG</PageTitle>

<div class="upcsg-page">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_order is null)
    {
        <MudAlert Severity="Severity.Warning">Order not found, or it isn't yours.</MudAlert>
        <MudButton Class="upcsg-ghost-button px-6 mt-4" Variant="Variant.Outlined" Href="orders">Back to My Orders</MudButton>
    }
    else
    {
        <MudLink Href="orders" Class="mb-4 d-inline-block">&larr; My Orders</MudLink>

        <div class="upcsg-section-head">
            <div>
                <p class="upcsg-kicker">Placed @_order.PlacedAt.ToLocalTime().ToString("MMMM d, yyyy")</p>
                <h1 class="upcsg-title-xl">Order #@_order.Id</h1>
            </div>
            <span class="upcsg-chip">@OrderStatusDisplay.Label(_order.Status)</span>
        </div>

        <OrderStatusTrail Status="_order.Status" />

        @if (_order.Status == OrderStatusDto.Cancelled && !string.IsNullOrWhiteSpace(_order.CancellationReason))
        {
            <MudAlert Severity="Severity.Error" Class="my-4">
                Cancelled: @_order.CancellationReason
            </MudAlert>
        }

        @* A bounced receipt is the one state where the guilder must act again. *@
        @if (_order.Status == OrderStatusDto.AwaitingPayment && !string.IsNullOrWhiteSpace(_order.ReceiptRejectionReason))
        {
            <MudAlert Severity="Severity.Warning" Class="my-4">
                Your receipt was sent back: @_order.ReceiptRejectionReason
            </MudAlert>
        }

        @* Money owed back, said up front rather than buried in the table. *@
        @if (_order.HasRefundDue)
        {
            <MudAlert Severity="Severity.Warning" Class="my-4">
                <strong>&#8369;@_order.RefundDue.ToString("N2") is coming back to you.</strong>
                We couldn't fill part of this order. An officer will send it to the GCash number
                you paid from &mdash; message us if it hasn't arrived in a few days.
            </MudAlert>
        }
        else if (_order.RefundHasBeenSettled)
        {
            <MudAlert Severity="Severity.Success" Class="my-4">
                <strong>Refund sent.</strong>
                &#8369;@(((_order.AmountPaid ?? _order.Total) - _order.FulfilledTotal).ToString("N2"))
                was returned on @_order.RefundSettledAt!.Value.ToLocalTime().ToString("MMMM d"),
                reference @_order.RefundReference.
            </MudAlert>
        }

        <section class="upcsg-section upcsg-cartgrid">
            <MudPaper Square="true" Elevation="0" Class="upcsg-panel">
                <MudText Typo="Typo.overline" Class="upcsg-panel__title">Items</MudText>

                @* Matches the officers' copy of the same order, down to the markup. *@
                <MudTable Items="_order.Lines"
                          T="OrderLineDto"
                          Dense="true"
                          Hover="false"
                          Striped="false"
                          Bordered="false"
                          Elevation="0"
                          Class="upcsg-recordtable"
                          RowClassFunc="@((line, _) => line.Status == OrderLineStatusDto.ToFulfil ? string.Empty : "upcsg-line--short")"
                          CustomFooter="true">
                    <HeaderContent>
                        <MudTh>Item</MudTh>
                        <MudTh>Variant</MudTh>
                        <MudTh Class="upcsg-num">Unit</MudTh>
                        <MudTh Class="upcsg-num">Qty</MudTh>
                        <MudTh Class="upcsg-num">Total</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Item">
                            @context.ItemName

                            @* Told plainly, with the reason. Finding out at pickup that
                               something isn't coming is a worse way to learn it. *@
                            @if (context.Status == OrderLineStatusDto.RefundDue)
                            {
                                <span class="upcsg-datatable__flag">Being refunded</span>
                                <span class="upcsg-line__reason">@context.ShortfallReason</span>
                            }
                            else if (context.Status == OrderLineStatusDto.Refunded)
                            {
                                <span class="upcsg-line__refunded">Refunded</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Variant">@(string.IsNullOrWhiteSpace(context.Variant) ? "—" : context.Variant)</MudTd>
                        <MudTd DataLabel="Unit" Class="upcsg-num">&#8369;@context.UnitPrice.ToString("N2")</MudTd>
                        <MudTd DataLabel="Qty" Class="upcsg-num">@context.Quantity</MudTd>
                        <MudTd DataLabel="Total" Class="upcsg-num">&#8369;@context.LineTotal.ToString("N2")</MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTFootRow>
                            <MudTd colspan="4">@(_order.HasRefundDue || _order.RefundHasBeenSettled ? "You paid" : "Total")</MudTd>
                            <MudTd Class="upcsg-num">&#8369;@((_order.AmountPaid ?? _order.Total).ToString("N2"))</MudTd>
                        </MudTFootRow>

                        @if (_order.HasRefundDue || _order.RefundHasBeenSettled)
                        {
                            <MudTFootRow>
                                <MudTd colspan="4">You're getting</MudTd>
                                <MudTd Class="upcsg-num">&#8369;@_order.FulfilledTotal.ToString("N2")</MudTd>
                            </MudTFootRow>
                            <MudTFootRow Class="upcsg-line--short">
                                <MudTd colspan="4">@(_order.RefundHasBeenSettled ? "Refunded to you" : "Coming back to you")</MudTd>
                                <MudTd Class="upcsg-num">
                                    &#8369;@(((_order.AmountPaid ?? _order.Total) - _order.FulfilledTotal).ToString("N2"))
                                </MudTd>
                            </MudTFootRow>
                        }
                    </FooterContent>
                </MudTable>

                @if (!string.IsNullOrWhiteSpace(_order.Note))
                {
                    <MudText Typo="Typo.caption" Class="upcsg-panel__hint">Your note: @_order.Note</MudText>
                }
            </MudPaper>

            <aside class="upcsg-panel upcsg-checkout">
                @if (_order.Status == OrderStatusDto.AwaitingPayment)
                {
                    <h2 class="upcsg-checkout__title">Send your GCash receipt</h2>
                    <p class="upcsg-checkout__fineprint mb-4">
                        Pay &#8369;@_order.Total.ToString("0.00") to the guild's GCash number, then send
                        the screenshot. Officers only see your order once this is in.
                    </p>

                    @* The screenshot is uploaded, not linked. Asking a student to host an
                       image somewhere and paste a URL is asking them to get it wrong. *@
                    <div class="upcsg-receiptdrop">
                        @if (_screenshotUrl is not null)
                        {
                            <img class="upcsg-receiptdrop__preview" src="@_screenshotUrl" alt="Your GCash receipt" />

                            <div class="upcsg-receiptdrop__actions">
                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Refresh"
                                           Disabled="_uploading || _busy"
                                           OnClick="UploadScreenshotAsync">
                                    Replace
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Close"
                                           Disabled="_uploading || _busy"
                                           OnClick="@(() => _screenshotUrl = null)">
                                    Remove
                                </MudButton>
                            </div>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined"
                                       FullWidth="true"
                                       Class="upcsg-ghost-button"
                                       StartIcon="@Icons.Material.Filled.PhotoCamera"
                                       Disabled="_uploading || _busy"
                                       OnClick="UploadScreenshotAsync">
                                @(_uploading ? "Uploading…" : "Attach your GCash screenshot")
                            </MudButton>
                        }
                    </div>

                    @if (_uploading)
                    {
                        <MudProgressLinear Indeterminate="true" Class="mt-2" />
                    }

                    @if (_uploadError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_uploadError</MudAlert>
                    }

                    <p class="upcsg-checkout__fineprint mt-3 mb-4">
                        Only officers verifying your payment can see this. The screenshot already
                        shows the amount, the time and the reference, so it's all we need.
                    </p>

                    @* Optional: the screenshot carries the reference already. It's here
                       because typing it makes an officer's search of the GCash log quicker,
                       not because anyone should be retyping digits off their own screen. *@
                    <MudTextField @bind-Value="_reference"
                                  Label="Reference number (optional)"
                                  Variant="Variant.Outlined"
                                  Class="mb-4" />

                    <MudButton Variant="Variant.Filled"
                               Size="Size.Large"
                               FullWidth="true"
                               Class="upcsg-cta-button"
                               Disabled="_busy || _uploading || string.IsNullOrWhiteSpace(_screenshotUrl)"
                               OnClick="SubmitReceiptAsync">
                        Submit Receipt
                    </MudButton>
                }
                else if (_order.Receipt is not null)
                {
                    <h2 class="upcsg-checkout__title">Payment</h2>
                    @if (!string.IsNullOrWhiteSpace(_order.Receipt.ReferenceNumber))
                    {
                        <div class="upcsg-checkout__row">
                            <span>Reference</span>
                            <span>@_order.Receipt.ReferenceNumber</span>
                        </div>
                    }
                    <div class="upcsg-checkout__row">
                        <span>Submitted</span>
                        <span>@_order.Receipt.SubmittedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                    </div>
                    @* Show the proof itself rather than a link to it — it's their own
                       receipt, and one glance confirms the right image went in. *@
                    @if (!string.IsNullOrWhiteSpace(_order.Receipt.ScreenshotUrl))
                    {
                        <img class="upcsg-receiptdrop__preview mt-3"
                             src="@_order.Receipt.ScreenshotUrl"
                             alt="The GCash receipt you submitted"
                             onerror="upcsgReceiptBroken(this)" />
                    }
                }
                else
                {
                    <h2 class="upcsg-checkout__title">Payment</h2>
                    <p class="upcsg-checkout__fineprint">No receipt on file.</p>
                }
            </aside>
        </section>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>Mirrors MediaKeys.ReceiptsFolder on the API — the only folder a guilder may write to.</summary>
    private const string ReceiptsFolder = "receipts";

    private OrderDto? _order;
    private string _reference = string.Empty;
    private string? _screenshotUrl;
    private bool _loading = true;
    private bool _busy;
    private bool _uploading;
    private string? _uploadError;

    private async Task UploadScreenshotAsync()
    {
        _uploading = true;
        _uploadError = null;

        try
        {
            var result = await Media.PickAndUploadAsync(ReceiptsFolder);

            // Null means they closed the picker without choosing anything.
            if (result is null)
            {
                return;
            }

            if (result.Error is not null)
            {
                _uploadError = result.Error;
                return;
            }

            _screenshotUrl = result.Url;
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _order = await OrderService.GetAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitReceiptAsync()
    {
        _busy = true;

        try
        {
            _order = await OrderService.SubmitReceiptAsync(Id, _screenshotUrl!, _reference);
            Snackbar.Add("Receipt submitted. An officer will verify it shortly.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

}
