@page "/admin/officers"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@attribute [Authorize(Policy = "ExeCom")]
@inject IAdminContentService Content
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject AuthenticationStateProvider AuthState

<PageTitle>Officers - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">Officers</h1>
        </div>
    </div>

    <AdminNav />

    <p class="upcsg-lede mt-4">
        These addresses get officer rights when they sign in with Google. Everyone else signs
        in as an ordinary guilder. Roles are not set per account. This list is the only
        thing that decides them.
    </p>

    <section class="upcsg-section upcsg-band mt-4">
        <MudForm @ref="_form">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_email"
                                  Label="UP email address"
                                  Placeholder="officer@up.edu.ph"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  Immediate="true"
                                  Required="true"
                                  RequiredError="An email address is required."
                                  Validation="@(new Func<string, string?>(ValidateEmail))" />
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudTextField @bind-Value="_note"
                                  Label="Who is this? (optional)"
                                  Placeholder="Executive Director, A.Y. 2026-2027"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" md="2">
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Class="upcsg-cta-button"
                               Disabled="@(_busy || string.IsNullOrWhiteSpace(_email))"
                               OnClick="AddAsync">
                        Add officer
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>
    </section>

    <MudTable Items="_officers"
              T="OfficerEmailDto"
              Hover="true"
              Class="upcsg-datatable mt-4"
              Elevation="0"
              Dense="true"
              Loading="_loading"
              LoadingProgressColor="Color.Primary"
              Filter="new Func<OfficerEmailDto, bool>(Matches)"
              AllowUnsorted="false"
              RowClass="upcsg-datatable__row">
        <ToolBarContent>
            <MudTextField @bind-Value="_search"
                          Immediate="true"
                          DebounceInterval="150"
                          Placeholder="Search officers"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Variant="Variant.Text"
                          Clearable="true"
                          Class="upcsg-datatable__search mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel T="OfficerEmailDto" SortBy="@(o => o.Email)" InitialDirection="SortDirection.Ascending">Email</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="OfficerEmailDto" SortBy="@(o => o.Note ?? string.Empty)">Who</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="OfficerEmailDto" SortBy="@(o => o.AddedAt)">Added</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="OfficerEmailDto" SortBy="@(o => o.HasSignedIn)">Status</MudTableSortLabel></MudTh>
            <MudTh Style="width:6rem"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">
                @context.Email
                @if (IsMe(context.Email))
                {
                    <MudChip T="string" Size="Size.Small" Class="ml-2">you</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Who">@(context.Note ?? "Not noted")</MudTd>
            <MudTd DataLabel="Added">@context.AddedAt.ToLocalTime().ToString("MMM d, yyyy")</MudTd>
            <MudTd DataLabel="Status">
                @if (context.HasSignedIn)
                {
                    <span class="upcsg-statuspill upcsg-statuspill--received">Active</span>
                }
                else
                {
                    <span class="upcsg-statuspill upcsg-statuspill--confirmed">Not signed in yet</span>
                }
            </MudTd>
            <MudTd Style="text-align:right">
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Disabled="@(_busy || _officers.Count <= 1)"
                           OnClick="() => RemoveAsync(context)">
                    Remove
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <p class="upcsg-lede my-4">
                @(string.IsNullOrWhiteSpace(_search)
                    ? "No officers yet. That should be impossible, so add one now."
                    : $"No officer matches \"{_search}\".")
            </p>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="PageSizes" InfoFormat="{first_item}-{last_item} of {all_items} officers" />
        </PagerContent>
    </MudTable>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
        Removing someone takes effect immediately for new sign-ins, but a token they already
        hold stays valid until it expires. If you need to lock someone out right now, remove
        them here and ask them to sign out.
    </MudAlert>
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50];

    private MudForm? _form;
    private List<OfficerEmailDto> _officers = [];
    private string _email = string.Empty;
    private string? _note;
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _busy;
    private string? _myEmail;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _myEmail = state.User.FindFirst(c => c.Type.EndsWith("emailaddress") || c.Type == "email")?.Value;

        await LoadAsync();
    }

    private bool Matches(OfficerEmailDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();

        return item.Email.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (item.Note?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _officers = await Content.GetOfficersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsMe(string email) =>
        !string.IsNullOrWhiteSpace(_myEmail)
        && string.Equals(email, _myEmail, StringComparison.OrdinalIgnoreCase);

    private static string? ValidateEmail(string value) =>
        string.IsNullOrWhiteSpace(value) || System.Text.RegularExpressions.Regex.IsMatch(
            value.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$")
            ? null
            : "That doesn't look like an email address.";

    private async Task AddAsync()
    {
        _busy = true;

        try
        {
            await Content.AddOfficerAsync(new AddOfficerRequest { Email = _email, Note = _note });
            Snackbar.Add($"{_email.Trim().ToLowerInvariant()} can now administer the site.", Severity.Success);

            _email = string.Empty;
            _note = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(OfficerEmailDto officer)
    {
        var warning = IsMe(officer.Email)
            ? "This is your own address. You will lose access to these admin pages the next "
              + "time you sign in. Continue?"
            : $"{officer.Email} will lose officer rights immediately. Continue?";

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Remove officer",
            warning,
            yesText: "Remove",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _busy = true;

        try
        {
            await Content.RemoveOfficerAsync(officer.Id);
            Snackbar.Add($"{officer.Email} is no longer an officer.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
