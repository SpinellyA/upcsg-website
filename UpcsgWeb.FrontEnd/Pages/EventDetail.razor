@page "/events/{Id:guid}"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IEventService EventService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_event?.Title ?? "Event") - UPCSG</PageTitle>

@if (_loading)
{
    <div class="upcsg-page">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Class="upcsg-skeleton my-6" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="90%" />
    </div>
}
else if (_event is null)
{
    <div class="upcsg-page">
        <MudAlert Severity="Severity.Warning">
            We couldn't find that event. It may have been removed, or the link may be wrong.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6 mt-4" Href="events">
            Back to Events
        </MudButton>
    </div>
}
else
{
    @* The poster becomes the hero rather than sitting in a column beside the copy. Only
       one event in five has one, so the plate stands in — which means every event gets a
       hero instead of the majority opening on plain text. *@
    <section class="upcsg-eventhero">
        <CosmicImage Src="@_event.PosterUrl"
                     Alt="@($"Poster for {_event.Title}")"
                     Seed="@_event.Title"
                     Eager="true"
                     Class="upcsg-eventhero__art" />

        <div class="upcsg-eventhero__scrim"></div>

        <div class="upcsg-eventhero__inner">
            <p class="upcsg-eyebrow">
                <span class="upcsg-star"></span>
                @Starts.ToString("dddd, MMMM d, yyyy")
            </p>
            <h1 class="upcsg-eventhero__title">@_event.Title</h1>

            <div class="upcsg-eventhero__meta">
                <span class="upcsg-statuspill upcsg-statuspill--@EventTiming.StatusSlug(_event)">
                    @EventTiming.StatusLabel(_event)
                </span>
                <span class="upcsg-eventhero__where">
                    <MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" />
                    @_event.Location
                </span>
            </div>
        </div>
    </section>

    <div class="upcsg-page upcsg-page--after-hero">
        <MudLink Href="events" Class="mb-4 d-inline-block">&larr; All events this month</MudLink>

        @* The facts run across the top rather than down a rail beside the copy. A tall
           column of prose next to a short column of labels never balances, and the
           mismatch only gets worse the more an officer writes. *@
        <Reveal Variant="Reveal.RevealMotion.Up">
            <MudPaper Elevation="0" Class="upcsg-surface upcsg-glance mb-6">
                <MudGrid Spacing="3">
                    <MudItem xs="6" md="3">
                        <p class="upcsg-glance__label">When</p>
                        <p class="upcsg-glance__value">@Starts.ToString("ddd, MMM d")</p>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <p class="upcsg-glance__label">Time</p>
                        <p class="upcsg-glance__value">@EventTiming.TimeRange(_event)</p>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <p class="upcsg-glance__label">Runs for</p>
                        <p class="upcsg-glance__value">@EventTiming.DurationLabel(_event)</p>
                    </MudItem>

                    <MudItem xs="6" md="3">
                        <p class="upcsg-glance__label">Where</p>
                        <p class="upcsg-glance__value">@_event.Location</p>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap"
                          AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    @* Takes its colour from the status rather than always being gold, so a
                       finished event stops shouting the same way an upcoming one does. *@
                    <span class="upcsg-glance__countdown upcsg-glance__countdown--@EventTiming.StatusSlug(_event)">
                        @EventTiming.Countdown(_event)
                    </span>

                    @* Share is the only action left, so it carries the filled treatment while
                       the event is still ahead and steps back once it's over. *@
                    <MudButton Variant="@(EventTiming.HasEnded(_event) ? Variant.Outlined : Variant.Filled)"
                               Class="@(EventTiming.HasEnded(_event) ? "upcsg-ghost-button px-6" : "upcsg-cta-button px-6")"
                               StartIcon="@Icons.Material.Outlined.Share"
                               OnClick="ShareAsync">
                        Share
                    </MudButton>
                </MudStack>

                @if (EventTiming.IsOnline(_event))
                {
                    <p class="upcsg-glance__note">
                        <MudIcon Icon="@Icons.Material.Outlined.Videocam" Size="Size.Small" />
                        Runs online. The joining link goes out in the guild channels closer to the day.
                    </p>
                }
            </MudPaper>
        </Reveal>

        @* Full measure now that the poster leads the page, so the copy is no longer
           squeezed into a column beside an image it already appeared above. *@
        <Reveal Variant="Reveal.RevealMotion.Up" Delay="80">
            <article class="upcsg-eventbody upcsg-eventbody--wide">
                <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> About this event</p>

                @foreach (var paragraph in Paragraphs)
                {
                    <p class="upcsg-eventbody__para">@paragraph</p>
                }
            </article>
        </Reveal>

        @if (_others.Count > 0)
        {
            <section class="upcsg-section">
                <SectionHeading Kicker="Also on this month" Title="More events">
                    <Action>
                        <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="events">
                            View calendar
                        </MudButton>
                    </Action>
                </SectionHeading>

                @* Quiet keeps the flat ink treatment: this is an index at the foot of the
                   page, and glowing cards after the article competed with it. *@
                <div class="upcsg-eventlist">
                    @foreach (var (other, i) in _others.Select((o, i) => (o, i)))
                    {
                        <Reveal Variant="Reveal.RevealMotion.Fade" Delay="@(i * 60)">
                            <EventCard Event="other" Variant="EventCard.Density.Row" Quiet="true" />
                        </Reveal>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private EventDto? _event;
    private List<EventDto> _others = [];
    private bool _loading = true;

    private DateTime Starts => _event is null ? default : EventTiming.Starts(_event);

    /// <summary>Blank-line-separated paragraphs, so long copy doesn't render as one wall.</summary>
    private IEnumerable<string> Paragraphs =>
        (_event?.Description ?? string.Empty)
            .Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(p => p.Replace('\n', ' '));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _event = null;
        _others = [];

        try
        {
            _event = await EventService.GetEventAsync(Id);

            if (_event is not null)
            {
                var month = await EventService.GetThisMonthEventsAsync();
                _others = month
                    .Where(e => e.Id != Id)
                    .OrderBy(e => e.StartDateTime)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ShareAsync()
    {
        // The phone's own share sheet is how this actually reaches a groupchat;
        // copying the link is the desktop fallback.
        var result = await JS.InvokeAsync<string>("upcsgShare", _event?.Title ?? "UPCSG event", Navigation.Uri);

        switch (result)
        {
            case "shared":
                break;
            case "copied":
                Snackbar.Add("Link copied.", Severity.Success);
                break;
            case "cancelled":
                break;
            default:
                Snackbar.Add("Couldn't share. You can copy the link from the address bar.", Severity.Warning);
                break;
        }
    }
}
