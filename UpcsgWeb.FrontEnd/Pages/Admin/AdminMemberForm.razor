@page "/admin/members/new"
@page "/admin/members/{Id:guid}"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IMemberService Members
@inject IAdminContentService Admin
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "New person" : _item.Name) - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <MudLink Href="admin/members" Class="mb-3 d-inline-block">&larr; All people</MudLink>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">That person is no longer listed.</MudAlert>
    }
    else
    {
        <div class="upcsg-section-head">
            <div>
                <p class="upcsg-kicker">Guild CMS</p>
                <h1 class="upcsg-title-xl">@(IsNew ? "New person" : _item.Name)</h1>
            </div>
        </div>

        <AdminNav />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Square="true" Elevation="0" Class="mt-4">@_error</MudAlert>
        }

        <div class="upcsg-merchform mt-4">
            <MudPaper Square="true" Elevation="0" Class="upcsg-panel">
                <MudText Typo="Typo.overline" Class="upcsg-panel__title">Portrait</MudText>

                <SinglePhotoField Url="@_item.PhotoUrl"
                                  UrlChanged="OnPhotoChanged"
                                  Folder="members"
                                  Alt="@($"Portrait of {_item.Name}")"
                                  EmptyLabel="Upload portrait" />

                <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
                    Shoot portraits at a 3:4 crop so the About page grid stays even. Without
                    one, the card falls back to their initials.
                </MudText>
            </MudPaper>

            <MudPaper Square="true" Elevation="0" Class="upcsg-panel">
                <MudText Typo="Typo.overline" Class="upcsg-panel__title">Person</MudText>

                <MudTextField @bind-Value="_item.Name" Immediate="true"
                              Label="Full name" Variant="Variant.Outlined" Required="true"
                              TextChanged="_ => Touch()" Class="mb-4" />

                <MudTextField @bind-Value="_item.Role" Immediate="true"
                              Label="Position" Variant="Variant.Outlined" Required="true"
                              HelperText="e.g. Executive Director, Secretary, Faculty Adviser"
                              TextChanged="_ => Touch()" Class="mb-4" />

                <MudSelect T="MemberCategory" Value="_item.Category" ValueChanged="OnCategoryChanged"
                           Label="Category" Variant="Variant.Outlined" Class="mb-4">
                    <MudSelectItem T="MemberCategory" Value="MemberCategory.ExeCom">Executive Committee</MudSelectItem>
                    <MudSelectItem T="MemberCategory" Value="MemberCategory.Faculty">Faculty</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_item.Committee" Immediate="true"
                              Label="Committee" Variant="Variant.Outlined"
                              HelperText="Groups them on the About page — e.g. Executive Board, Directorates"
                              TextChanged="_ => Touch()" Class="mb-4" />

                <MudNumericField T="int" Value="_item.DisplayOrder" ValueChanged="OnOrderChanged"
                                 Label="Display order" Variant="Variant.Outlined" Min="0"
                                 HelperText="Lowest first, within their category."
                                 Class="mb-4" />
            </MudPaper>
        </div>

        <MudPaper Square="true" Elevation="0" Class="upcsg-panel mt-4">
            <MudText Typo="Typo.overline" Class="upcsg-panel__title">In their words</MudText>

            <MudTextField @bind-Value="_item.Quote" Immediate="true"
                          Label="Personal quote" Variant="Variant.Outlined"
                          HelperText="One line, in their own words. Leave blank rather than inventing one."
                          TextChanged="_ => Touch()" Class="mb-4" />

            <MudTextField @bind-Value="_item.Bio" Immediate="true"
                          Label="What they do" Variant="Variant.Outlined" Lines="5"
                          HelperText="The paragraph beside their photo on the About page. Two or three sentences."
                          TextChanged="_ => Touch()" Class="mb-4" />

            <MudTextField @bind-Value="_item.Profile" Immediate="true"
                          Label="Full profile" Variant="Variant.Outlined" Lines="10"
                          HelperText="Only shown behind Know more, so there is room here. Leave a blank line between paragraphs."
                          TextChanged="_ => Touch()" />
        </MudPaper>

        <MudPaper Square="true" Elevation="0" Class="upcsg-panel mt-4">
            <MudText Typo="Typo.overline" Class="upcsg-panel__title">Achievements</MudText>

            <MudText Typo="Typo.caption" Class="upcsg-panel__hint mb-3">
                What they have won or been recognised for. Shown as a list behind Know more,
                newest year first. The year is optional.
            </MudText>

            @foreach (var (achievement, index) in _item.Achievements.Select((a, i) => (a, i)))
            {
                var row = index;

                <div class="upcsg-repeater__row" @key="row">
                    <MudTextField @bind-Value="achievement.Title" Immediate="true"
                                  Label="Achievement" Variant="Variant.Outlined"
                                  Placeholder="Champion, PSITE Regional Quizbowl"
                                  TextChanged="_ => Touch()" />

                    <MudNumericField T="int?" @bind-Value="achievement.Year" @bind-Value:after="Touch"
                                     Label="Year" Variant="Variant.Outlined"
                                     Min="1900" Max="@(DateTime.Today.Year + 1)"
                                     Class="upcsg-repeater__year" />

                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                   Color="Color.Error"
                                   aria-label="Remove this achievement"
                                   OnClick="() => RemoveAchievement(row)" />
                </div>
            }

            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-5 mt-2"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddAchievement">
                Add achievement
            </MudButton>
        </MudPaper>

        <MudPaper Square="true" Elevation="0" Class="upcsg-panel mt-4">
            <MudText Typo="Typo.overline" Class="upcsg-panel__title">Where to reach them</MudText>

            <MudText Typo="Typo.caption" Class="upcsg-panel__hint mb-3">
                Only what they are happy to have on a public page. One entry per kind.
                Links need the full https address; email is just the address.
            </MudText>

            @foreach (var (link, index) in _item.Links.Select((l, i) => (l, i)))
            {
                var row = index;

                <div class="upcsg-repeater__row" @key="row">
                    <MudSelect T="MemberLinkKindDto" @bind-Value="link.Kind" @bind-Value:after="Touch"
                               Label="Kind" Variant="Variant.Outlined"
                               Class="upcsg-repeater__kind">
                        @foreach (var kind in Enum.GetValues<MemberLinkKindDto>())
                        {
                            <MudSelectItem T="MemberLinkKindDto" Value="@kind">@kind</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="link.Value" Immediate="true"
                                  Label="@(link.Kind == MemberLinkKindDto.Email ? "Email address" : "Link")"
                                  Variant="Variant.Outlined"
                                  Placeholder="@(link.Kind == MemberLinkKindDto.Email ? "name@up.edu.ph" : "https://")"
                                  TextChanged="_ => Touch()" />

                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                   Color="Color.Error"
                                   aria-label="Remove this contact"
                                   OnClick="() => RemoveLink(row)" />
                </div>
            }

            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-5 mt-2"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddLink">
                Add contact
            </MudButton>
        </MudPaper>

        <div class="upcsg-formbar">
            @if (!IsNew)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" Class="mr-auto"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           Disabled="_saving" OnClick="DeleteAsync">
                    Remove person
                </MudButton>
            }

            @if (_dirty)
            {
                <span class="upcsg-savebar__dirty">Unsaved changes</span>
            }

            <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Leave">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                       Disabled="_saving || !CanSave"
                       OnClick="SaveAsync">
                @(_saving ? "Saving…" : "Save person")
            </MudButton>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private MemberDto _item = new();
    private bool _loading = true;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;
    private string? _error;

    private bool _populating;

    private bool IsNew => Id is null;

    private bool CanSave =>
        !string.IsNullOrWhiteSpace(_item.Name) && !string.IsNullOrWhiteSpace(_item.Role);

    protected override void OnAfterRender(bool firstRender) => _populating = false;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;
        _dirty = false;

        try
        {
            if (Id is { } id)
            {
                var found = await Members.GetMemberAsync(id);

                if (found is null)
                {
                    _notFound = true;
                }
                else
                {
                    _populating = true;
                    _item = found;
                }
            }
            else
            {
                var next = await NextOrderAsync();

                _populating = true;

                _item = new MemberDto { Category = MemberCategory.ExeCom, DisplayOrder = next };
            }
        }
        catch (Exception ex)
        {
            // The inline alert sits at the top of the form, which is not where you are
            // when you press Save at the bottom. The snackbar is what tells you; the
            // alert stays so the message is still readable once it fades.
            _error = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<int> NextOrderAsync()
    {
        try
        {
            var all = await Members.GetMembersAsync();
            return all.Count == 0 ? 1 : all.Max(m => m.DisplayOrder) + 1;
        }
        catch
        {
            return 1;
        }
    }

    private void Touch()
    {
        if (!_populating)
        {
            _dirty = true;
        }
    }

    private void OnCategoryChanged(MemberCategory value)
    {
        _item.Category = value;
        Touch();
    }

    private void OnOrderChanged(int value)
    {
        _item.DisplayOrder = value;
        Touch();
    }

    private void OnPhotoChanged(string? url)
    {
        _item.PhotoUrl = url;
        Touch();
    }

    private void AddAchievement()
    {
        _item.Achievements.Add(new MemberAchievementDto());
        Touch();
    }

    private void RemoveAchievement(int index)
    {
        _item.Achievements.RemoveAt(index);
        Touch();
    }

    // Defaults to the first kind not already used, so adding a second contact does not
    // land on Email again and trip the one-per-kind rule.
    private void AddLink()
    {
        var used = _item.Links.Select(l => l.Kind).ToHashSet();

        var next = Enum.GetValues<MemberLinkKindDto>()
            .FirstOrDefault(k => !used.Contains(k), MemberLinkKindDto.Website);

        _item.Links.Add(new MemberLinkDto { Kind = next });
        Touch();
    }

    private void RemoveLink(int index)
    {
        _item.Links.RemoveAt(index);
        Touch();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var saved = await Admin.SaveMemberAsync(_item);
            Snackbar.Add("Saved.", Severity.Success);

            if (IsNew)
            {
                Navigation.NavigateTo($"admin/members/{saved.Id}", replace: true);
                return;
            }

            _populating = true;
            _item = saved;
            _dirty = false;
        }
        catch (Exception ex)
        {
            // The inline alert sits at the top of the form, which is not where you are
            // when you press Save at the bottom. The snackbar is what tells you; the
            // alert stays so the message is still readable once it fades.
            _error = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Remove person",
            $"Remove {_item.Name} from the site? Their photo stays in storage, so this can be undone by adding them again.",
            yesText: "Remove", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _saving = true;

        try
        {
            await Admin.DeleteMemberAsync(_item.Id);
            Snackbar.Add("Removed.", Severity.Success);

            _dirty = false;
            Navigation.NavigateTo("admin/members");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saving = false;
        }
    }

    private async Task Leave()
    {
        if (_dirty)
        {
            var ok = await Dialogs.ShowMessageBoxAsync(
                "Discard changes?",
                "This person has edits that haven't been saved.",
                yesText: "Discard", cancelText: "Keep editing");

            if (ok != true)
            {
                return;
            }
        }

        Navigation.NavigateTo("admin/members");
    }
}
