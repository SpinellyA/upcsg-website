@page "/admin/settings"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAdminContentService Admin
@inject IEventService Events
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Settings - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">Settings</h1>
        </div>
    </div>

    <AdminNav />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        @* ---------- Calendar month ---------- *@
        @* Same shape as the snapshot section below: section head with kicker and title, no
           inline sizing. The heading used to override upcsg-title-xl with a hard-coded
           font-size and the section carried an inline max-width, so the two blocks on this
           one page disagreed about how a settings panel looks. *@
        <section class="upcsg-section upcsg-band mt-4">
            <div class="upcsg-section-head">
                <div>
                    <p class="upcsg-kicker">Events page</p>
                    <h2 class="upcsg-title-xl">Calendar month</h2>
                </div>
            </div>

            <p class="upcsg-lede">
                The public events page shows one month at a time. Normally that's the real
                current month, but you can pin it ahead to publish next month's lineup early.
            </p>

            <MudSwitch T="bool" @bind-Value="_followCurrent" Color="Color.Success"
                       Label="Follow the current month automatically" Class="my-4" />

            @if (!_followCurrent)
            {
                @* MudGrid rather than upcsg-monthnav: that class is the events page's
                   chevron navigator — a 0.5rem flex row sized for two icon buttons around a
                   label — and it packed these two full-width fields against each other. *@
                <MudGrid Spacing="2" Class="align-center mb-4">
                    <MudItem xs="12" sm="7">
                        <MudSelect T="int" @bind-Value="_month" Label="Month" Variant="Variant.Outlined" Dense="true">
                            @for (var m = 1; m <= 12; m++)
                            {
                                var value = m;
                                <MudSelectItem T="int" Value="@value">@(new DateTime(2000, value, 1).ToString("MMMM"))</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudNumericField T="int" @bind-Value="_year" Label="Year" Variant="Variant.Outlined"
                                         Min="2020" Max="@(DateTime.Now.Year + 5)" />
                    </MudItem>
                </MudGrid>
            }

            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                Visitors currently see <strong>@ResolvedLabel</strong>.
            </MudAlert>

            <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-8"
                       Disabled="_busy" OnClick="SaveAsync">
                Save
            </MudButton>
        </section>

        @* ---------- Offline snapshot ---------- *@
        <section class="upcsg-section">
            <div class="upcsg-section-head">
                <div>
                    <p class="upcsg-kicker">Offline fallback</p>
                    <h2 class="upcsg-title-xl">Content snapshot</h2>
                </div>
            </div>

            <p class="upcsg-lede">
                Saves every public record &mdash; officers, events, the Hall of Fame, merch and
                the published month &mdash; into one file. Commit it to the site repository as
                <code>wwwroot/content-snapshot.json</code> and the public pages keep working
                when the API is asleep or down. Orders and accounts are never included.
            </p>

            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-8"
                       StartIcon="@Icons.Material.Outlined.Download"
                       Disabled="_snapshotting" OnClick="DownloadSnapshotAsync">
                @(_snapshotting ? "Preparing…" : "Download snapshot")
            </MudButton>

            @if (_snapshotSummary is not null)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-4">
                    @_snapshotSummary
                </MudAlert>
            }

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                The GitHub Action in <code>.github/workflows/snapshot.yml</code> does this on a
                schedule and commits the result, including a copy of every image. Downloading
                here is the manual route for when you want it captured right now.
            </MudAlert>
        </section>
    }
</div>

@code {
    private bool _snapshotting;
    private string? _snapshotSummary;

    private async Task DownloadSnapshotAsync()
    {
        _snapshotting = true;
        _snapshotSummary = null;

        try
        {
            // Raw JSON, written to the file exactly as the API produced it — round-tripping
            // through objects here could quietly change what gets committed.
            var json = await Admin.GetSnapshotJsonAsync();

            await using var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/download.js");

            await module.InvokeVoidAsync(
                "saveText", "content-snapshot.json", json, "application/json");

            var counts = System.Text.Json.JsonDocument.Parse(json).RootElement;
            _snapshotSummary =
                $"Saved {Count(counts, "members")} officers, {Count(counts, "events")} events, "
                + $"{Count(counts, "achievements")} achievements and {Count(counts, "merch")} merch items "
                + $"({json.Length / 1024} KB). Commit it to wwwroot/content-snapshot.json.";
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _snapshotting = false;
        }
    }

    private static int Count(System.Text.Json.JsonElement root, string property) =>
        root.TryGetProperty(property, out var array) ? array.GetArrayLength() : 0;

    private SiteSettingsDto _settings = new();
    private bool _followCurrent = true;
    private int _year = DateTime.Now.Year;
    private int _month = DateTime.Now.Month;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private string ResolvedLabel =>
        new DateTime(_settings.ResolvedYear == 0 ? DateTime.Now.Year : _settings.ResolvedYear,
                     _settings.ResolvedMonth == 0 ? DateTime.Now.Month : _settings.ResolvedMonth, 1)
            .ToString("MMMM yyyy");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _settings = await Admin.GetSettingsAsync();
            _followCurrent = _settings.FollowsCurrentMonth;
            _year = _settings.EventsYear ?? DateTime.Now.Year;
            _month = _settings.EventsMonth ?? DateTime.Now.Month;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;

        try
        {
            _settings = await Admin.SaveSettingsAsync(new UpdateSiteSettingsRequest
            {
                FollowCurrentMonth = _followCurrent,
                EventsYear = _followCurrent ? null : _year,
                EventsMonth = _followCurrent ? null : _month,
            });

            // The month is cached for the life of the tab, so without this the officer
            // saves July and the site keeps showing August until a hard reload.
            Events.ForgetDisplayMonth();

            Snackbar.Add(
                $"Saved. The events page now shows {ResolvedLabel}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
