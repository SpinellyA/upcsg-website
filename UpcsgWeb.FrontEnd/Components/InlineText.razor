@using UpcsgWeb.FrontEnd.Services
@inject IJSRuntime JS

@* Click-to-edit text that stays in the page.

   This is a real <input>/<textarea>, NOT contenteditable. That matters for two reasons:
   the value stays plain text (contenteditable emits HTML, which on a public site means a
   sanitiser and an XSS surface), and Blazor keeps ownership of the DOM instead of fighting
   the browser over nodes it mutated.

   The control inherits font, size, colour and line-height from whatever it sits inside, and
   its padding is cancelled by an equal negative margin, so switching between reading and
   editing shifts nothing on the page. *@

@if (!Active)
{
    @if (string.IsNullOrWhiteSpace(Value))
    {
        <span class="upcsg-inline__empty">@Placeholder</span>
    }
    else
    {
        @Value
    }
}
else if (Multiline)
{
    <textarea @ref="_element"
              class="upcsg-inline upcsg-inline--multiline"
              rows="1"
              aria-label="@Placeholder"
              value="@Value"
              @oninput="OnInputAsync"
              @onkeydown="OnKeyDown"></textarea>
}
else
{
    <input @ref="_element"
           type="text"
           class="upcsg-inline"
           aria-label="@Placeholder"
           value="@Value"
           @oninput="OnInputAsync"
           @onkeydown="OnKeyDown" />
}

@code {
    [Parameter, EditorRequired] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>True while this item is the one selected for editing.</summary>
    [Parameter] public bool Active { get; set; }

    [Parameter] public bool Multiline { get; set; }

    /// <summary>Shown greyed when empty, and used as the control's accessible name.</summary>
    [Parameter] public string Placeholder { get; set; } = "Empty";

    /// <summary>Raised on Escape so the page can put the original text back.</summary>
    [Parameter] public EventCallback OnRevert { get; set; }

    private ElementReference _element;
    private bool _wasActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Size the box to its content the moment it appears, otherwise a four-paragraph
        // story opens as a one-row slot and the officer has to scroll inside it.
        if (Active && !_wasActive && Multiline)
        {
            await JS.InvokeVoidAsync("upcsgAutosize", _element);
        }

        _wasActive = Active;
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        await ValueChanged.InvokeAsync(text);

        if (Multiline)
        {
            await JS.InvokeVoidAsync("upcsgAutosize", _element);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnRevert.InvokeAsync();
        }
    }
}
