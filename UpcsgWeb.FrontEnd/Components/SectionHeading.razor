<div class="upcsg-sechead @Class">
    <div class="upcsg-sechead__text">
        <Reveal Variant="Reveal.RevealMotion.Up">
            <h2 class="upcsg-title-xl" id="@Id">@Title</h2>
        </Reveal>

        @if (!string.IsNullOrWhiteSpace(Lede))
        {
            <Reveal Variant="Reveal.RevealMotion.Up" Delay="80">
                <p class="upcsg-lede upcsg-sechead__lede">@Lede</p>
            </Reveal>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Kicker) || Action is not null)
    {
        <Reveal Variant="Reveal.RevealMotion.Fade" Delay="140" Class="upcsg-sechead__action">
            @if (!string.IsNullOrWhiteSpace(Kicker))
            {
                <span class="upcsg-sechead__note">@Kicker</span>
            }
            @Action
        </Reveal>
    }
</div>

@code {
    [Parameter] public string? Kicker { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Lede { get; set; }

    [Parameter] public RenderFragment? Action { get; set; }

    [Parameter] public bool Centered { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public string? Id { get; set; }
}
