@page "/admin/merch"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAdminContentService Admin
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Merch - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">Merch</h1>
        </div>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   StartIcon="@Icons.Material.Filled.Add" Href="admin/merch/new">
            New Item
        </MudButton>
    </div>

    <AdminNav />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudTable Items="_items"
                  T="MerchItemDto"
                  Hover="true"
                  Class="upcsg-datatable mt-4"
                  Elevation="0"
                  Dense="true"
                  Loading="_loading"
                  LoadingProgressColor="Color.Primary"
                  Filter="new Func<MerchItemDto, bool>(Matches)"
                  AllowUnsorted="false"
                  OnRowClick="@(args => OpenItem(args.Item))"
                  RowClass="upcsg-datatable__row">
            <ToolBarContent>
                <MudTextField @bind-Value="_search"
                              Immediate="true"
                              DebounceInterval="150"
                              Placeholder="Search items or variants"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Text"
                              Clearable="true"
                              Class="upcsg-datatable__search mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel T="MerchItemDto" SortBy="@(i => i.Name)" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel></MudTh>
                <MudTh Class="upcsg-num"><MudTableSortLabel T="MerchItemDto" SortBy="@(i => i.PriceFrom)">Price</MudTableSortLabel></MudTh>
                <MudTh>Variants</MudTh>
                <MudTh Class="upcsg-num"><MudTableSortLabel T="MerchItemDto" SortBy="@(i => TotalStock(i))">Stock</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="MerchItemDto" SortBy="@(i => i.InStock)">Status</MudTableSortLabel></MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Price" Class="upcsg-num">&#8369;@context.PriceFrom.ToString("N2")@(context.HasPriceRange ? "+" : "")</MudTd>
                <MudTd DataLabel="Variants">@(context.Variants.Count == 0 ? "-" : string.Join(", ", context.Variants.Select(v => v.Name)))</MudTd>

                <MudTd DataLabel="Stock" Class="upcsg-num">
                    @(context.IsPreorder ? "Preorder" : TotalStock(context).ToString())
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(context.InStock ? Color.Success : Color.Default)">
                        @(context.InStock ? "In stock" : "Sold out")
                    </MudChip>
                </MudTd>
                <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <p class="upcsg-lede my-4">
                    @(string.IsNullOrWhiteSpace(_search) ? "No merch yet." : $"Nothing matches \"{_search}\".")
                </p>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="PageSizes" InfoFormat="{first_item}-{last_item} of {all_items} items" />
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50, 100];

    private List<MerchItemDto> _items = [];
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private static int TotalStock(MerchItemDto item) =>
        item.Variants.Count == 0 ? item.Stock : item.Variants.Sum(v => v.Stock);

    private bool Matches(MerchItemDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();

        return item.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || item.Variants.Any(v => v.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = await Admin.GetMerchAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenItem(MerchItemDto? item)
    {
        if (item is not null)
        {
            Navigation.NavigateTo($"admin/merch/{item.Id}");
        }
    }
}
