@page "/"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IEventService EventService
@inject IMerchService MerchService
@inject IMemberService MemberService
@inject IAchievementService AchievementService
@inject IOpportunityService OpportunityFeed
@inject IGuildPhotoService GuildPhotos
@inject MotionInterop Motion

<PageTitle>UPCSG · UP Computer Science Guild</PageTitle>

<section class="upcsg-hero upcsg-field--ultra" data-field="ultra" @ref="_hero">
    <span class="upcsg-hero__flare" aria-hidden="true"></span>
    <span class="upcsg-hero__star upcsg-hero__star--a" aria-hidden="true"></span>
    <span class="upcsg-hero__star upcsg-hero__star--b" aria-hidden="true"></span>
    <span class="upcsg-hero__star upcsg-hero__star--c" aria-hidden="true"></span>

    <div class="upcsg-hero__banner">
        <img class="upcsg-hero__crest" src="img/upcsg-crest.png" alt="" width="120" height="146" />
        <p class="upcsg-hero__uni">University of the Philippines Cebu</p>
        <h1 class="upcsg-hero__title">Computer Science Guild</h1>
        <p class="upcsg-hero__year">a.y. 2026&ndash;2027</p>

        <p class="upcsg-hero__lede">
            The student organization every Computer Science major at UP Cebu belongs to.
        </p>
        <div class="upcsg-hero__actions">
            <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="events">
                See what's on this month
            </MudButton>
            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button" Href="about">
                Meet the guild
            </MudButton>
        </div>
    </div>

    <div class="upcsg-hero__sky">
        <div class="upcsg-chapter__inner">
            <div class="upcsg-sechead">
                <div class="upcsg-sechead__text">
                    <h2 class="upcsg-title-xl">The next 60 days</h2>
                </div>
                <div class="upcsg-sechead__action">
                    <span class="upcsg-sechead__note">Pick a star to open it</span>
                </div>
            </div>
            <SkyChart Points="_sky" />
        </div>
    </div>
</section>

<Chapter Field="night" Id="explore">
    <SectionHeading Title="@($"On in {_month:MMMM}")"
                    Kicker="@(_loading ? null : MonthNote)">
        <Action>
            <a class="upcsg-textlink" href="events">The full calendar <span aria-hidden="true">&rarr;</span></a>
        </Action>
    </SectionHeading>

    @if (_loading)
    {
        <div class="upcsg-menu">
            @for (var i = 0; i < 4; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" Class="upcsg-skeleton" />
            }
        </div>
    }
    else
    {
        <div class="upcsg-menu-group">
            <div class="upcsg-menu-group__head">
                <h3>Events</h3>
                <span>@Count(_events.Count, "event")</span>
            </div>

            @if (_events.Count == 0)
            {
                <p class="upcsg-menu-group__none">
                    @_month.ToString("MMMM")'s lineup hasn't been posted yet. It goes up on our
                    socials first and lands here once it's official.
                </p>
            }
            else
            {
                <div class="upcsg-menu">
                    @foreach (var (evt, i) in _events.Select((e, i) => (e, i)))
                    {
                        <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 70)">
                            <EventRow Event="evt" />
                        </Reveal>
                    }
                </div>
            }
        </div>

        <div class="upcsg-menu-group">
            <div class="upcsg-menu-group__head">
                <h3>Competitions and calls</h3>
                <span>@Count(_opportunities.Count, "open", "open")</span>
            </div>

            @if (_opportunities.Count == 0)
            {
                <p class="upcsg-menu-group__none">
                    Nothing open right now. Hackathons, quizbowls and scholarship calls go up here
                    as the ExeCom hears about them.
                </p>
            }
            else
            {
                <div class="upcsg-menu">
                    @foreach (var (item, i) in _opportunities.Take(6).Select((o, i) => (o, i)))
                    {
                        <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 70)">
                            <OpportunityRow Opportunity="item" />
                        </Reveal>
                    }
                </div>
            }
        </div>
    }
</Chapter>

<Chapter Field="gold" Tall="true" Class="upcsg-prints">
    <div class="upcsg-prints__stage">
        <h2 class="upcsg-prints__title">
            <span>Run by</span>
            <span>students</span>
        </h2>

        <div class="upcsg-prints__pile">
            @foreach (var (photo, i) in _photos.Take(3).Select((p, i) => (p, i)))
            {
                <figure class="upcsg-prints__print upcsg-prints__print--@i">
                    <img src="@photo.File" alt="@(string.IsNullOrWhiteSpace(photo.Caption) ? "Guilders at a UPCSG event" : photo.Caption)"
                         width="900" height="1200" loading="lazy" />
                </figure>
            }
        </div>
    </div>

    <div class="upcsg-prints__foot">
        <p>
            Every program here is organised by guilders carrying the same problem sets and
            deadlines as the people they organise it for. There is no staff behind us.
        </p>
        <a class="upcsg-textlink" href="about">About the guild <span aria-hidden="true">&rarr;</span></a>
    </div>
</Chapter>

<Chapter Field="paper">
    <SectionHeading Title="The ExeCom"
                    Kicker="@(_execs.Count > 0 ? $"{_execs.Count} officers, A.Y. 2026–2027" : null)">
        <Action>
            <a class="upcsg-textlink" href="about">Every profile <span aria-hidden="true">&rarr;</span></a>
        </Action>
    </SectionHeading>

    @if (_execs.Count == 0 && !_loading)
    {
        <div class="upcsg-empty">
            <p>This year's officers haven't been published yet.</p>
        </div>
    }
    else
    {
        <div class="upcsg-team">
            @foreach (var (member, i) in _execs.Select((m, i) => (m, i)))
            {
                <Reveal Variant="Reveal.RevealMotion.Up" Delay="@((i % 6) * 60)">
                    <MemberCard Member="member" Roster="_execs" Tint="i" />
                </Reveal>
            }
        </div>
    }
</Chapter>

@foreach (var (item, i) in _merch.Take(3).Select((m, i) => (m, i)))
{
    <MerchChapter Item="item" Field="@MerchFields[i % MerchFields.Length]" />
}

@if (_achievements.Count > 0)
{
    <Chapter Field="peri">
        <div class="upcsg-board">
            <div class="upcsg-board__head">
                <h2>Wins on the record</h2>
                <a class="upcsg-textlink" href="hall-of-fame">The Hall of Fame <span aria-hidden="true">&rarr;</span></a>
            </div>

            @foreach (var (win, i) in _achievements.OrderByDescending(a => a.Year).ThenByDescending(a => a.CreatedAt).Take(7).Select((a, i) => (a, i)))
            {
                <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 60)" Class="upcsg-board__cell">
                    <a class="upcsg-board__tile" href="@($"hall-of-fame/{win.Id}")">
                        <span class="upcsg-board__name">@win.Title</span>
                        <span class="upcsg-board__meta">@win.Year@(string.IsNullOrWhiteSpace(win.Category) ? null : $" · {win.Category}")</span>
                    </a>
                </Reveal>
            }
        </div>
    </Chapter>
}

<Chapter Field="night" Class="upcsg-close">
    <h2 class="upcsg-close__title">
        <span>Already in.</span>
        <span>Go further.</span>
    </h2>
    <div class="upcsg-close__foot">
        <p>
            Every CS student at UP Cebu is a guilder from day one: nothing to sign, nothing to
            pay. How far in you go is up to you: a committee, a competition, or the next thing
            on the calendar.
        </p>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="contact">
            Tell us what you'd like to help with
        </MudButton>
    </div>
</Chapter>

@code {
    private ElementReference _hero;

    private static readonly string[] MerchFields = ["amethyst", "gold", "plum"];

    private List<EventDto> _events = [];
    private List<MerchItemDto> _merch = [];
    private List<AchievementDto> _achievements = [];
    private List<OpportunityDto> _opportunities = [];
    private List<MemberDto> _execs = [];
    private List<GuildPhoto> _photos = [];
    private List<SkyChart.SkyPoint> _sky = [];

    private DateTime _month = DateTime.Now;
    private bool _loading = true;

    private string MonthNote
    {
        get
        {
            var soonest = _opportunities
                .Where(o => o.DaysLeft is not null)
                .Select(o => o.DaysLeft!.Value)
                .DefaultIfEmpty(int.MaxValue)
                .Min();

            return soonest switch
            {
                int.MaxValue => _month.ToString("MMMM yyyy"),
                <= 0 => "A deadline closes today",
                1 => "A deadline closes tomorrow",
                <= 7 => $"Next deadline in {soonest} days",
                _ => _month.ToString("MMMM yyyy"),
            };
        }
    }

    private static string Count(int n, string one, string? many = null) =>
        $"{n} {(n == 1 ? one : many ?? one + "s")}";

    protected override async Task OnInitializedAsync()
    {
        var (year, month) = await EventService.GetDisplayMonthAsync();
        _month = new DateTime(year, month, 1);

        _events = (await EventService.GetThisMonthEventsAsync())
            .OrderBy(e => e.StartDateTime)
            .ToList();

        _merch = await MerchService.GetMerchAsync();

        _opportunities = [.. (await OpportunityFeed.GetAllAsync())
            .Where(o => !o.IsClosed)
            .OrderBy(o => o.ClosesAt ?? DateTimeOffset.MaxValue)];

        _sky = BuildSky();

        _achievements = await AchievementService.GetAchievementsAsync();

        _execs = [.. (await MemberService.GetMembersAsync())
            .Where(m => m.Category == MemberCategory.ExeCom)
            .OrderBy(m => m.DisplayOrder)];

        _photos = await GuildPhotos.GetAsync();

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Motion.TrackScrollAsync(_hero);
        }
    }

    private List<SkyChart.SkyPoint> BuildSky()
    {
        var points = new List<SkyChart.SkyPoint>();

        foreach (var evt in _events.Where(e => e.IsScheduled))
        {
            if (EventTiming.Starts(evt) is { } starts)
            {
                points.Add(new(starts.Date, evt.Title, $"events/{evt.Id}", SkyChart.SkyKind.Event));
            }
        }

        foreach (var item in _opportunities.Where(o => !o.IsDateTentative))
        {
            if (item.ClosesAt is { } closes)
            {
                points.Add(new(closes.ToLocalTime().Date, item.Title, $"opportunities/{item.Id}",
                    SkyChart.SkyKind.Deadline, item.DaysLeft is <= 7));
            }

            if (item.HappensAt is { } happens)
            {
                points.Add(new(happens.ToLocalTime().Date, item.Title, $"opportunities/{item.Id}",
                    SkyChart.SkyKind.Happens));
            }
        }

        return points;
    }
}
