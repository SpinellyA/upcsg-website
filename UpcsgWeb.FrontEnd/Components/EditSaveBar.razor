@* Floating bar for the entry currently being edited in place.

   One bar for the whole entry rather than a save button per field: an officer fixing a
   title and a paragraph is doing one edit, and should commit it once. It also gives the
   structured fields somewhere to live — Year, Category and the photo URL aren't text on
   the page, so they stay behind "More fields". *@

<div class="upcsg-savebar" role="status">
    <div class="upcsg-savebar__what">
        <span class="upcsg-savebar__label">Editing</span>
        <span class="upcsg-savebar__name">@Name</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <span class="upcsg-savebar__error">@Error</span>
    }
    else if (Dirty)
    {
        <span class="upcsg-savebar__dirty">Unsaved changes</span>
    }
    else
    {
        <span class="upcsg-savebar__hint">Click any text to edit it &middot; Esc undoes a field</span>
    }

    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Saving" OnClick="OnMore">
        More fields
    </MudButton>
    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="Saving" OnClick="OnCancel">
        @(Dirty ? "Discard" : "Done")
    </MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Class="upcsg-cta-button px-5"
               Disabled="Saving || !Dirty || !CanSave" OnClick="OnSave">
        @(Saving ? "Saving…" : "Save")
    </MudButton>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool CanSave { get; set; } = true;
    [Parameter] public string? Error { get; set; }

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnMore { get; set; }
}
