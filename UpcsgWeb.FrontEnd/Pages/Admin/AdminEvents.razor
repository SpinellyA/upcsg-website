@page "/admin/events"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAdminContentService Admin
@inject IEventService Events
@inject NavigationManager Navigation

<PageTitle>Events - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">Events</h1>
        </div>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="@($"admin/events/new?year={_year}&month={_month}")">
            New Event
        </MudButton>
    </div>

    <AdminNav />

    <div class="upcsg-monthnav mt-4">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="() => ShiftMonthAsync(-1)" />
        <span class="upcsg-monthnav__label">@(new DateTime(_year, _month, 1).ToString("MMMM yyyy"))</span>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="() => ShiftMonthAsync(1)" />
        <MudButton Variant="Variant.Text" Class="ml-2" OnClick="GoToCurrentMonthAsync">Today</MudButton>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudTable Items="_events"
                  T="EventDto"
                  Hover="true"
                  Class="upcsg-datatable mt-4"
                  Elevation="0"
                  Dense="true"
                  Loading="_loading"
                  LoadingProgressColor="Color.Primary"
                  Filter="new Func<EventDto, bool>(Matches)"
                  AllowUnsorted="false"
                  OnRowClick="@(args => OpenEvent(args.Item))"
                  RowClass="upcsg-datatable__row">
            <ToolBarContent>
                <MudTextField @bind-Value="_search"
                              Immediate="true"
                              DebounceInterval="150"
                              Placeholder="Search this month's events"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Text"
                              Clearable="true"
                              Class="upcsg-datatable__search mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel T="EventDto" SortBy="@(e => e.StartDateTime)" InitialDirection="SortDirection.Ascending">When</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="EventDto" SortBy="@(e => e.Title)">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="EventDto" SortBy="@(e => e.Location)">Location</MudTableSortLabel></MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="When">
                    @if (context.IsScheduled && context.StartDateTime is { } when)
                    {
                        @when.ToLocalTime().ToString("MMM d, h:mm tt")
                    }
                    else if (context.StartDateTime is { } pencilled)
                    {
                        <text>Around @pencilled.ToLocalTime().ToString("MMMM yyyy")</text>
                    }
                    else
                    {
                        <text>Date to be announced</text>
                    }
                </MudTd>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Location">@context.Location</MudTd>
                <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <p class="upcsg-lede my-4">
                    @(string.IsNullOrWhiteSpace(_search) ? "No events in this month yet." : $"Nothing this month matches \"{_search}\".")
                </p>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="PageSizes" InfoFormat="{first_item}-{last_item} of {all_items} events" />
            </PagerContent>
        </MudTable>

        @* Outside the month table on purpose. These have no date, so they belong to no
           month, and a month-by-month list would hide them for good once created. *@
        @if (_comingSoon.Count > 0)
        {
            <MudText Typo="Typo.overline" Class="upcsg-panel__title mt-8">
                Coming soon (no confirmed date)
            </MudText>
            <MudText Typo="Typo.caption" Class="upcsg-panel__hint mb-2">
                Shown here whichever month you are viewing, because they do not belong to one.
                Give an event a date and clear "not final" to move it into that month.
            </MudText>

            <MudTable Items="_comingSoon" Class="upcsg-datatable" Hover="true" Dense="true"
                      Elevation="0" OnRowClick="@(args => OpenEvent(args.Item))"
                      RowClass="upcsg-datatable__row" T="EventDto">
                <HeaderContent>
                    <MudTh>When</MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>Location</MudTh>
                    <MudTh Style="width:3rem"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="When">
                        @if (context.StartDateTime is { } pencilled)
                        {
                            <text>Around @pencilled.ToLocalTime().ToString("MMMM yyyy")</text>
                        }
                        else
                        {
                            <text>Date to be announced</text>
                        }
                    </MudTd>
                    <MudTd DataLabel="Title">@context.Title</MudTd>
                    <MudTd DataLabel="Location">@context.Location</MudTd>
                    <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50];

    private List<EventDto> _events = [];
    private List<EventDto> _comingSoon = [];
    private int _year = DateTime.Now.Year;
    private int _month = DateTime.Now.Month;
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _error;

    private bool Matches(EventDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();

        return item.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (item.Location?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    [Parameter, SupplyParameterFromQuery] public int? Year { get; set; }

    [Parameter, SupplyParameterFromQuery] public int? Month { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Year is >= 1 and <= 9999 && Month is >= 1 and <= 12)
        {
            _year = Year.Value;
            _month = Month.Value;
        }
        else
        {
            var (year, month) = await Events.GetDisplayMonthAsync();
            _year = year;
            _month = month;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _events = await Admin.GetEventsAsync(_year, _month);
            _comingSoon = await Admin.GetComingSoonEventsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ShiftMonthAsync(int delta)
    {
        var shifted = new DateTime(_year, _month, 1).AddMonths(delta);
        _year = shifted.Year;
        _month = shifted.Month;
        await LoadAsync();
    }

    private async Task GoToCurrentMonthAsync()
    {
        _year = DateTime.Now.Year;
        _month = DateTime.Now.Month;
        await LoadAsync();
    }

    private void OpenEvent(EventDto? item)
    {
        if (item is not null)
        {
            Navigation.NavigateTo($"admin/events/{item.Id}?year={_year}&month={_month}");
        }
    }
}
