@page "/admin"
@page "/admin/orders"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IOrderService OrderService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Orders - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">Orders</h1>
        </div>
        <div class="upcsg-section-head__actions">
            <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                       StartIcon="@Icons.Material.Filled.Outbox"
                       Disabled="_releasing || ConfirmedCount == 0"
                       OnClick="ReleaseConfirmedAsync">
                @(_releasing
                    ? "Releasing…"
                    : ConfirmedCount == 0 ? "Nothing to release" : $"Release {ConfirmedCount} confirmed")
            </MudButton>

            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6"
                       StartIcon="@Icons.Material.Filled.Refresh" Disabled="_releasing" OnClick="LoadAsync">
                Refresh
            </MudButton>
        </div>
    </div>

    <AdminNav />

    @* Seven pills in a flat row read as seven equal choices, which they are not. The
       queue splits in two: statuses an officer works, and two archives they look
       things up in. Grouping says that, and keeps every one a single click - a
       dropdown would tidy the row by hiding the counts, which are the point. *@
    <div class="upcsg-filter upcsg-filter--records mt-4" role="group" aria-label="Filter orders">
        <button type="button" class="upcsg-filter__btn upcsg-filter__btn--all"
                aria-pressed="@(_filter is null ? "true" : "false")"
                @onclick="() => SetFilterAsync(null)">
            Open queue
            @if (_open.Count > 0)
            {
                <span class="upcsg-filter__count">@_open.Count</span>
            }
        </button>

        <span class="upcsg-filter__sep" aria-hidden="true"></span>

        @foreach (var status in LiveStatuses)
        {
            var s = status;
            var count = OpenCount(s);

            <button type="button" class="upcsg-filter__btn @(count == 0 ? "upcsg-filter__btn--empty" : null)"
                    aria-pressed="@(_filter == s ? "true" : "false")"
                    @onclick="() => SetFilterAsync(s)">
                @OrderStatusDisplay.Label(s)
                @if (count > 0)
                {
                    <span class="upcsg-filter__count">@count</span>
                }
            </button>
        }

        <span class="upcsg-filter__sep" aria-hidden="true"></span>

        @foreach (var status in ArchiveStatuses)
        {
            var s = status;

            <button type="button" class="upcsg-filter__btn upcsg-filter__btn--quiet"
                    aria-pressed="@(_filter == s ? "true" : "false")"
                    @onclick="() => SetFilterAsync(s)">
                @OrderStatusDisplay.Label(s)
            </button>
        }
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudTable Items="_orders"
                  T="OrderDto"
                  Hover="true"
                  Elevation="0"
                  Dense="true"
                  Class="upcsg-datatable mt-4"
                  OnRowClick="OpenOrder"
                  RowClass="upcsg-datatable__row"
                  Loading="_loading"
                  LoadingProgressColor="Color.Primary"
                  Filter="new Func<OrderDto, bool>(Matches)"
                  AllowUnsorted="false">
            <ToolBarContent>
                <MudTextField @bind-Value="_search"
                              Immediate="true"
                              DebounceInterval="150"
                              Placeholder="Search order #, guilder or status"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Text"
                              Clearable="true"
                              Class="upcsg-datatable__search mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="OrderDto" SortBy="@(o => o.Id)" InitialDirection="SortDirection.Descending">
                        Order
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="OrderDto" SortBy="@(o => o.PlacedAt)"
                                       InitialDirection="SortDirection.Ascending">
                        Waiting
                    </MudTableSortLabel>
                </MudTh>
                <MudTh><MudTableSortLabel T="OrderDto" SortBy="@(o => o.GuilderName ?? string.Empty)">Guilder</MudTableSortLabel></MudTh>
                <MudTh Class="upcsg-num">
                    <MudTableSortLabel T="OrderDto" SortBy="@(o => o.Lines.Sum(l => l.Quantity))">Items</MudTableSortLabel>
                </MudTh>
                <MudTh Class="upcsg-num"><MudTableSortLabel T="OrderDto" SortBy="@(o => o.Total)">Total</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="OrderDto" SortBy="@(o => o.Status)">Status</MudTableSortLabel></MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order"><strong>#@context.Reference</strong></MudTd>

                @* How long it has been sitting, not just when it arrived. A receipt
                   submitted four days ago is the one that needs an officer; the exact
                   timestamp is what you check afterwards, so it goes underneath. *@
                <MudTd DataLabel="Waiting">
                    <span class="@(IsStale(context) ? "upcsg-age upcsg-age--stale" : "upcsg-age")">
                        @Age(context.PlacedAt)
                    </span>
                    <span class="upcsg-datatable__flag">
                        @context.PlacedAt.ToLocalTime().ToString("MMM d, yyyy")
                    </span>
                </MudTd>

                <MudTd DataLabel="Guilder">
                    @if (string.IsNullOrWhiteSpace(context.GuilderName))
                    {
                        <span class="upcsg-datatable__flag">Guilder @OrderReference.For(context.UserId)</span>
                    }
                    else
                    {
                        @context.GuilderName
                        @if (!string.IsNullOrWhiteSpace(context.GuilderEmail))
                        {
                            <span class="upcsg-datatable__flag">@context.GuilderEmail</span>
                        }
                    }
                </MudTd>

                <MudTd DataLabel="Items" Class="upcsg-num">@context.Lines.Sum(l => l.Quantity)</MudTd>
                <MudTd DataLabel="Total" Class="upcsg-num">
                    &#8369;@context.Total.ToString("N2")
                </MudTd>
                <MudTd DataLabel="Status">
                    <span class="upcsg-statuspill upcsg-statuspill--@OrderStatusDisplay.Slug(context.Status)">
                        @OrderStatusDisplay.Label(context.Status)
                    </span>

                    @if (context.HasRefundDue)
                    {
                        <span class="upcsg-datatable__flag">&#8369;@context.RefundDue.ToString("N2") owed back</span>
                    }
                </MudTd>
                <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <p class="upcsg-lede my-4">
                    @(string.IsNullOrWhiteSpace(_search)
                        ? _filter is null ? "The queue is clear. Nothing needs an officer right now." : "No orders with that status."
                        : $"No orders match \"{_search}\".")
                </p>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="PageSizes" InfoFormat="{first_item}-{last_item} of {all_items} orders" />
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    // Statuses that still need somebody, and the two that are only ever looked up.
    private static readonly OrderStatusDto[] ArchiveStatuses =
    [
        OrderStatusDto.Received,
        OrderStatusDto.Cancelled,
    ];

    private static readonly int[] PageSizes = [10, 25, 50, 100];

    // Statuses that still need somebody. Anything past these is history.
    private static readonly OrderStatusDto[] LiveStatuses =
    [
        OrderStatusDto.AwaitingPayment,
        OrderStatusDto.Pending,
        OrderStatusDto.Acknowledged,
        OrderStatusDto.Released,
    ];

    private List<OrderDto> _orders = [];
    private OrderStatusDto? _filter;
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _releasing;
    private string? _error;

    // The whole open queue, held so the filter counts and the release button come from
    // one fetch. Switching between live statuses is then a local filter, not a round
    // trip; only the two archive statuses go back to the server.
    private List<OrderDto> _open = [];

    private int ConfirmedCount => _open.Count(o => o.Status == OrderStatusDto.Acknowledged);

    private int OpenCount(OrderStatusDto status) =>
        LiveStatuses.Contains(status) ? _open.Count(o => o.Status == status) : 0;

    // An order nobody has touched for a few days is the one worth surfacing. Three days
    // is a guess, but a guess that draws the eye to the right rows beats no signal.
    private static bool IsStale(OrderDto order) =>
        order.Status is OrderStatusDto.Pending or OrderStatusDto.AwaitingPayment
        && (DateTimeOffset.Now - order.PlacedAt).TotalDays >= 3;

    private static string Age(DateTimeOffset placed)
    {
        var span = DateTimeOffset.Now - placed;

        return span switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)span.TotalMinutes}m",
            { TotalHours: < 24 } => $"{(int)span.TotalHours}h",
            { TotalDays: < 7 } => $"{(int)span.TotalDays}d",
            _ => $"{(int)(span.TotalDays / 7)}w",
        };
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ReleaseConfirmedAsync()
    {
        var owing = _open.Count(o => o.Status == OrderStatusDto.Acknowledged && o.HasRefundDue);

        var detail = $"Mark {ConfirmedCount} confirmed order(s) as released? Do this once the items are actually in the guilders' hands.";

        if (owing > 0)
        {
            detail += $"\n\n{owing} of them still owe a refund. Releasing doesn't send that money, so you'll still have to settle it.";
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Release confirmed orders", detail, yesText: "Release all", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _releasing = true;

        try
        {
            var result = await OrderService.ReleaseConfirmedAsync();

            Snackbar.Add(
                result.ReleasedCount == 0
                    ? "Nothing was released."
                    : $"Released {result.ReleasedCount} order(s).",
                result.ReleasedCount == 0 ? Severity.Info : Severity.Success);

            foreach (var skip in result.Skipped)
            {
                Snackbar.Add($"Skipped {skip}", Severity.Warning);
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _releasing = false;
        }
    }

    private bool Matches(OrderDto order)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim().TrimStart('#');
        var loose = term.Replace("-", string.Empty);

        return order.Reference.Contains(term, StringComparison.OrdinalIgnoreCase)
            || order.Reference.Replace("-", string.Empty).Contains(loose, StringComparison.OrdinalIgnoreCase)
            || (order.GuilderName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (order.GuilderEmail?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)

            || order.Id.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
            || OrderStatusDisplay.Label(order.Status).Contains(term, StringComparison.OrdinalIgnoreCase)
            || order.Lines.Any(l => l.ItemName.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private void OpenOrder(TableRowClickEventArgs<OrderDto> args)
    {
        if (args.Item is not null)
        {
            Navigation.NavigateTo($"admin/orders/{args.Item.Id}");
        }
    }

    private async Task SetFilterAsync(OrderStatusDto? status)
    {
        _filter = status;

        // A live status is already in hand; only the archives need the server.
        if (status is null)
        {
            _orders = _open;
            return;
        }

        if (LiveStatuses.Contains(status.Value))
        {
            _orders = [.. _open.Where(o => o.Status == status.Value)];
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _open = await OrderService.GetQueueAsync(null);

            _orders = _filter is { } status && !LiveStatuses.Contains(status)
                ? await OrderService.GetQueueAsync(status)
                : _filter is { } live
                    ? [.. _open.Where(o => o.Status == live)]
                    : _open;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
