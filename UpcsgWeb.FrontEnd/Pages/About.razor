@page "/about"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IMemberService MemberService
@inject IGuildPhotoService GuildPhotos

<PageTitle>About - UPCSG</PageTitle>

<PageMasthead Section="About"
              Field="paper"
              Meta="@(["UP Cebu, Lahug", "A.Y. 2026–2027", _allOfficers.Count > 0 ? $"{_allOfficers.Count} officers" : null])"
              Title="The guild, run by students">
    <Lede>
        The official student organization for Computer Science majors at the University of the
        Philippines Cebu. Every CS student is a member from their first day.
    </Lede>
    <Actions>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="about#execom">Meet the ExeCom</MudButton>
    </Actions>
</PageMasthead>

<Chapter Field="gold">
    <div class="upcsg-identity">
        <Reveal Variant="Reveal.RevealMotion.Up">
            <h2 class="upcsg-identity__title">There is no staff behind us</h2>
        </Reveal>
        <Reveal Variant="Reveal.RevealMotion.Up" Delay="80">
            <p class="upcsg-identity__lede">
                The academic support, the competitions, the industry nights, the socials that hold
                a year together: every one of them is organised by guilders carrying the same
                problem sets and deadlines as the people they organise it for.
            </p>
        </Reveal>
    </div>

    @if (_photos.Count > 0)
    {
        <PhotoRail Photos="_photos" Label="Photos from the guild's year" />
    }

    <Reveal Variant="Reveal.RevealMotion.Up">
        <figure class="upcsg-creed">
            <blockquote>
                Computer science is not just an industry of machines, but a canvas of endless
                creative expression.
            </blockquote>
            <figcaption>From the UPCSG brandbook, A.Y. 2026–2027</figcaption>
        </figure>
    </Reveal>
</Chapter>

@if (_faculty.Count > 0)
{
    <Chapter Field="peri">
        <SectionHeading Title="Faculty advisers" Kicker="From the Department of Computer Science" />

        <div class="upcsg-memberpile">
            @foreach (var (member, i) in _faculty.Select((m, i) => (m, i)))
            {
                <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 70)">
                    <MemberCard Member="member" Roster="_faculty" Tint="@(i + 2)" />
                </Reveal>
            }
        </div>
    </Chapter>
}

<Chapter Field="night" Id="execom">
    <SectionHeading Title="The Executive Committee"
                    Lede="Elected guilders who represent the membership, run the committees, and keep the guild's programs moving." />

    @if (_loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" Class="upcsg-skeleton" />
    }
    else if (_committees.Count == 0)
    {
        <div class="upcsg-empty">
            <p>This year's officers haven't been published yet.</p>
        </div>
    }
    else
    {
        @foreach (var committee in _committees)
        {
            <Reveal Variant="Reveal.RevealMotion.Fade" Class="upcsg-committee-rule">
                <h3>
                    @committee.Name
                    <span class="upcsg-committee-rule__count">@committee.Count @(committee.Count == 1 ? "officer" : "officers")</span>
                </h3>
            </Reveal>

            @foreach (var row in committee.Rows)
            {
                <Reveal Variant="@(row.Flip ? Reveal.RevealMotion.Right : Reveal.RevealMotion.Left)">
                    <OfficerBand Member="row.Member" Flip="row.Flip" Roster="_allOfficers" />
                </Reveal>
            }
        }
    }
</Chapter>

<Chapter Field="amethyst" Class="upcsg-close">
    <h2 class="upcsg-close__title">
        <span>Fancy a hand</span>
        <span>in it?</span>
    </h2>
    <div class="upcsg-close__foot">
        <p>
            The committees above take people on through the year, not just at the start of one.
            Tell us what you'd like to help with.
        </p>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="contact">Tell us what you'd like to do</MudButton>
    </div>
</Chapter>

@code {
    private sealed record ProfileRow(MemberDto Member, bool Flip, bool IsLead);

    private sealed record CommitteeGroup(string Name, List<ProfileRow> Rows)
    {
        public int Count => Rows.Count;
    }

    private List<MemberDto> _faculty = [];
    private List<MemberDto> _allOfficers = [];
    private List<CommitteeGroup> _committees = [];
    private List<GuildPhoto> _photos = [];
    private bool _loading = true;


    protected override async Task OnInitializedAsync()
    {
        _photos = await GuildPhotos.GetAsync();

        var members = await MemberService.GetMembersAsync();

        _faculty = [.. members
            .Where(m => m.Category == MemberCategory.Faculty)
            .OrderBy(m => m.DisplayOrder)];

        var exeCom = members
            .Where(m => m.Category == MemberCategory.ExeCom)
            .OrderBy(m => m.DisplayOrder)
            .ToList();

        _allOfficers = exeCom;

        var groups = exeCom
            .GroupBy(m => string.IsNullOrWhiteSpace(m.Committee) ? "Other" : m.Committee)
            .ToList();

        _committees = [];

        var flip = false;

        foreach (var group in groups)
        {
            var rows = new List<ProfileRow>();
            var leadTaken = false;

            foreach (var member in group)
            {
                rows.Add(new ProfileRow(member, flip, IsLead: !leadTaken));
                leadTaken = true;
                flip = !flip;
            }

            _committees.Add(new CommitteeGroup(group.Key, rows));
        }

        _loading = false;
    }
}
