@page "/events"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IEventService EventService
@inject IJSRuntime JS

<PageTitle>Events - UPCSG</PageTitle>

<section class="upcsg-banner">
    <img class="upcsg-banner__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
    <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 32%; right: 36%;"><span class="upcsg-star" style="width: 1rem; height: 1rem;"></span></span>

    <div class="upcsg-banner__inner">
        <p class="upcsg-eyebrow"><span class="upcsg-star"></span> Events</p>
        <h1 class="upcsg-banner__title">@_month.ToString("MMMM yyyy")</h1>
        <p class="upcsg-lede" style="margin-bottom: 0;">
            We publish the current month only &mdash; later months are still being planned and
            would only change on you.
        </p>
    </div>
</section>

<Marquee Items="@Ticker" DurationSeconds="50" Class="upcsg-marquee--hero" />

<div class="upcsg-page upcsg-page--after-hero">

    @if (_loading)
    {
        <section class="upcsg-section">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" Class="upcsg-skeleton mb-6" />
            <div class="upcsg-cardgrid upcsg-cardgrid--3">
                @for (var i = 0; i < 3; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" Class="upcsg-skeleton" />
                }
            </div>
        </section>
    }
    else if (_events.Count == 0)
    {
        @* The whole page is the empty state when nothing is published — a calendar of
           thirty blank squares above an empty list says less than one clear sentence. *@
        <section class="upcsg-section">
            <Reveal Variant="Reveal.RevealMotion.Fade">
                <div class="upcsg-empty upcsg-empty--tall">
                    <img src="img/upcsg-crest.png" alt="" aria-hidden="true" />
                    <h2 class="upcsg-title-xl">Nothing scheduled yet</h2>
                    <p>
                        @_month.ToString("MMMM")'s lineup hasn't been posted. Our socials get it
                        first, so follow along there and it'll show up here once it's official.
                    </p>
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="contact">
                        Get in touch
                    </MudButton>
                </div>
            </Reveal>
        </section>
    }
    else
    {
        @* ---------- Next up ---------- *@
        @if (_next is not null)
        {
            <section class="upcsg-section">
                <SectionHeading Kicker="@FeatureKicker" Title="@FeatureTitle" />

                <Reveal Variant="Reveal.RevealMotion.Scale">
                    <EventCard Event="_next" Variant="EventCard.Density.Feature" ShowStatus="true" />
                </Reveal>
            </section>
        }

        @* ---------- Calendar rail + listing ---------- *@
        <section class="upcsg-section upcsg-eventslayout">

            @* Sticky so the month stays in reach while the list scrolls past it. This is
               why the page wrappers clip rather than hide their overflow — hidden would
               make them scroll containers and kill the stickiness. *@
            <aside class="upcsg-eventslayout__rail">
                <Reveal Variant="Reveal.RevealMotion.Fade" Class="upcsg-calcard">
                    <div class="upcsg-calcard__head">
                        <p class="upcsg-kicker">
                            <span class="upcsg-star upcsg-star--tiny"></span> At a glance
                        </p>
                        <h2 class="upcsg-calcard__title">@_month.ToString("MMMM")</h2>
                    </div>

                    <div class="upcsg-cal__grid" role="grid" aria-label="@_month.ToString("MMMM yyyy") events">
                        @foreach (var dow in DayNames)
                        {
                            <div class="upcsg-cal__dow" role="columnheader">@dow</div>
                        }

                        @for (var blank = 0; blank < LeadingBlanks; blank++)
                        {
                            <div class="upcsg-cal__cell--empty"></div>
                        }

                        @for (var day = 1; day <= DaysInMonth; day++)
                        {
                            var d = day;
                            var date = new DateTime(_month.Year, _month.Month, d);
                            var dayEvents = EventsOn(date);
                            var isToday = date.Date == DateTime.Today;
                            var isSelected = _selectedDate?.Date == date.Date;
                            var isPast = date.Date < DateTime.Today;

                            if (dayEvents.Count == 0)
                            {
                                <div class="upcsg-cal__day upcsg-cal__day--plain @(isToday ? "upcsg-cal__day--today" : null)">
                                    <span class="upcsg-cal__day-num">@d</span>
                                    <span class="upcsg-cal__dots"></span>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="upcsg-cal__day upcsg-cal__day--has-events @(isToday ? "upcsg-cal__day--today" : null) @(isSelected ? "upcsg-cal__day--selected" : null) @(isPast ? "upcsg-cal__day--past" : null)"
                                        aria-label="@($"{date:MMMM d}, {dayEvents.Count} event{(dayEvents.Count == 1 ? "" : "s")}")"
                                        @onclick="() => SelectDayAsync(date)">
                                    <span class="upcsg-cal__day-num">@d</span>
                                    <span class="upcsg-cal__dots">
                                        @foreach (var _ in dayEvents)
                                        {
                                            <i class="upcsg-cal__dot"></i>
                                        }
                                    </span>
                                </button>
                            }
                        }
                    </div>

                    <div class="upcsg-cal__legend">
                        <span><i></i> Has events</span>
                        <span><i class="is-today"></i> Today</span>
                    </div>

                    @if (_selectedDate is not null)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   FullWidth="true"
                                   Class="upcsg-ghost-button mt-3"
                                   OnClick="ClearSelection">
                            Show all @_events.Count
                        </MudButton>
                    }
                </Reveal>
            </aside>

            <div class="upcsg-eventslayout__list">
                <SectionHeading Kicker="@ListKicker" Title="@ListTitle" />

                <div class="upcsg-eventlist">
                    @foreach (var (evt, i) in Listed.Select((e, i) => (e, i)))
                    {
                        <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 60)">
                            <div id="@($"event-{evt.Id}")"
                                 class="@(_selectedDate?.Date == EventTiming.Starts(evt).Date ? "upcsg-eventlist__hit" : null)">
                                <EventCard Event="evt" ShowStatus="true" />
                            </div>
                        </Reveal>
                    }
                </div>

                @if (Listed.Count == 0)
                {
                    <div class="upcsg-empty">
                        <p>Nothing on @_selectedDate?.ToString("MMMM d").</p>
                    </div>
                }
            </div>
        </section>
    }

</div>

@code {
    private static readonly string[] DayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private static readonly string[] Ticker =
    [
        "General assemblies", "Industry nights", "CodeSprints", "Workshops",
        "Orientations", "Merch drops", "Socials", "UP Cebu",
    ];

    /// <summary>
    /// The month being published, which officers can pin ahead of the real calendar.
    ///
    /// Not DateTime.Today: the events came from the configured month all along, but the
    /// heading and the calendar grid were built from today's date, so pinning July left
    /// an August page with July's events listed under it.
    /// </summary>
    private DateTime _month = DateTime.Today;

    private bool _loading = true;
    private List<EventDto> _events = [];
    private EventDto? _next;
    private DateTime? _selectedDate;

    private DateTime FirstOfMonth => new(_month.Year, _month.Month, 1);
    private int DaysInMonth => DateTime.DaysInMonth(_month.Year, _month.Month);

    // Sunday-first grid, matching the local convention.
    private int LeadingBlanks => (int)FirstOfMonth.DayOfWeek;

    /// <summary>Everything, or just the picked day.</summary>
    private List<EventDto> Listed => _selectedDate is null
        ? _events
        : EventsOn(_selectedDate.Value);

    private string ListKicker => _selectedDate is not null
        ? _selectedDate.Value.ToString("dddd, MMMM d")
        : $"{_events.Count} event{(_events.Count == 1 ? "" : "s")} this month";

    private string ListTitle => _selectedDate is not null ? "That day" : "Everything on";

    // Three states, not two. A pinned month whose events have all finished falls back to
    // the last one, and calling that "Next up / The one to catch" put an invitation over
    // a card the same page had already badged Finished.
    private string FeatureKicker =>
        _next is null ? string.Empty
        : EventTiming.IsUnderway(_next) ? "On right now"
        : EventTiming.HasEnded(_next) ? "That was the month"
        : "Next up";

    private string FeatureTitle =>
        _next is null ? string.Empty
        : EventTiming.IsUnderway(_next) ? "Happening today"
        : EventTiming.HasEnded(_next) ? "How it wrapped up"
        : "The one to catch";

    protected override async Task OnInitializedAsync()
    {
        var (year, month) = await EventService.GetDisplayMonthAsync();
        _month = new DateTime(year, month, 1);

        _events = (await EventService.GetThisMonthEventsAsync())
            .OrderBy(e => e.StartDateTime)
            .ToList();

        // The soonest thing that hasn't finished. Falls back to the last event of the
        // month so a fully past month still leads with something rather than a hole.
        _next = _events.FirstOrDefault(e => !EventTiming.HasEnded(e)) ?? _events.LastOrDefault();

        _loading = false;
    }

    private List<EventDto> EventsOn(DateTime date) =>
        [.. _events.Where(e => EventTiming.Starts(e).Date == date.Date)];

    private void ClearSelection() => _selectedDate = null;

    /// <summary>Picking a day filters the list to it and scrolls the first one into view.</summary>
    private async Task SelectDayAsync(DateTime date)
    {
        var ids = EventsOn(date).Select(e => e.Id).ToList();
        if (ids.Count == 0)
        {
            return;
        }

        _selectedDate = date;

        // The filtered list has to be rendered before there is anything to scroll to.
        StateHasChanged();
        await Task.Yield();

        await JS.InvokeVoidAsync("upcsgScrollToId", $"event-{ids[0]}");
    }
}
