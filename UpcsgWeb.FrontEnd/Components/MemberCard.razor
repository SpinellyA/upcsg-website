@using UpcsgWeb.Shared.Contracts
@inject IDialogService Dialogs

<button type="button"
        class="upcsg-membercard upcsg-membercard--@Variant.ToString().ToLowerInvariant() upcsg-membercard--tint-@(Tint % 4)"
        aria-label="@($"Read {Member.Name}'s profile, {Member.Role}")"
        @onclick="OpenAsync">

    <CosmicImage Src="@Member.PhotoUrl"
                 Alt="@Member.Name"
                 Seed="@Member.Name"
                 ShowInitials="true"
                 Class="upcsg-membercard__portrait" />

    <span class="upcsg-membercard__name">@Member.Name</span>
    <span class="upcsg-membercard__role">@Member.Role</span>

    @if (ShowsBio && !string.IsNullOrWhiteSpace(Member.Bio))
    {
        <span class="upcsg-membercard__bio">@Member.Bio</span>
    }
</button>

@code {
    public enum Density
    {
        Spotlight,

        Showcase,

        Card,

        Row,
    }

    [Parameter, EditorRequired] public MemberDto Member { get; set; } = default!;

    [Parameter] public Density Variant { get; set; } = Density.Card;

    [Parameter] public bool Flip { get; set; }

    [Parameter] public int Tint { get; set; }

    private bool ShowsBio => Variant is Density.Spotlight or Density.Showcase;

    [Parameter] public IReadOnlyList<MemberDto>? Roster { get; set; }

    private Task OpenAsync()
    {
        var roster = Roster is { Count: > 0 } ? Roster : [Member];
        var index = Math.Max(0, roster.ToList().FindIndex(m => m.Id == Member.Id));

        var parameters = new DialogParameters<MemberDialog>
        {
            { d => d.Members, roster },
            { d => d.Index, index },
        };

        return Dialogs.ShowAsync<MemberDialog>(
            Member.Name,
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,

                CloseButton = false,
                BackdropClick = true,
            });
    }
}
