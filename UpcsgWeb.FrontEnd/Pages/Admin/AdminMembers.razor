@page "/admin/members"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAdminContentService Admin
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>People - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">People</h1>
        </div>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">
            New Person
        </MudButton>
    </div>

    <AdminNav />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        @* Grouping stays: Faculty and ExeCom are different kinds of people, not
           two values of one column. Sorting applies inside each group. *@
        <MudTable Items="_members"
                  T="MemberDto"
                  Hover="true"
                  Class="upcsg-datatable mt-4"
                  Elevation="0"
                  Dense="true"
                  GroupBy="_groupDefinition"
                  Loading="_loading"
                  LoadingProgressColor="Color.Primary"
                  Filter="new Func<MemberDto, bool>(Matches)"
                  AllowUnsorted="false"
                  OnRowClick="@(args => OpenAsync(args.Item))"
                  RowClass="upcsg-datatable__row">
            <ToolBarContent>
                <MudTextField @bind-Value="_search"
                              Immediate="true"
                              DebounceInterval="150"
                              Placeholder="Search name, role or committee"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Text"
                              Clearable="true"
                              Class="upcsg-datatable__search mt-0" />
            </ToolBarContent>
            <HeaderContent>
                @* Display order is the running order of the public page, so it leads. *@
                <MudTh Class="upcsg-num">
                    <MudTableSortLabel T="MemberDto" SortBy="@(m => m.DisplayOrder)" InitialDirection="SortDirection.Ascending">Order</MudTableSortLabel>
                </MudTh>
                <MudTh><MudTableSortLabel T="MemberDto" SortBy="@(m => m.Name)">Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="MemberDto" SortBy="@(m => m.Role)">Role</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="MemberDto" SortBy="@(m => m.Committee)">Committee</MudTableSortLabel></MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="upcsg-adminnav__group" colspan="5">@context.Key</MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Order" Class="upcsg-num">@context.DisplayOrder</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Role">@context.Role</MudTd>
                <MudTd DataLabel="Committee">@context.Committee</MudTd>
                <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <p class="upcsg-lede my-4">
                    @(string.IsNullOrWhiteSpace(_search) ? "Nobody listed yet." : $"Nobody matches \"{_search}\".")
                </p>
            </NoRecordsContent>
        </MudTable>
    }
</div>

@code {
    private List<MemberDto> _members = [];
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _error;

    private bool Matches(MemberDto member)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();

        return member.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (member.Role?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (member.Committee?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private readonly TableGroupDefinition<MemberDto> _groupDefinition = new()
    {
        Selector = m => m.Category == MemberCategory.Faculty ? "Faculty" : "Executive Committee",
        Indentation = false,
        Expandable = false,
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _members = await Admin.GetMembersAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Rows are click-to-open; MudTable hands us the item that was clicked.</summary>
    private Task OpenAsync(MemberDto? item) => item is null ? Task.CompletedTask : EditAsync(item);

    private async Task EditAsync(MemberDto? existing)
    {
        var draft = existing is null
            ? new MemberDto { Category = MemberCategory.ExeCom, DisplayOrder = _members.Count + 1 }
            : new MemberDto
            {
                Id = existing.Id,
                Name = existing.Name,
                Role = existing.Role,
                Category = existing.Category,
                Committee = existing.Committee,
                PhotoUrl = existing.PhotoUrl,
                Quote = existing.Quote,
                Bio = existing.Bio,
                DisplayOrder = existing.DisplayOrder,
            };

        var parameters = new DialogParameters<MemberEditDialog> { { x => x.Item, draft } };
        var dialog = await DialogService.ShowAsync<MemberEditDialog>(
            existing is null ? "New person" : $"Edit {existing.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is EditDialogAction.Delete && existing is not null)
        {
            await DeleteAsync(existing);
            return;
        }

        try
        {
            await Admin.SaveMemberAsync(draft);
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(MemberDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove person", $"Remove {item.Name} from the site?", yesText: "Remove", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Admin.DeleteMemberAsync(item.Id);
            Snackbar.Add("Removed.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
