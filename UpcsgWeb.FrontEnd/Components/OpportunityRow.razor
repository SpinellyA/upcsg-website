@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services

<MenuRow Href="@($"opportunities/{Opportunity.Id}")"
         Id="@Id"
         Title="@Opportunity.Title"
         ImageSrc="@Opportunity.PosterUrl"
         Aside="@OpportunityText.Deadline(Opportunity)"
         Description="@Line"
         Extra="@(ShowBlurb && !string.IsNullOrWhiteSpace(Opportunity.Description) ? OpportunityText.Summarise(Opportunity.Description) : null)"
         Muted="Opportunity.IsClosed"
         Hit="Hit" />

@code {
    [Parameter, EditorRequired] public OpportunityDto Opportunity { get; set; } = default!;

    [Parameter] public bool ShowBlurb { get; set; }

    [Parameter] public bool Hit { get; set; }

    [Parameter] public string? Id { get; set; }

    private string Line
    {
        get
        {
            var parts = new List<string> { OpportunityText.KindLabel(Opportunity.Kind) };
            if (!string.IsNullOrWhiteSpace(Opportunity.Organiser)) parts.Add($"by {Opportunity.Organiser}");
            if (Opportunity.IsFeatured) parts.Add("Featured");
            return string.Join(" · ", parts);
        }
    }
}
