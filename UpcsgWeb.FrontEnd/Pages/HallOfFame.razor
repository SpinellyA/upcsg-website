@page "/hall-of-fame"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAchievementService AchievementService
@inject IAdminContentService Admin
@inject ISnackbar Snackbar

<PageTitle>Hall of Fame - UPCSG</PageTitle>

<section class="upcsg-banner">
    <img class="upcsg-banner__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
    <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 28%; right: 34%;"><span class="upcsg-star" style="width: 1rem; height: 1rem;"></span></span>
    <span class="upcsg-sparkle upcsg-sparkle--lilac upcsg-sparkle--delay-2" style="bottom: 32%; right: 46%;"><span class="upcsg-star" style="width: 0.65rem; height: 0.65rem;"></span></span>

    <div class="upcsg-banner__inner">
        <p class="upcsg-eyebrow"><span class="upcsg-star"></span> Hall of fame</p>
        <h1 class="upcsg-banner__title">What We've Won</h1>
        <p class="upcsg-lede" style="margin-bottom: 0;">
            The wins, awards, and milestones our members and the guild have collected over the years
            &mdash; each one written up properly, not just listed.
        </p>
    </div>
</section>

<div class="upcsg-page upcsg-page--after-hero">

    @* ---------- Summary, derived from the record itself.
         Suppressed while the record is short: "1 year covered / 2 categories" measures
         how little has been verified, not the guild's achievements. ---------- *@
    @if (_all.Count >= MinimumEntriesForStats)
    {
        <section class="upcsg-section upcsg-band">
            <div class="upcsg-stats">
                <div>
                    <p class="upcsg-stat__value upcsg-gradient-text">@_all.Count</p>
                    <p class="upcsg-stat__label">Entries on record</p>
                </div>
                <div>
                    <p class="upcsg-stat__value upcsg-gradient-text">@YearSpan</p>
                    <p class="upcsg-stat__label">Years covered</p>
                </div>
                <div>
                    <p class="upcsg-stat__value upcsg-gradient-text">@_categories.Count</p>
                    <p class="upcsg-stat__label">Categories</p>
                </div>
            </div>
        </section>
    }

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_all.Count == 0)
    {
        <section class="upcsg-section upcsg-band">
            <p class="upcsg-kicker">Nothing yet</p>
            <h2 class="upcsg-title-xl">The record is empty</h2>
            <p class="upcsg-lede" style="margin-bottom: 0;">
                Nothing has been verified for the record yet. Check back soon.
            </p>
        </section>
    }
    else
    {
        @* ---------- Lead story ----------
           The most recent entry gets the full-width treatment. With a thin record this is
           the difference between a page that looks curated and a page that looks unfinished. *@
        @if (Lead is not null)
        {
            var lead = _draft.Display(Lead, a => a.Id);

            <section class="upcsg-section upcsg-editable">
                <EditPencil Large="true" Label="@($"Edit {lead.Title}")" OnEdit="() => OpenEditor(lead)" />

                <a class="upcsg-lead" href="@($"hall-of-fame/{lead.Id}")" @onclick:preventDefault="IsEditing(lead)" @onclick="() => {}">
                    <span class="upcsg-lead__media">
                        <AchievementImage Entry="lead" />
                    </span>

                    <span class="upcsg-lead__body">
                        <span class="upcsg-lead__kicker">
                            <span class="upcsg-star"></span>
                            Most recent
                            @if (!string.IsNullOrWhiteSpace(lead.Category))
                            {
                                <text> &middot; @lead.Category</text>
                            }
                            <text> &middot; @lead.Year</text>
                        </span>
                        <h2 class="upcsg-lead__title">
                            <InlineText Active="IsEditing(lead)" Value="@lead.Title" ValueChanged="v => lead.Title = v ?? string.Empty" OnRevert="RevertField" Placeholder="Title" />
                        </h2>
                        <p class="upcsg-lead__standfirst">
                            <InlineText Active="IsEditing(lead)" Multiline="true" Value="@Prose.Standfirst(lead.Description)" ValueChanged="v => ReplaceStandfirst(lead, v)" OnRevert="RevertField" Placeholder="Summary" />
                        </p>
                        <span class="upcsg-card__cue">Read the story <span aria-hidden="true">&rarr;</span></span>
                    </span>
                </a>
            </section>
        }

        @* ---------- The rest of the record ---------- *@
        <section class="upcsg-section">
            <div class="upcsg-section-head">
                <div>
                    <p class="upcsg-kicker">
                        @if (_activeCategory is null)
                        {
                            <text>All categories</text>
                        }
                        else
                        {
                            <text>Filtered by @_activeCategory</text>
                        }
                    </p>
                    <h2 class="upcsg-title-xl">The Record</h2>
                </div>
            </div>

            @* Explains a short list, so it reads as a standard being upheld rather than a gap. *@
            <p class="upcsg-lede">
                We only list achievements the ExeCom can verify. Wins from earlier years are being
                confirmed and added as we go &mdash; if one is missing, tell us and we'll chase the record down.
            </p>

            @if (_categories.Count > 1)
            {
                <div class="upcsg-filter" role="group" aria-label="Filter achievements by category">
                    <button type="button"
                            class="upcsg-filter__btn"
                            aria-pressed="@(_activeCategory is null ? "true" : "false")"
                            @onclick="() => SetCategory(null)">
                        All (@_all.Count)
                    </button>

                    @foreach (var category in _categories)
                    {
                        var c = category;
                        <button type="button"
                                class="upcsg-filter__btn"
                                aria-pressed="@(_activeCategory == c ? "true" : "false")"
                                @onclick="() => SetCategory(c)">
                            @c (@_all.Count(a => a.Category == c))
                        </button>
                    }
                </div>
            }

            @if (Visible.Count == 0)
            {
                <p class="upcsg-lede">Nothing recorded under this category yet.</p>
            }
            else
            {
                @foreach (var group in Visible.GroupBy(a => a.Year).OrderByDescending(g => g.Key))
                {
                    <div class="upcsg-yearrule">
                        <h3 class="upcsg-yearrule__year">@group.Key</h3>
                        <span class="upcsg-yearrule__line"></span>
                        <span class="upcsg-yearrule__count">@group.Count() entr@(group.Count() == 1 ? "y" : "ies")</span>
                    </div>

                    <div class="upcsg-storygrid">
                        @foreach (var item in group.OrderBy(a => a.Title))
                        {
                            var entry = _draft.Display(item, a => a.Id);

                            <div class="upcsg-editable">
                                <EditPencil Label="@($"Edit {entry.Title}")" OnEdit="() => OpenEditor(entry)" />

                                <a class="upcsg-surface upcsg-lift upcsg-story" href="@($"hall-of-fame/{entry.Id}")" @onclick:preventDefault="IsEditing(entry)" @onclick="() => {}">
                                    <span class="upcsg-story__media">
                                        <AchievementImage Entry="entry" />
                                    </span>

                                    <span class="upcsg-story__body">
                                        @if (!string.IsNullOrWhiteSpace(entry.Category))
                                        {
                                            <span class="upcsg-card__tag">@entry.Category</span>
                                        }

                                        <h4 class="upcsg-story__title">
                                            <InlineText Active="IsEditing(entry)"
                                                        Value="@entry.Title"
                                                        ValueChanged="v => entry.Title = v ?? string.Empty"
                                                        OnRevert="RevertField"
                                                        Placeholder="Title" />
                                        </h4>

                                        @* Only the standfirst is inline here — the rest of the story is long-form
                                           and belongs on the article, where there's room for it. *@
                                        <p class="upcsg-story__standfirst">
                                            <InlineText Active="IsEditing(entry)"
                                                        Multiline="true"
                                                        Value="@Prose.Standfirst(entry.Description)"
                                                        ValueChanged="v => ReplaceStandfirst(entry, v)"
                                                        OnRevert="RevertField"
                                                        Placeholder="Summary shown on this card" />
                                        </p>

                                        <span class="upcsg-card__cue">Read <span aria-hidden="true">&rarr;</span></span>
                                    </span>
                                </a>
                            </div>
                        }
                    </div>
                }
            }
        </section>
    }

    @* ---------- Closing CTA ---------- *@
    <section class="upcsg-section upcsg-band upcsg-cta-band">
        <p class="upcsg-kicker">Missing something?</p>
        <h2 class="upcsg-title-xl">Tell us about a win</h2>
        <p class="upcsg-lede">
            If you or a batchmate brought something home for the guild and it isn't here,
            send it our way and we'll add it to the record.
        </p>
        <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8" Href="contact">
            Get in Touch
        </MudButton>
    </section>

</div>

@* ---------- In-place editing ----------
   The text on the card IS the input, so there is nothing to preview. The bar collects the
   edit and the drawer holds the fields that aren't text on the page. *@
@if (_draft.Value is { } bar && !_showDrawer)
{
    <EditSaveBar Name="@bar.Title"
                 Dirty="_draft.IsDirty"
                 Saving="_draft.IsSaving"
                 CanSave="!string.IsNullOrWhiteSpace(bar.Title)"
                 Error="@_editError"
                 OnSave="SaveEditAsync"
                 OnCancel="CancelEdit"
                 OnMore="() => _showDrawer = true" />
}

@if (_draft.Value is { } draft && _showDrawer)
{
    <EditDrawer Open="true"
                Title="@(_draft.EditingId == 0 ? "New entry" : draft.Title)"
                Dirty="_draft.IsDirty"
                Saving="_draft.IsSaving"
                CanSave="!string.IsNullOrWhiteSpace(draft.Title)"
                Error="@_editError"
                Guard="false"
                OnSave="SaveEditAsync"
                OnCancel="() => _showDrawer = false">

        <MudTextField @bind-Value="draft.Title" Immediate="true"
                      Label="Title" Variant="Variant.Outlined" Required="true" Class="mb-4" />

        <MudNumericField @bind-Value="draft.Year" Immediate="true"
                         Label="Year" Variant="Variant.Outlined"
                         Min="1900" Max="@(DateTime.Now.Year + 1)" Class="mb-4" />

        @* Free text, but suggestions keep categories consistent — the filter chips on this
           page are derived from whatever is stored here. *@
        <MudAutocomplete T="string" @bind-Value="draft.Category"
                         Label="Category" Variant="Variant.Outlined"
                         CoerceValue="true" SearchFunc="SearchCategories" Class="mb-4" />

        <MudTextField @bind-Value="draft.ImageUrl" Immediate="true"
                      Label="Photo URL" Variant="Variant.Outlined"
                      HelperText="Paste a link for now. Uploads come with the file server."
                      Class="mb-4" />

        <MudTextField @bind-Value="draft.Description" Immediate="true"
                      Label="Story" Variant="Variant.Outlined" Lines="14"
                      HelperText="Leave a blank line between paragraphs. The first one is the summary shown on cards."
                      Class="mb-2" />

        <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
            @Prose.Paragraphs(draft.Description).Count paragraph(s).
            The card preview behind this drawer updates as you type.
        </MudText>
    </EditDrawer>
}

@code {
    /// <summary>Below this, the summary stats describe the backlog rather than the guild.</summary>
    private const int MinimumEntriesForStats = 3;

    private List<AchievementDto> _all = [];
    private List<string> _categories = [];
    private string? _activeCategory;
    private bool _loading = true;

    /// <summary>
    /// Newest entry, and the only one shown large. Deliberately not filtered: the lead is
    /// "the latest thing the guild did", not "the latest thing in this category".
    /// </summary>
    private AchievementDto? Lead => _all
        .OrderByDescending(a => a.Year)
        .ThenByDescending(a => a.Id)
        .FirstOrDefault();

    private List<AchievementDto> Visible =>
        (_activeCategory is null
            ? _all
            : _all.Where(a => a.Category == _activeCategory))
        .Where(a => a.Id != Lead?.Id)
        .ToList();

    private string YearSpan
    {
        get
        {
            if (_all.Count == 0)
            {
                return "0";
            }

            var min = _all.Min(a => a.Year);
            var max = _all.Max(a => a.Year);
            return min == max ? min.ToString() : $"{max - min + 1}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _all = await AchievementService.GetAchievementsAsync();

            _categories = _all
                .Select(a => a.Category)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c!)
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetCategory(string? category) => _activeCategory = category;

    // --- In-place editing -------------------------------------------------------------

    private readonly ContentDraft<AchievementDto> _draft = new();
    private string? _editError;
    private bool _showDrawer;

    private bool IsEditing(AchievementDto entry) => _draft.IsOpen && _draft.EditingId == entry.Id;

    /// <summary>
    /// Escape in a field puts the whole entry back to how it was opened. Per-field undo
    /// would need a snapshot per control for very little gain — the officer is one Esc
    /// away from a clean slate either way.
    /// </summary>
    private void RevertField()
    {
        if (_draft.IsOpen)
        {
            var original = _all.FirstOrDefault(a => a.Id == _draft.EditingId);

            if (original is not null)
            {
                _draft.Open(original, original.Id);
            }
        }
    }

    /// <summary>
    /// Swaps the opening paragraph, leaving the rest of the story untouched. The card only
    /// ever shows the standfirst, so editing it there must not silently drop the body.
    /// </summary>
    private static void ReplaceStandfirst(AchievementDto entry, string? standfirst)
    {
        var rest = Prose.Rest(entry.Description).ToList();

        entry.Description = rest.Count == 0
            ? standfirst ?? string.Empty
            : string.Join("\n\n", new[] { standfirst ?? string.Empty }.Concat(rest));
    }

    private static readonly string[] SuggestedCategories =
        ["Competition", "Recognition", "Community", "Milestone", "Research"];

    private Task<IEnumerable<string>> SearchCategories(string? value, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? SuggestedCategories.AsEnumerable()
            : SuggestedCategories.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private void OpenEditor(AchievementDto entry)
    {
        _editError = null;
        _showDrawer = false;
        _draft.Open(entry, entry.Id);
    }

    private void CancelEdit()
    {
        _editError = null;
        _showDrawer = false;
        _draft.Close();
    }

    private async Task SaveEditAsync()
    {
        if (_draft.Value is not { } edited)
        {
            return;
        }

        _editError = null;
        _draft.BeginSave();

        try
        {
            var saved = await Admin.SaveAchievementAsync(edited);

            // Replace in place rather than refetching the list: a reload would reorder the
            // page under the officer and lose their scroll position mid-edit.
            var index = _all.FindIndex(a => a.Id == saved.Id);

            if (index >= 0)
            {
                _all[index] = saved;
            }
            else
            {
                _all.Add(saved);
            }

            RebuildCategories();
            _showDrawer = false;
            _draft.Close();
            Snackbar.Add("Saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            // Domain rejections ("Year 2031 is out of range.") belong on the form, next to
            // the field that caused them — not in a snackbar that vanishes.
            _editError = ex.Message;
        }
        finally
        {
            _draft.EndSave();
        }
    }

    private void RebuildCategories()
    {
        _categories = _all
            .Select(a => a.Category)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Select(c => c!)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        // The active filter can disappear when its last entry is recategorised.
        if (_activeCategory is not null && !_categories.Contains(_activeCategory))
        {
            _activeCategory = null;
        }
    }
}
