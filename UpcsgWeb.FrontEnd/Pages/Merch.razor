@page "/merch"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IMerchService MerchService

<PageTitle>Merch - UPCSG</PageTitle>

<PageMasthead Section="Merch"
              Field="amethyst"
              Meta="@([_loading ? null : $"{All.Count} item{(All.Count == 1 ? "" : "s")}", "Pay by GCash or cash"])"
              Title="The guild store">
    <Lede>
        Shirts and totes in the guild's colours. Pick your size, order here, and claim it from an
        officer once it's ready.
    </Lede>
    <Actions>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="merch#items">Browse the items</MudButton>
    </Actions>
</PageMasthead>

@if (_loading)
{
    <Chapter Field="plum">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="520px" Class="upcsg-skeleton" />
    </Chapter>
}
else if (All.Count == 0)
{
    <Chapter Field="plum">
        <SectionHeading Title="The store is empty" />
        <div class="upcsg-empty">
            <p>
                Nothing is up for order right now. Drops get announced on our socials first, and
                they'll show up here as soon as the window opens.
            </p>
        </div>
    </Chapter>
}
else
{
    <div id="items">
        @foreach (var (item, i) in All.Select((m, i) => (m, i)))
        {
            <MerchChapter Item="item" Field="@Fields[i % Fields.Length]" />
        }
    </div>
}

<Chapter Field="paper">
    <SectionHeading Title="How ordering works" Kicker="From cart to claim" />

    <div class="upcsg-steps">
        <Reveal Variant="Reveal.RevealMotion.Up" Delay="0" Class="upcsg-step">
            <h3 class="upcsg-step__title">Choose and add to cart</h3>
            <p class="upcsg-step__text">
                Open an item, pick your size or variant, and add it. You'll sign in with your UP
                account so officers know whose order it is.
            </p>
        </Reveal>
        <Reveal Variant="Reveal.RevealMotion.Up" Delay="90" Class="upcsg-step">
            <h3 class="upcsg-step__title">Check out and pay</h3>
            <p class="upcsg-step__text">
                Place the order, then pay by GCash and send the reference, or choose cash and pay
                an officer in person.
            </p>
        </Reveal>
        <Reveal Variant="Reveal.RevealMotion.Up" Delay="180" Class="upcsg-step">
            <h3 class="upcsg-step__title">Claim it on release day</h3>
            <p class="upcsg-step__text">
                An officer confirms your payment. Follow the order under My orders and pick it up
                on the announced release date.
            </p>
        </Reveal>
    </div>
</Chapter>

<Chapter Field="night" Class="upcsg-close">
    <h2 class="upcsg-close__title">
        <span>Wrong size?</span>
        <span>We'll fix it.</span>
    </h2>
    <div class="upcsg-close__foot">
        <p>
            A payment that didn't go through, or a question about a drop: message the guild and an
            officer will pick it up.
        </p>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="contact">Message the guild</MudButton>
    </div>
</Chapter>

@code {
    private MerchItemDto? _featured;
    private List<MerchItemDto> _catalog = [];

    private static readonly string[] Fields = ["plum", "gold", "peri", "ultra"];

    private List<MerchItemDto> All => _featured is null ? _catalog : [_featured, .. _catalog];
    private bool _loading = true;


    protected override async Task OnInitializedAsync()
    {
        var merch = await MerchService.GetMerchAsync();

        _featured = merch.FirstOrDefault(m => m.InStock) ?? merch.FirstOrDefault();
        _catalog = [.. merch.Where(m => m.Id != _featured?.Id)];

        _loading = false;
    }
}
