@page "/events"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IEventService EventService
@inject IJSRuntime JS

<PageTitle>Events - UPCSG</PageTitle>

<PageMasthead Section="Events"
              Field="gold"
              Meta="@([_loading ? null : (_events.Count == 0 ? "Nothing dated yet" : $"{_events.Count} scheduled"), _comingSoon.Count > 0 ? $"{_comingSoon.Count} coming soon" : null])"
              Title="@($"What's on in {_month:MMMM}")">
    <Lede>
        Every event the guild has dated for @_month.ToString("MMMM yyyy"). Later months are still
        being planned, so they only go up once they're certain.
    </Lede>
    <Actions>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="events#calendar">See the whole month</MudButton>
    </Actions>
    <ChildContent>
        @if (_next is not null)
        {
            <div class="upcsg-mast__body">
                <h2 class="upcsg-visually-hidden">@FeatureTitle</h2>
                <Reveal Variant="Reveal.RevealMotion.Up">
                    <EventCard Event="_next" Variant="EventCard.Density.Feature" ShowStatus="true" />
                </Reveal>
            </div>
        }
    </ChildContent>
</PageMasthead>

<Chapter Field="night" Id="calendar">
    @if (_loading)
    {
        <div class="upcsg-menu upcsg-menu--single">
            @for (var i = 0; i < 4; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" Class="upcsg-skeleton" />
            }
        </div>
    }
    else if (_events.Count == 0)
    {
        <SectionHeading Title="Nothing dated yet" />
        <div class="upcsg-empty">
            <p>
                @_month.ToString("MMMM")'s lineup hasn't been posted.
                @(_comingSoon.Count > 0
                    ? "What the ExeCom has announced without a date yet is below."
                    : "Our socials get it first, so follow along there and it'll show up here once it's official.")
            </p>
            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button" Href="contact">Ask the ExeCom</MudButton>
        </div>
    }
    else
    {
        <SectionHeading Title="@(_selectedDate is null ? $"All of {_month:MMMM}" : _selectedDate.Value.ToString("dddd, MMMM d"))"
                        Kicker="@ListKicker">
            <Action>
                @if (_selectedDate is not null)
                {
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button" OnClick="ClearSelection">
                        Show all @_events.Count
                    </MudButton>
                }
            </Action>
        </SectionHeading>

        <div class="upcsg-eventslayout">
            <aside class="upcsg-eventslayout__rail" aria-label="@($"{_month:MMMM} at a glance")">
                <div class="upcsg-calcard__head">
                    <h3 class="upcsg-calcard__title">@_month.ToString("MMMM") at a glance</h3>
                </div>

                <div class="upcsg-cal__grid" role="grid" aria-label="@_month.ToString("MMMM yyyy") events">
                    @foreach (var dow in DayNames)
                    {
                        <div class="upcsg-cal__dow" role="columnheader">@dow[..2]</div>
                    }

                    @for (var blank = 0; blank < LeadingBlanks; blank++)
                    {
                        <div class="upcsg-cal__cell--empty"></div>
                    }

                    @for (var day = 1; day <= DaysInMonth; day++)
                    {
                        var d = day;
                        var date = new DateTime(_month.Year, _month.Month, d);
                        var dayEvents = EventsOn(date);
                        var isToday = date.Date == DateTime.Today;
                        var isSelected = _selectedDate?.Date == date.Date;
                        var isPast = date.Date < DateTime.Today;

                        if (dayEvents.Count == 0)
                        {
                            <div class="upcsg-cal__day @(isToday ? "upcsg-cal__day--today" : null)">@d</div>
                        }
                        else
                        {
                            <button type="button"
                                    class="upcsg-cal__day upcsg-cal__day--has-events @(isToday ? "upcsg-cal__day--today" : null) @(isSelected ? "upcsg-cal__day--selected" : null) @(isPast ? "upcsg-cal__day--past" : null)"
                                    aria-label="@($"{date:MMMM d}, {dayEvents.Count} event{(dayEvents.Count == 1 ? "" : "s")}")"
                                    @onclick="() => SelectDayAsync(date)">
                                @d
                            </button>
                        }
                    }
                </div>

                <div class="upcsg-cal__legend">
                    <span><i></i> Has events</span>
                    <span><i class="is-today"></i> Today</span>
                </div>
            </aside>

            <div class="upcsg-eventslayout__list">
                <div class="upcsg-menu upcsg-menu--single">
                    @foreach (var (evt, i) in Listed.Select((e, i) => (e, i)))
                    {
                        <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 60)">
                            <EventRow Event="evt"
                                      Id="@($"event-{evt.Id}")"
                                      Hit="@(_selectedDate?.Date == EventTiming.Starts(evt)?.Date)" />
                        </Reveal>
                    }
                </div>

                @if (Listed.Count == 0)
                {
                    <div class="upcsg-empty">
                        <p>Nothing on @_selectedDate?.ToString("MMMM d").</p>
                    </div>
                }
            </div>
        </div>
    }
</Chapter>

@if (!_loading && _comingSoon.Count > 0)
{
    <Chapter Field="peri">
        <SectionHeading Title="Coming soon"
                        Kicker="@($"{_comingSoon.Count} in the works, no date yet")" />

        <div class="upcsg-menu">
            @foreach (var (evt, i) in _comingSoon.Select((e, i) => (e, i)))
            {
                <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 60)">
                    <EventRow Event="evt" ShowStatus="false" />
                </Reveal>
            }
        </div>
    </Chapter>
}

@code {
    private static readonly string[] DayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];


    private DateTime _month = DateTime.Today;

    private bool _loading = true;
    private List<EventDto> _events = [];
    private List<EventDto> _comingSoon = [];
    private EventDto? _next;
    private DateTime? _selectedDate;

    private DateTime FirstOfMonth => new(_month.Year, _month.Month, 1);
    private int DaysInMonth => DateTime.DaysInMonth(_month.Year, _month.Month);

    private int LeadingBlanks => (int)FirstOfMonth.DayOfWeek;

    private List<EventDto> Listed => _selectedDate is null
        ? _events
        : EventsOn(_selectedDate.Value);

    private string ListKicker => _selectedDate is not null
        ? _selectedDate.Value.ToString("dddd, MMMM d")
        : $"{_events.Count} event{(_events.Count == 1 ? "" : "s")} this month";

    private string ListTitle => _selectedDate is not null ? "That day" : "Everything on";

    private string FeatureKicker =>
        _next is null ? string.Empty
        : EventTiming.IsUnderway(_next) ? "On right now"
        : EventTiming.HasEnded(_next) ? "That was the month"
        : "Next up";

    private string FeatureTitle =>
        _next is null ? string.Empty
        : EventTiming.IsUnderway(_next) ? "Happening today"
        : EventTiming.HasEnded(_next) ? "How it wrapped up"
        : "The one to catch";

    protected override async Task OnInitializedAsync()
    {
        var (year, month) = await EventService.GetDisplayMonthAsync();
        _month = new DateTime(year, month, 1);

        _events = (await EventService.GetThisMonthEventsAsync())
            .OrderBy(e => e.StartDateTime)
            .ToList();

        // Not month-scoped: these have no confirmed date, so they belong to no month and
        // stay visible whichever one is on display.
        _comingSoon = await EventService.GetComingSoonEventsAsync();

        _next = _events.FirstOrDefault(e => !EventTiming.HasEnded(e)) ?? _events.LastOrDefault();

        _loading = false;
    }

    private List<EventDto> EventsOn(DateTime date) =>
        [.. _events.Where(e => EventTiming.Starts(e)?.Date == date.Date)];

    private void ClearSelection() => _selectedDate = null;

    private async Task SelectDayAsync(DateTime date)
    {
        var ids = EventsOn(date).Select(e => e.Id).ToList();
        if (ids.Count == 0)
        {
            return;
        }

        _selectedDate = date;

        StateHasChanged();
        await Task.Yield();

        await JS.InvokeVoidAsync("upcsgScrollToId", $"event-{ids[0]}");
    }
}
