@using UpcsgWeb.Shared.Contracts

<MudDialog>
    <DialogContent>
        <MudSelect T="MemberCategory" @bind-Value="Item.Category" Label="Category" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem T="MemberCategory" Value="MemberCategory.ExeCom">Executive Committee</MudSelectItem>
            <MudSelectItem T="MemberCategory" Value="MemberCategory.Faculty">Faculty</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="Item.Name" Label="Full name" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="Item.Role" Label="Position" HelperText="e.g. President, Committee Head" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="Item.Committee" Label="Committee" HelperText="Groups them on the About page" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="Item.Quote" Label="Personal quote" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="Item.Bio" Label="What they do" Variant="Variant.Outlined" Lines="4" Class="mb-3" />
        <MudTextField @bind-Value="Item.PhotoUrl" Label="Photo URL" HelperText="Shoot portraits at a 3:4 crop for an even grid" Variant="Variant.Outlined" Class="mb-3" />
        <MudNumericField @bind-Value="Item.DisplayOrder" Label="Display order" Variant="Variant.Outlined" Min="0" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   Disabled="string.IsNullOrWhiteSpace(Item.Name) || string.IsNullOrWhiteSpace(Item.Role)"
                   OnClick="Save">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public MemberDto Item { get; set; } = default!;

    private void Save() => MudDialog.Close(DialogResult.Ok(Item));

    private void Cancel() => MudDialog.Cancel();
}
