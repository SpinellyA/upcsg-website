@using UpcsgWeb.Shared.Contracts

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Item.Title" Label="Title" Variant="Variant.Outlined" Required="true" Class="mb-3" />
        <MudTextField @bind-Value="Item.Description" Label="Description" Variant="Variant.Outlined" Lines="3" Class="mb-3" />
        <MudNumericField @bind-Value="Item.Year" Label="Year" Variant="Variant.Outlined" Min="1900" Max="@(DateTime.Now.Year + 1)" Class="mb-3" />

        @* Free text, but suggestions keep categories consistent — the public page
           derives its filter chips from whatever is stored here. *@
        <MudAutocomplete T="string" @bind-Value="Item.Category"
                         Label="Category"
                         Variant="Variant.Outlined"
                         CoerceValue="true"
                         SearchFunc="SearchCategories"
                         Class="mb-3" />

        <MudTextField @bind-Value="Item.ImageUrl" Label="Image URL" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   Disabled="string.IsNullOrWhiteSpace(Item.Title)" OnClick="Save">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public AchievementDto Item { get; set; } = default!;

    private static readonly string[] Suggested =
        ["Competition", "Recognition", "Community", "Milestone"];

    private Task<IEnumerable<string>> SearchCategories(string? value, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? Suggested.AsEnumerable()
            : Suggested.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase)));

    private void Save() => MudDialog.Close(DialogResult.Ok(Item));

    private void Cancel() => MudDialog.Cancel();
}
