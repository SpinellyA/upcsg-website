@using UpcsgWeb.Shared.Contracts

<MudTimeline TimelinePosition="TimelinePosition.Start"
             TimelineOrientation="TimelineOrientation.Vertical"
             Class="upcsg-chain">
    @if (Order.Status == OrderStatusDto.Cancelled)
    {
        <MudTimelineItem Color="Color.Success" Size="Size.Small" Elevation="0"
                         Icon="@Icons.Material.Filled.Check">
            <MudText Typo="Typo.body2" Class="upcsg-chain__label">Placed</MudText>
            <MudText Typo="Typo.caption" Class="upcsg-chain__time">
                @Order.PlacedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
            </MudText>
        </MudTimelineItem>
        <MudTimelineItem Color="Color.Error" Size="Size.Small" Elevation="0"
                         Icon="@Icons.Material.Filled.Close">
            <MudText Typo="Typo.body2" Class="upcsg-chain__label">Cancelled</MudText>
            <MudText Typo="Typo.caption" Class="upcsg-chain__time">
                @Order.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
            </MudText>
            @if (!string.IsNullOrWhiteSpace(Order.CancellationReason))
            {
                <MudText Typo="Typo.caption" Class="upcsg-chain__note">@Order.CancellationReason</MudText>
            }
        </MudTimelineItem>
    }
    else
    {
        @for (var i = 0; i < Steps.Length; i++)
        {
            var step = Steps[i];
            var reached = i <= CurrentIndex;
            var current = i == CurrentIndex;

            <MudTimelineItem Size="Size.Small" Elevation="0"
                             Color="@(reached ? Color.Success : Color.Default)"
                             Variant="@(reached ? Variant.Filled : Variant.Outlined)"
                             Icon="@(reached ? Icons.Material.Filled.Check : null)"
                             Class="@(reached ? (current ? "upcsg-chain__step--current" : null) : "upcsg-chain__step--future")">
                <MudText Typo="Typo.body2" Class="upcsg-chain__label">@StepLabel(step)</MudText>
                @if (TimeFor(step) is { } when)
                {
                    <MudText Typo="Typo.caption" Class="upcsg-chain__time">
                        @when.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                    </MudText>
                }
            </MudTimelineItem>
        }
    }
</MudTimeline>

@code {
    [Parameter, EditorRequired] public OrderDto Order { get; set; } = default!;

    private static readonly OrderStatusDto[] Steps =
    [
        OrderStatusDto.AwaitingPayment,
        OrderStatusDto.Pending,
        OrderStatusDto.Acknowledged,
        OrderStatusDto.Released,
        OrderStatusDto.Received,
    ];

    private int CurrentIndex => Array.IndexOf(Steps, Order.Status);

    private static string StepLabel(OrderStatusDto status) => status switch
    {
        OrderStatusDto.AwaitingPayment => "Placed, awaiting payment",
        OrderStatusDto.Pending => "Receipt submitted",
        OrderStatusDto.Acknowledged => "Payment confirmed",
        OrderStatusDto.Released => "Released to guilder",
        OrderStatusDto.Received => "Received",
        _ => OrderStatusDisplay.Label(status),
    };

    private DateTimeOffset? TimeFor(OrderStatusDto step) => step switch
    {
        OrderStatusDto.AwaitingPayment => Order.PlacedAt,
        OrderStatusDto.Pending => Order.Receipt?.SubmittedAt,

        _ when step == Order.Status => Order.UpdatedAt,
        _ => null,
    };
}
