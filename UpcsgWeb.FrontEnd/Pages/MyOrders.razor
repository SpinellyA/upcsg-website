@page "/orders"
@attribute [Authorize]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IOrderService OrderService
@inject NavigationManager Navigation

<PageTitle>My Orders - UPCSG</PageTitle>

<section class="upcsg-banner">
    <img class="upcsg-banner__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
    <div class="upcsg-banner__inner">
        <p class="upcsg-eyebrow"><span class="upcsg-star"></span> Guild store</p>
        <h1 class="upcsg-banner__title">My Orders</h1>
        <p class="upcsg-lede" style="margin-bottom: 0;">
            Everything you've ordered, and where each one stands.
        </p>
    </div>
</section>

<div class="upcsg-page upcsg-page--after-hero">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_orders.Count == 0)
    {
        <section class="upcsg-section upcsg-band upcsg-cta-band">
            <p class="upcsg-kicker">Nothing yet</p>
            <h2 class="upcsg-title-xl">No orders</h2>
            <p class="upcsg-lede">Once you order merch it'll show up here.</p>
            <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8" Href="merch">
                Shop Merch
            </MudButton>
        </section>
    }
    else
    {
        @* Same record sheet the officers use, minus the columns only they care about. *@
        <MudTable Items="_orders"
                  T="OrderDto"
                  Hover="true"
                  Elevation="0"
                  Dense="true"
                  Class="upcsg-datatable"
                  OnRowClick="OpenOrder"
                  RowClass="upcsg-datatable__row">
            <HeaderContent>
                <MudTh>Order</MudTh>
                <MudTh>Placed</MudTh>
                <MudTh Class="upcsg-num">Items</MudTh>
                <MudTh Class="upcsg-num">Total</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order"><strong>#@context.Id</strong></MudTd>
                <MudTd DataLabel="Placed">@context.PlacedAt.ToLocalTime().ToString("MMM d, h:mm tt")</MudTd>
                <MudTd DataLabel="Items" Class="upcsg-num">@context.Lines.Sum(l => l.Quantity)</MudTd>
                <MudTd DataLabel="Total" Class="upcsg-num">&#8369;@context.Total.ToString("N2")</MudTd>
                <MudTd DataLabel="Status">
                    <span class="upcsg-statuspill upcsg-statuspill--@OrderStatusDisplay.Slug(context.Status)">
                        @OrderStatusDisplay.Label(context.Status)
                    </span>

                    @* The one status where the guilder, not an officer, is holding things up. *@
                    @if (context.Status == OrderStatusDto.AwaitingPayment)
                    {
                        <span class="upcsg-datatable__flag">receipt needed</span>
                    }
                    else if (context.HasRefundDue)
                    {
                        <span class="upcsg-datatable__flag">
                            &#8369;@context.RefundDue.ToString("N2") coming back
                        </span>
                    }
                </MudTd>
                <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    private List<OrderDto> _orders = [];
    private bool _loading = true;
    private string? _error;

    private void OpenOrder(TableRowClickEventArgs<OrderDto> args)
    {
        if (args.Item is not null)
        {
            Navigation.NavigateTo($"orders/{args.Item.Id}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _orders = await OrderService.GetMineAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

}
