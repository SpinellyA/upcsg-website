@page "/about"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IMemberService MemberService

<PageTitle>About - UPCSG</PageTitle>

<section class="upcsg-banner">
    <img class="upcsg-banner__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
    <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 30%; right: 34%;"><span class="upcsg-star" style="width: 1rem; height: 1rem;"></span></span>
    <span class="upcsg-sparkle upcsg-sparkle--lilac upcsg-sparkle--delay-2" style="bottom: 30%; right: 44%;"><span class="upcsg-star" style="width: 0.65rem; height: 0.65rem;"></span></span>

    <div class="upcsg-banner__inner">
        <p class="upcsg-eyebrow"><span class="upcsg-star"></span> About</p>
        <h1 class="upcsg-banner__title">The Guild</h1>
        <p class="upcsg-lede" style="margin-bottom: 0;">
            The official student organization for Computer Science majors at the
            University of the Philippines Cebu.
        </p>
    </div>
</section>

<Marquee Items="@Ticker" DurationSeconds="52" Class="upcsg-marquee--hero" />

<div class="upcsg-page upcsg-page--after-hero">

    <section class="upcsg-section upcsg-feature">
        <Reveal Variant="Reveal.RevealMotion.Left" Class="upcsg-feature__visual">
            <div class="upcsg-quoteplate">
                <span class="upcsg-quoteplate__mark" aria-hidden="true">&ldquo;</span>
                <blockquote class="upcsg-quoteplate__text">
                    Computer science is not just an industry of machines, but a canvas of
                    endless creative expression.
                </blockquote>
                <img class="upcsg-quoteplate__burst" src="img/starburst.png" alt="" aria-hidden="true" />
            </div>
        </Reveal>

        <Reveal Variant="Reveal.RevealMotion.Right" Class="upcsg-feature__body" Delay="120">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Our identity</p>
            <h2 class="upcsg-title-xl">Built and run by students</h2>
            <p class="upcsg-lede">
                UPCSG exists to support guilders through their degree and beyond &mdash; academic
                support, competitions, industry nights, and the socials that hold it all together.
            </p>
            <p class="upcsg-lede">
                This academic year we're building on our minimalist visual identity rather than
                replacing it, expanding our tech-futuristic edge toward the intersection of
                technology and artistry. Our theme takes its cue from Van Gogh's
                <em>Starry Night</em> &mdash; layered over a clean, functional structure, its high
                contrast stands for the truth that engineering solutions is its own form of
                modern art.
            </p>
        </Reveal>
    </section>

    @if (_execCount > 0)
    {
        <section class="upcsg-section upcsg-band">
            <Reveal Variant="Reveal.RevealMotion.Up">
                <div class="upcsg-statrow upcsg-statrow--spread">
                    <StatCounter Value="_execCount" Label="Officers serving" />
                    <StatCounter Value="_committees.Count" Label="Committees" />

                    @if (_facultyCount > 0)
                    {
                        <StatCounter Value="_facultyCount" Label="Faculty advisers" />
                    }
                </div>
            </Reveal>
        </section>
    }

    @if (_faculty.Count > 0)
    {
        <section class="upcsg-section">
            <SectionHeading Kicker="Your guiding light" Title="Faculty" />

            <div class="upcsg-memberpile">
                @foreach (var (member, i) in _faculty.Select((m, i) => (m, i)))
                {
                    <Reveal Variant="Reveal.RevealMotion.Scale" Delay="@(i * 70)">
                        <MemberCard Member="member" Roster="_faculty" />
                    </Reveal>
                }
            </div>
        </section>
    }

    <section class="upcsg-section">
        <SectionHeading Kicker="Know your officers"
                        Title="Executive Committee"
                        Lede="Elected guilders who represent the membership, run the committees, and keep the guild's programs moving. Open anyone's card for their full profile." />

        @if (_loading)
        {
            <div class="upcsg-memberpile">
                @for (var i = 0; i < 6; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Class="upcsg-skeleton" />
                }
            </div>
        }
        else if (_committees.Count == 0)
        {
            <Reveal Variant="Reveal.RevealMotion.Fade">
                <div class="upcsg-empty">
                    <img src="img/upcsg-crest.png" alt="" aria-hidden="true" />
                    <p>This year's officers haven't been published yet.</p>
                </div>
            </Reveal>
        }
        else
        {
            @foreach (var committee in _committees)
            {
                <Reveal Variant="Reveal.RevealMotion.Fade" Class="upcsg-committee-rule">
                    <span>@committee.Name</span>
                    <span class="upcsg-committee-rule__count">@committee.Count</span>
                </Reveal>

                <div class="upcsg-membershowcase">
                    @foreach (var row in committee.Rows)
                    {
                        <Reveal Variant="@(row.Flip ? Reveal.RevealMotion.Right : Reveal.RevealMotion.Left)">
                            <MemberCard Member="row.Member"
                                        Variant="@(row.IsLead ? MemberCard.Density.Spotlight : MemberCard.Density.Showcase)"
                                        Flip="row.Flip"
                                        Roster="_allOfficers" />
                        </Reveal>
                    }
                </div>
            }
        }
    </section>

    <section class="upcsg-section upcsg-closing">
        <div class="upcsg-flare upcsg-closing__flare"></div>

        <Reveal Variant="Reveal.RevealMotion.Up" Class="upcsg-closing__inner">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Fancy a hand in it?</p>
            <h2 class="upcsg-title-xl">Run something with us</h2>
            <p class="upcsg-lede">
                Every Computer Science student here is already a guilder. The committees above are
                where the work actually happens, and they take on people through the year &mdash;
                tell us what you'd like to help with.
            </p>
            <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8" Href="contact">
                Get in Touch
            </MudButton>
        </Reveal>
    </section>

</div>

@code {
    private sealed record ProfileRow(MemberDto Member, bool Flip, bool IsLead);

    private sealed record CommitteeGroup(string Name, List<ProfileRow> Rows)
    {
        public int Count => Rows.Count;
    }

    private List<MemberDto> _faculty = [];
    private List<MemberDto> _allOfficers = [];
    private List<CommitteeGroup> _committees = [];
    private int _execCount;
    private int _facultyCount;
    private bool _loading = true;

    private static readonly string[] Ticker =
    [
        "Academic support", "Competitions", "Industry nights", "Committees",
        "Socials", "Mentoring", "UP Cebu", "Computer Science",
    ];

    protected override async Task OnInitializedAsync()
    {
        var members = await MemberService.GetMembersAsync();

        _faculty = [.. members
            .Where(m => m.Category == MemberCategory.Faculty)
            .OrderBy(m => m.DisplayOrder)];

        _facultyCount = _faculty.Count;

        var exeCom = members
            .Where(m => m.Category == MemberCategory.ExeCom)
            .OrderBy(m => m.DisplayOrder)
            .ToList();

        _execCount = exeCom.Count;
        _allOfficers = exeCom;

        var groups = exeCom
            .GroupBy(m => string.IsNullOrWhiteSpace(m.Committee) ? "Other" : m.Committee)
            .ToList();

        _committees = [];

        var flip = false;
        var first = true;

        foreach (var group in groups)
        {
            var rows = new List<ProfileRow>();

            foreach (var member in group)
            {
                rows.Add(new ProfileRow(member, flip, IsLead: first));
                flip = !flip;
                first = false;
            }

            _committees.Add(new CommitteeGroup(group.Key, rows));
        }

        _loading = false;
    }
}
