@inherits LayoutComponentBase
@using UpcsgWeb.Shared.Contracts
@inject UpcsgAuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject UpcsgWeb.FrontEnd.Services.MotionInterop Motion

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="upcsg-appbar">
        <a href="" class="upcsg-brand" aria-label="UPCSG home">
            <img class="upcsg-brand__mark" src="img/upcsg-crest.png" alt="" />
            <span class="upcsg-brand__text">UPCSG</span>
        </a>

        <MudSpacer />

        <nav class="upcsg-desktop-nav" aria-label="Site">
            @foreach (var (href, label) in NavMenu.Links.Skip(1))
            {
                <NavLink class="upcsg-navlink" href="@href"
                         Match="@(href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">@label</NavLink>
            }

            <span class="upcsg-nav-divider" aria-hidden="true"></span>

            <AuthorizeView>
                <Authorized>
                    <AuthorizeView Policy="ExeCom" Context="admin">
                        <NavLink class="upcsg-navlink" href="admin">CMS</NavLink>
                    </AuthorizeView>

                    <MudIconButton Icon="@Icons.Material.Outlined.ShoppingBag"
                                   Class="upcsg-carticon"
                                   aria-label="Your cart"
                                   Href="cart" />

                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             PopoverClass="upcsg-usermenu"
                             ListClass="pa-0"
                             AriaLabel="Your account"
                             Class="ml-1">

                        <ActivatorContent Context="menu">
                            <MudAvatar Class="upcsg-useravatar" Size="Size.Medium"
                                       @onclick="@menu.ToggleAsync">
                                @Initials(context.User.Identity?.Name)
                            </MudAvatar>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="upcsg-usermenu__head">
                                <MudAvatar Class="upcsg-useravatar" Size="Size.Medium">
                                    @Initials(context.User.Identity?.Name)
                                </MudAvatar>
                                <div>
                                    <span class="upcsg-usermenu__name">@context.User.Identity?.Name</span>
                                    <span class="upcsg-usermenu__role">
                                        @(context.User.IsInRole(UpcsgRoles.Admin) ? "Officer" : "Guilder")
                                    </span>
                                </div>
                            </div>

                            <MudDivider />

                            <MudMenuItem Href="orders" Icon="@Icons.Material.Outlined.Receipt">My orders</MudMenuItem>
                            <MudMenuItem Href="cart" Icon="@Icons.Material.Outlined.ShoppingBag">Cart</MudMenuItem>

                            <MudDivider />

                            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SignOutAsync">
                                Sign out
                            </MudMenuItem>
                        </ChildContent>
                    </MudMenu>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="upcsg-navlink upcsg-navlink--signin" href="login">Sign in</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       aria-label="Open menu"
                       OnClick="@DrawerToggle"
                       Class="upcsg-mobile-toggle" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Anchor="Anchor.End"
               Variant="DrawerVariant.Temporary"
               Elevation="0"
               Width="min(86vw, 340px)"
               Class="upcsg-drawer">
        <div class="upcsg-drawer__head">
            <a href="" class="upcsg-brand" @onclick="CloseDrawer">
                <img class="upcsg-brand__mark" src="img/upcsg-crest.png" alt="" />
                <span class="upcsg-brand__text">UPCSG</span>
            </a>
            <MudIconButton Icon="@Icons.Material.Rounded.Close"
                           Color="Color.Inherit"
                           aria-label="Close menu"
                           OnClick="CloseDrawer" />
        </div>

        <NavMenu OnNavigate="CloseDrawer" />

        <div class="upcsg-drawer__account">
            <AuthorizeView>
                <Authorized>
                    <p class="upcsg-drawer__who">Signed in as @context.User.Identity?.Name</p>
                    <a class="upcsg-drawer__small" href="cart" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Outlined.ShoppingBag" Size="Size.Small" /> Cart
                    </a>
                    <a class="upcsg-drawer__small" href="orders" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Outlined.Receipt" Size="Size.Small" /> My orders
                    </a>

                    <AuthorizeView Policy="ExeCom" Context="admin">
                        <a class="upcsg-drawer__small" href="admin" @onclick="CloseDrawer">
                            <MudIcon Icon="@Icons.Material.Outlined.Dashboard" Size="Size.Small" /> CMS
                        </a>
                    </AuthorizeView>

                    <button type="button" class="upcsg-drawer__small" @onclick="SignOutAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" /> Sign out
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a class="upcsg-drawer__small" href="login" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Outlined.Login" Size="Size.Small" /> Sign in
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </MudDrawer>

    <MudMainContent Class="upcsg-main">
        @Body

        <footer class="upcsg-footer upcsg-field--night @(IsWorkScreen ? "upcsg-footer--work" : null)">
            <div class="upcsg-wrap">
                @if (!IsWorkScreen)
                {
                    <div class="upcsg-footer__banner">
                        <img src="img/upcsg-crest.png" alt="" width="72" height="88" />
                        <div>
                            <p class="upcsg-footer__uni">University of the Philippines Cebu</p>
                            <p class="upcsg-footer__name">Computer Science Guild</p>
                            <p class="upcsg-footer__year">a.y. 2026&ndash;2027</p>
                        </div>
                    </div>
                }

                <div class="upcsg-footer__cols">
                    <div class="upcsg-footer__col upcsg-footer__col--wide">
                        <h2>UP Computer Science Guild</h2>
                        <p>
                            The student organization for Computer Science majors at the
                            University of the Philippines Cebu, Lahug, Cebu City.
                        </p>
                    </div>

                    <div class="upcsg-footer__col">
                        <h2>The guild</h2>
                        <ul>
                            <li><a href="about">About</a></li>
                            <li><a href="events">Events</a></li>
                            <li><a href="opportunities">Opportunities</a></li>
                            <li><a href="hall-of-fame">Hall of Fame</a></li>
                        </ul>
                    </div>

                    <div class="upcsg-footer__col">
                        <h2>Store</h2>
                        <ul>
                            <li><a href="merch">Merch</a></li>
                            <li><a href="cart">Cart</a></li>
                            <li><a href="orders">My orders</a></li>
                        </ul>
                    </div>

                    <div class="upcsg-footer__col upcsg-footer__col--end">
                        <h2>Reach us</h2>
                        <div class="upcsg-footer__contact">
                            <a href="mailto:upcsg.upcebu@gmail.com">upcsg.upcebu@gmail.com</a>
                            <a href="https://facebook.com/upcsg" target="_blank" rel="noopener">facebook.com/upcsg</a>
                            <a href="https://instagram.com/upcsg" target="_blank" rel="noopener">instagram.com/upcsg</a>
                        </div>
                    </div>
                </div>

                <div class="upcsg-footer__base">
                    <span>&copy; @DateTime.Now.Year UP Computer Science Guild</span>
                    <a class="upcsg-madeby"
                       href="https://spinelly.net"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Site by spinelly (opens spinelly.net in a new tab)">
                        <SpinellyMark />
                    </a>
                    <a class="upcsg-footer__top" href="contact">Get in touch</a>
                </div>
            </div>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private MudTheme? _theme;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += (_, _) => InvokeAsync(StateHasChanged);

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties { DefaultBorderRadius = "12px" },
            Typography = new Typography
            {
                Default = new DefaultTypography { FontFamily = ["Inter", "Helvetica Now", "sans-serif"] },
                H1 = new H1Typography { FontFamily = ["Aileron", "Inter", "sans-serif"] },
                H2 = new H2Typography { FontFamily = ["Aileron", "Inter", "sans-serif"] },
                H3 = new H3Typography { FontFamily = ["Aileron", "Inter", "sans-serif"] },
                H4 = new H4Typography { FontFamily = ["Inter", "Helvetica Now", "sans-serif"] },
                H5 = new H5Typography { FontFamily = ["Inter", "Helvetica Now", "sans-serif"] },
                H6 = new H6Typography { FontFamily = ["Inter", "Helvetica Now", "sans-serif"] },
                Subtitle1 = new Subtitle1Typography { FontFamily = ["Inter", "Helvetica Now", "sans-serif"] },
                Subtitle2 = new Subtitle2Typography { FontFamily = ["Inter", "Helvetica Now", "sans-serif"] },
                Button = new ButtonTypography { FontFamily = ["Inter", "Helvetica Now", "sans-serif"], TextTransform = "none", FontWeight = "600" },
            }
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Motion.TrackChaptersAsync(".upcsg-appbar");
        }
    }

    private bool IsWorkScreen
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            return path.StartsWith("admin") || path.StartsWith("cart") || path.StartsWith("orders");
        }
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    private async Task SignOutAsync()
    {
        await AuthState.SignOutAsync();
        _drawerOpen = false;
        Navigation.NavigateTo("", replace: true);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Black = "#16113A",
        White = "#F6FFE9",
        Primary = "#A253B8",
        Secondary = "#F6C875",
        Tertiary = "#E28D39",
        AppbarText = "#16113A",
        AppbarBackground = "rgba(246,255,233,0.9)",
        DrawerBackground = "#FFFFFF",
        DrawerText = "#16113A",
        TextPrimary = "#16113A",
        TextSecondary = "#53257E",
        Background = "#F6FFE9",
        Surface = "#FFFFFF",
        GrayLight = "#e8e8e8",
        GrayLighter = "#f9f9f9",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#A253B8",
        PrimaryDarken = "#53257E",
        Secondary = "#F6C875",
        SecondaryDarken = "#E28D39",
        Tertiary = "#CCAEDE",
        Surface = "#1C1650",
        Background = "#16113A",
        BackgroundGray = "#191347",
        AppbarText = "#CAC5E5",
        AppbarBackground = "rgba(15,11,43,0.72)",
        DrawerBackground = "#0F0B2B",
        DrawerText = "#F6FFE9",
        DrawerIcon = "#CAC5E5",
        ActionDefault = "#CAC5E5",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#F6FFE9",
        TextSecondary = "#CAC5E5",
        TextDisabled = "#ffffff33",
        Info = "#CCAEDE",
        InfoContrastText = "#16113A",
        Success = "#7BD8A6",
        SuccessContrastText = "#16113A",
        Warning = "#F6C875",
        WarningContrastText = "#16113A",
        Error = "#FF6B7F",
        LinesDefault = "#3a3170",
        LinesInputs = "#4a3f85",
        TableLines = "#2e2763",
        Divider = "#2e2763",
        OverlayLight = "#1e1e2d80",
    };
}
