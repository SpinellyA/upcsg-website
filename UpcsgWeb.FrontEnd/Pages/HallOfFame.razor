@page "/hall-of-fame"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IAchievementService AchievementService

<PageTitle>Hall of Fame - UPCSG</PageTitle>

<PageMasthead Section="Hall of Fame"
              Field="gold"
              Meta="@([_loading ? null : $"{_all.Count} win{(_all.Count == 1 ? "" : "s")} on the record", "Each one verified by the ExeCom"])"
              Title="Wins on the record">
    <Lede>
        The awards and milestones UP Cebu's CS students have brought home, each one written up
        properly rather than just listed.
    </Lede>
    <Actions>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="contact">Tell us about a win</MudButton>
    </Actions>
    <ChildContent>
        @if (Lead is not null)
        {
            <div class="upcsg-mast__body">
                <h2 class="upcsg-visually-hidden">The latest win</h2>
                <Reveal Variant="Reveal.RevealMotion.Up">
                    <AchievementCard Entry="Lead" Variant="AchievementCard.Density.Lead" />
                </Reveal>
            </div>
        }
    </ChildContent>
</PageMasthead>

<Chapter Field="night">
    @if (_loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" Class="upcsg-skeleton" />
    }
    else if (_all.Count == 0)
    {
        <SectionHeading Title="The record is empty" />
        <div class="upcsg-empty">
            <p>
                Nothing has been verified for the record yet. If you brought something home for
                the guild, we'd rather hear about it than miss it.
            </p>
            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button" Href="contact">Tell us about a win</MudButton>
        </div>
    }
    else
    {
        <SectionHeading Title="The whole record"
                        Kicker="@(_activeCategory is null ? "All categories" : $"Showing {_activeCategory}")"
                        Lede="We only list wins the ExeCom can verify. Earlier years are being confirmed and added as we go." />

        @if (_categories.Count > 1)
        {
            <div class="upcsg-filterrow">
                <MudChipSet T="string"
                            SelectionMode="SelectionMode.SingleSelection"
                            SelectedValue="@(_activeCategory ?? AllFilter)"
                            SelectedValueChanged="SetCategory">
                    <MudChip T="string" Value="@AllFilter">All (@_all.Count)</MudChip>
                    @foreach (var category in _categories)
                    {
                        <MudChip T="string" Value="@category">@category (@_all.Count(a => a.Category == category))</MudChip>
                    }
                </MudChipSet>
            </div>
        }

        @if (Visible.Count == 0)
        {
            <div class="upcsg-empty">
                <p>Nothing else recorded under this category yet.</p>
            </div>
        }
        else
        {
            @foreach (var group in Visible.GroupBy(a => a.Year).OrderByDescending(g => g.Key))
            {
                <div class="upcsg-yeargroup">
                    <div class="upcsg-yearrule">
                        <h3 class="upcsg-yearrule__year">@group.Key</h3>
                        <span class="upcsg-yearrule__count">@group.Count() entr@(group.Count() == 1 ? "y" : "ies")</span>
                    </div>
                    <div class="upcsg-wins">
                        @foreach (var (entry, i) in group.OrderBy(a => a.Title).Select((a, i) => (a, i)))
                        {
                            <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 70)">
                                <AchievementCard Entry="entry" />
                            </Reveal>
                        }
                    </div>
                </div>
            }
        }
    }
</Chapter>

<Chapter Field="peri" Class="upcsg-close">
    <h2 class="upcsg-close__title">
        <span>Won it?</span>
        <span>Tell us.</span>
    </h2>
    <div class="upcsg-close__foot">
        <p>
            If you or a batchmate brought something home for the guild and it isn't here, send it
            our way and we'll add it to the record.
        </p>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="contact">Tell us about a win</MudButton>
    </div>
</Chapter>

@code {
    private const string AllFilter = "all";

    private List<AchievementDto> _all = [];
    private List<string> _categories = [];
    private string? _activeCategory;
    private bool _loading = true;

    private AchievementDto? Lead => _all
        .OrderByDescending(a => a.Year)
        .ThenByDescending(a => a.Id)
        .FirstOrDefault();

    private List<AchievementDto> Visible =>
        [.. (_activeCategory is null ? _all : _all.Where(a => a.Category == _activeCategory))
            .Where(a => a.Id != Lead?.Id)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _all = await AchievementService.GetAchievementsAsync();

            _categories = [.. _all
                .Select(a => a.Category)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Select(c => c!)
                .Distinct()
                .OrderBy(c => c)];
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetCategory(string? category) =>
        _activeCategory = category is null or AllFilter ? null : category;
}
