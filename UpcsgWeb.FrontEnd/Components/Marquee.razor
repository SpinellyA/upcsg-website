<div class="upcsg-marquee @Class" role="presentation">
    <div class="upcsg-marquee__track" style="--marquee-duration: @(DurationSeconds)s;">
        @for (var pass = 0; pass < 2; pass++)
        {
            <div class="upcsg-marquee__run" aria-hidden="@(pass == 1 ? "true" : null)">
                @foreach (var item in Items)
                {
                    <span class="upcsg-marquee__item">@item</span>
                    <span class="upcsg-star upcsg-star--tiny upcsg-marquee__sep" aria-hidden="true"></span>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Items { get; set; } = [];

    [Parameter] public int DurationSeconds { get; set; } = 40;

    [Parameter] public string? Class { get; set; }
}
