@page "/merch"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IMerchService MerchService

<PageTitle>Merch - UPCSG</PageTitle>

<section class="upcsg-banner">
    <img class="upcsg-banner__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
    <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 30%; right: 36%;"><span class="upcsg-star" style="width: 1rem; height: 1rem;"></span></span>

    <div class="upcsg-banner__inner">
        <p class="upcsg-eyebrow"><span class="upcsg-star"></span> Guild store</p>
        <h1 class="upcsg-banner__title">Merch</h1>
        @* This used to read "no checkout here, just message us". The site has had a cart,
           a checkout and a GCash receipt step for a while, and the navbar carries a cart
           icon — so the page was sending guilders to Facebook to buy something they could
           already order two clicks away. *@
        <p class="upcsg-lede" style="margin-bottom: 0;">
            Rep the guild. Pick your size, order online, and pay with GCash &mdash; officers
            confirm each order and tell you when to claim it.
        </p>
    </div>
</section>

<div class="upcsg-page upcsg-page--after-hero">

    @if (_loading)
    {
        <section class="upcsg-section">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="upcsg-skeleton mb-6" />
            <div class="upcsg-cardgrid upcsg-cardgrid--4">
                @for (var i = 0; i < 4; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="upcsg-skeleton" />
                }
            </div>
        </section>
    }
    else if (_featured is null)
    {
        <section class="upcsg-section">
            <Reveal Variant="Reveal.RevealMotion.Fade">
                <div class="upcsg-empty upcsg-empty--tall">
                    <img src="img/upcsg-crest.png" alt="" aria-hidden="true" />
                    <h2 class="upcsg-title-xl">The store is empty</h2>
                    <p>
                        Nothing is up for order right now. Drops get announced on our socials first,
                        and they'll show up here as soon as the window opens.
                    </p>
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="contact">
                        Get in touch
                    </MudButton>
                </div>
            </Reveal>
        </section>
    }
    else
    {
        @* ---------- Featured drop ---------- *@
        <section class="upcsg-section">
            <Reveal Variant="Reveal.RevealMotion.Scale">
                <MerchCard Item="_featured" Variant="MerchCard.Density.Feature" />
            </Reveal>
        </section>

        @* ---------- Catalog ---------- *@
        @if (_catalog.Count > 0)
        {
            <section class="upcsg-section">
                <SectionHeading Kicker="@($"{_catalog.Count} more item{(_catalog.Count == 1 ? "" : "s")}")"
                                Title="The full catalog" />

                <div class="upcsg-cardgrid upcsg-cardgrid--4 upcsg-recordgrid">
                    @foreach (var (item, i) in _catalog.Select((m, i) => (m, i)))
                    {
                        <Reveal Variant="Reveal.RevealMotion.Scale" Delay="@(i * 70)">
                            <MerchCard Item="item" />
                        </Reveal>
                    }
                </div>
            </section>
        }
    }

    @* ---------- How ordering works ----------
       Rewritten to describe the flow the app actually implements. The previous version
       walked guilders through DMing the org and paying the Treasurer in person, which is
       not what any of these buttons do. *@
    <section class="upcsg-section upcsg-band">
        <SectionHeading Kicker="From cart to claim" Title="How ordering works" />

        <div class="upcsg-steps">
            <div class="upcsg-step">
                <span class="upcsg-step__num upcsg-gradient-text">01</span>
                <h3 class="upcsg-step__title">Pick and add to cart</h3>
                <p class="upcsg-step__text">
                    Open an item, choose your size or variant, and add it. You'll need to be
                    signed in with your UP account so officers know whose order it is.
                </p>
            </div>
            <div class="upcsg-step">
                <span class="upcsg-step__num upcsg-gradient-text">02</span>
                <h3 class="upcsg-step__title">Check out and send proof</h3>
                <p class="upcsg-step__text">
                    Review your cart, place the order, then pay by GCash and upload the receipt.
                    Your order sits as awaiting payment until you do.
                </p>
            </div>
            <div class="upcsg-step">
                <span class="upcsg-step__num upcsg-gradient-text">03</span>
                <h3 class="upcsg-step__title">Officers confirm, then you claim</h3>
                <p class="upcsg-step__text">
                    An officer checks the receipt and confirms your order. You can follow its
                    status under My Orders, and claim it on the announced release date.
                </p>
            </div>
        </div>
    </section>

    @* ---------- Closing CTA ---------- *@
    <section class="upcsg-section upcsg-closing">
        <div class="upcsg-flare upcsg-closing__flare"></div>

        <Reveal Variant="Reveal.RevealMotion.Up" Class="upcsg-closing__inner">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Something not right?</p>
            <h2 class="upcsg-title-xl">We'll sort it out</h2>
            <p class="upcsg-lede">
                Wrong size, a payment that didn't go through, or a question about a drop &mdash;
                message the guild and an officer will pick it up.
            </p>
            <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8" Href="contact">
                Get in Touch
            </MudButton>
        </Reveal>
    </section>

</div>

@code {
    private MerchItemDto? _featured;
    private List<MerchItemDto> _catalog = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var merch = await MerchService.GetMerchAsync();

        // The flagship drop leads the page; everything else fills the catalog. Once the
        // CMS lands this is the spot to swap in an editor-controlled "featured" flag.
        _featured = merch.FirstOrDefault(m => m.InStock) ?? merch.FirstOrDefault();
        _catalog = [.. merch.Where(m => m.Id != _featured?.Id)];

        _loading = false;
    }
}
