@using UpcsgWeb.Shared.Contracts

@* One merch item as a tile.

   The home page used to draw a star glyph here regardless of what the item had, so the
   hoodie's three real photographs never appeared anywhere but its detail page. This shows
   the actual product and only falls back when there genuinely is nothing. *@

<a class="upcsg-merchcard" href="@($"merch/{Item.Id}")">
    <CosmicImage Src="@Photo"
                 Alt="@Item.Name"
                 Seed="@Item.Name"
                 Badge="@Flag"
                 Class="upcsg-merchcard__thumb" />

    <span class="upcsg-merchcard__body">
        <span class="upcsg-merchcard__name">@Item.Name</span>

        <span class="upcsg-merchcard__price">
            @if (Item.IsPreorder)
            {
                <span class="upcsg-merchcard__now">&#8369;@Item.PriceFrom.ToString("N2")</span>
            }
            else if (!Item.InStock)
            {
                <span class="upcsg-merchcard__gone">Sold out</span>
            }
            else
            {
                @if (Item.HasPriceRange)
                {
                    <span class="upcsg-merchcard__from">from</span>
                }

                <span class="upcsg-merchcard__now">&#8369;@Item.PriceFrom.ToString("N2")</span>

                @* Struck-through original only when a sale is actually running, so the
                   discount is never implied by a stale percentage. *@
                @if (Item.HasActiveSale)
                {
                    <span class="upcsg-merchcard__was">&#8369;@Item.ListPriceFrom.ToString("N2")</span>
                }
            }
        </span>
    </span>
</a>

@code {
    [Parameter, EditorRequired] public MerchItemDto Item { get; set; } = default!;

    /// <summary>
    /// First photo is the listing shot by convention; ImageUrl is the older single-photo
    /// field and still populated for some items.
    /// </summary>
    private string? Photo =>
        Item.PhotoUrls.FirstOrDefault(u => !string.IsNullOrWhiteSpace(u)) ?? Item.ImageUrl;

    private string? Flag =>
        Item.IsPreorder ? "Pre-order"
        : Item.HasActiveSale ? $"-{Item.SalePercentage:0.#}%"
        : !Item.InStock ? "Sold out"
        : null;
}
