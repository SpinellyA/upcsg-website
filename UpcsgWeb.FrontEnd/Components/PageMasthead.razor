<section class="upcsg-chapter upcsg-chapter--first upcsg-mast upcsg-field--@Field @Class" data-field="@Field">
    <div class="upcsg-chapter__inner">
        <div class="upcsg-mast__grid">
            <h1 class="upcsg-mast__title">
                <span class="upcsg-mast__line">@Title@if (!string.IsNullOrWhiteSpace(Accent)) { @(" " + Accent) }</span>
            </h1>

            <div class="upcsg-mast__aside">
                @if (Lede is not null)
                {
                    <p class="upcsg-mast__lede">@Lede</p>
                }

                @{ var facts = Meta.Where(m => !string.IsNullOrWhiteSpace(m)).ToList(); }
                @if (facts.Count > 0)
                {
                    <p class="upcsg-mast__facts">@string.Join(" · ", facts)</p>
                }

                @if (Actions is not null)
                {
                    <div class="upcsg-mast__actions">@Actions</div>
                }
            </div>
        </div>

        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string Section { get; set; } = string.Empty;

    [Parameter] public IEnumerable<string?> Meta { get; set; } = [];

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Accent { get; set; }

    [Parameter] public RenderFragment? Lede { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Horizon { get; set; }

    [Parameter] public string Field { get; set; } = "night";

    [Parameter] public string? Class { get; set; }
}
