@page "/hall-of-fame/{Id:guid}"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IAchievementService AchievementService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_entry?.Title ?? "Hall of Fame") - UPCSG</PageTitle>

@if (_loading)
{
    <Chapter Field="paper" Class="upcsg-chapter--first">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" Class="upcsg-skeleton" />
    </Chapter>
}
else if (_entry is null)
{
    <Chapter Field="gold" Class="upcsg-chapter--first">
        <div class="upcsg-lost">
            <h1 class="upcsg-lost__title">Entry not found</h1>
            <p>It may have been removed, or the link may be wrong.</p>
            <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="hall-of-fame">See the whole record</MudButton>
        </div>
    </Chapter>
}
else
{
    <article class="upcsg-article upcsg-field--paper" data-field="paper">
        <header class="upcsg-article__head">
            <div class="upcsg-wrap upcsg-article__headinner">
                <p class="upcsg-article__kind">
                    @(string.IsNullOrWhiteSpace(_entry.Category) ? "Win" : _entry.Category), @_entry.Year
                </p>
                <h1 class="upcsg-article__title">@_entry.Title</h1>
                @if (Standfirst.Length > 0)
                {
                    <p class="upcsg-article__standfirst">@Standfirst</p>
                }
                <div class="upcsg-article__byline">
                    <span>From the UPCSG Hall of Fame, verified by the ExeCom</span>
                    <span>@ReadingTime min read</span>
                </div>
                <div class="upcsg-article__cta">
                    <MudButton Variant="Variant.Filled" Class="upcsg-cta-button"
                               StartIcon="@Icons.Material.Outlined.Link" OnClick="CopyLinkAsync">
                        Copy link
                    </MudButton>
                </div>
            </div>
        </header>

        <div class="upcsg-wrap">
            <figure class="upcsg-article__figure">
                <CosmicImage Src="@_entry.ImageUrl"
                             Alt="@_entry.Title"
                             Seed="@_entry.Title"
                             Eager="true"
                             Class="upcsg-article__art" />
                @if (string.IsNullOrWhiteSpace(_entry.ImageUrl))
                {
                    <figcaption>No photo on file for this entry yet.</figcaption>
                }
            </figure>

            <div class="upcsg-article__body" style="padding-bottom: var(--upcsg-chapter-pad)">
                <h2 class="upcsg-article__aside" style="font-size: var(--step-lead); letter-spacing: -0.03em; line-height: 1.1">The story</h2>
                <div class="upcsg-article__text">
                    @if (Body.Count == 0)
                    {
                        <p class="upcsg-article__para">
                            This entry hasn't been written up yet. Only the headline is on record.
                            If you were part of it and can fill in the story,
                            <MudLink Href="contact">get in touch</MudLink>.
                        </p>
                    }
                    else
                    {
                        @foreach (var paragraph in Body)
                        {
                            <p class="upcsg-article__para">@paragraph</p>
                        }
                    }

                    <div class="upcsg-article__actions">
                        <a class="upcsg-textlink" href="hall-of-fame"><span aria-hidden="true">&larr;</span> Back to the record</a>
                    </div>
                </div>
            </div>
        </div>
    </article>

    @if (_more.Count > 0)
    {
        <Chapter Field="night">
            <SectionHeading Title="More wins" Kicker="Elsewhere on the record">
                <Action>
                    <a class="upcsg-textlink" href="hall-of-fame">The whole record <span aria-hidden="true">&rarr;</span></a>
                </Action>
            </SectionHeading>
            <div class="upcsg-wins">
                @foreach (var (other, i) in _more.Select((a, i) => (a, i)))
                {
                    <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 70)">
                        <AchievementCard Entry="other" />
                    </Reveal>
                }
            </div>
        </Chapter>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AchievementDto? _entry;
    private List<AchievementDto> _more = [];
    private bool _loading = true;

    private string Standfirst => Prose.Standfirst(_entry?.Description);

    private IReadOnlyList<string> Body => [.. Prose.Rest(_entry?.Description)];

    private int ReadingTime
    {
        get
        {
            var words = (_entry?.Description ?? string.Empty)
                .Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)
                .Length;

            return Math.Max(1, (int)Math.Ceiling(words / 200.0));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _entry = null;
        _more = [];

        try
        {
            _entry = await AchievementService.GetAchievementAsync(Id);

            if (_entry is not null)
            {
                var all = await AchievementService.GetAchievementsAsync();
                _more = all
                    .Where(a => a.Id != Id)
                    .OrderByDescending(a => a.Year)
                    .ThenByDescending(a => a.Id)
                    .Take(3)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CopyLinkAsync()
    {
        var copied = await JS.InvokeAsync<bool>("upcsgCopyText", Navigation.Uri);

        Snackbar.Add(
            copied ? "Link copied." : "Couldn't copy. You can copy it from the address bar.",
            copied ? Severity.Success : Severity.Warning);
    }
}
