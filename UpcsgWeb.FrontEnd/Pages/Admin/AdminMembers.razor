@page "/admin/members"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAdminContentService Admin
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>People - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">People</h1>
        </div>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">
            New Person
        </MudButton>
    </div>

    <AdminNav />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudTable Items="_members" Hover="true" Class="upcsg-datatable mt-4" Elevation="0" Dense="true"
                  GroupBy="_groupDefinition">
            <HeaderContent>
                <MudTh>Order</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Committee</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <GroupHeaderTemplate>
                <MudTh Class="upcsg-adminnav__group" colspan="5">@context.Key</MudTh>
            </GroupHeaderTemplate>
            <RowTemplate>
                <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Role">@context.Role</MudTd>
                <MudTd DataLabel="Committee">@context.Committee</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    private List<MemberDto> _members = [];
    private bool _loading = true;
    private string? _error;

    private readonly TableGroupDefinition<MemberDto> _groupDefinition = new()
    {
        Selector = m => m.Category == MemberCategory.Faculty ? "Faculty" : "Executive Committee",
        Indentation = false,
        Expandable = false,
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _members = await Admin.GetMembersAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EditAsync(MemberDto? existing)
    {
        var draft = existing is null
            ? new MemberDto { Category = MemberCategory.ExeCom, DisplayOrder = _members.Count + 1 }
            : new MemberDto
            {
                Id = existing.Id,
                Name = existing.Name,
                Role = existing.Role,
                Category = existing.Category,
                Committee = existing.Committee,
                PhotoUrl = existing.PhotoUrl,
                Quote = existing.Quote,
                Bio = existing.Bio,
                DisplayOrder = existing.DisplayOrder,
            };

        var parameters = new DialogParameters<MemberEditDialog> { { x => x.Item, draft } };
        var dialog = await DialogService.ShowAsync<MemberEditDialog>(
            existing is null ? "New person" : $"Edit {existing.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        try
        {
            await Admin.SaveMemberAsync(draft);
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(MemberDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove person", $"Remove {item.Name} from the site?", yesText: "Remove", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Admin.DeleteMemberAsync(item.Id);
            Snackbar.Add("Removed.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
