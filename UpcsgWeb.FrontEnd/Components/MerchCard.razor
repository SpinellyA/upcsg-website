@using UpcsgWeb.Shared.Contracts

<a class="upcsg-specimen @(Item.InStock ? null : "upcsg-specimen--out")" href="@($"merch/{Item.Id}")">
    <span class="upcsg-specimen__ground">
        <CosmicImage Src="@Photo" Alt="@Item.Name" Seed="@Item.Name" Class="upcsg-specimen__img" />
    </span>
    <span class="upcsg-specimen__name">@Item.Name</span>
    <span class="upcsg-specimen__price">
        @if (!Item.InStock && !Item.IsPreorder)
        {
            <text>Sold out</text>
        }
        else
        {
            <text>@(Item.HasPriceRange ? "From " : null)&#8369;@Item.PriceFrom.ToString("N2")@(Item.IsPreorder ? ", preorder" : null)</text>
        }
    </span>
</a>

@code {
    public enum Density
    {
        Card,

        Feature,
    }

    [Parameter, EditorRequired] public MerchItemDto Item { get; set; } = default!;

    [Parameter] public Density Variant { get; set; } = Density.Card;

    private string? Photo =>
        Item.PhotoUrls.FirstOrDefault(u => !string.IsNullOrWhiteSpace(u)) ?? Item.ImageUrl;

    private string? Flag =>
        Item.IsPreorder ? "Pre-order"
        : Item.HasActiveSale ? $"-{Item.SalePercentage:0.#}%"
        : !Item.InStock ? "Sold out"
        : null;
}
