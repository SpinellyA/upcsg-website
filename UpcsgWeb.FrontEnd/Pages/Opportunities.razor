@page "/opportunities"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IOpportunityService OpportunityFeed
@inject IJSRuntime JS

<PageTitle>Opportunities - UPCSG</PageTitle>

<PageMasthead Section="Opportunities"
              Field="ultra"
              Meta="@([_loading ? null : $"{_open.Count} open now", _past.Count > 0 ? $"{_past.Count} closed" : null])"
              Title="Competitions and calls">
    <Lede>
        Hackathons, quizbowls, scholarships and calls worth a guilder's time, posted by the
        ExeCom and sorted by the soonest deadline.
    </Lede>
    <Actions>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="opportunities#open">See what's open</MudButton>
    </Actions>
</PageMasthead>

@if (_loading)
{
    <Chapter Field="paper">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" Class="upcsg-skeleton" />
    </Chapter>
}
else if (_open.Count == 0)
{
    <Chapter Field="paper">
        <SectionHeading Title="Nothing open right now" />
        <div class="upcsg-empty">
            <p>
                The ExeCom posts hackathons, competitions and calls here as they come in. Check
                back, or ask on the guild chat.
            </p>
            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button" Href="contact">Ask the ExeCom</MudButton>
        </div>
    </Chapter>
}
else
{
    <Chapter Field="paper">
        <div class="upcsg-planner__head">
            <h2 class="upcsg-planner__month">
                Deadlines in @_month.ToString("MMMM")<small>@_month.ToString("yyyy")</small>
            </h2>

            <div class="upcsg-planner__controls">
                @if (_month != EarliestMonth)
                {
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button" OnClick="GoToThisMonth">
                        This month
                    </MudButton>
                }
                <div class="upcsg-calnav">
                    <button type="button" class="upcsg-calnav__btn"
                            disabled="@(!CanGoBack)"
                            aria-label="Previous month"
                            @onclick="() => ShiftMonth(-1)">&lsaquo;</button>
                    <button type="button" class="upcsg-calnav__btn"
                            disabled="@(!CanGoForward)"
                            aria-label="Next month"
                            @onclick="() => ShiftMonth(1)">&rsaquo;</button>
                </div>
            </div>
        </div>

        <div class="upcsg-planner__grid" role="grid" aria-label="@($"{_month:MMMM yyyy} deadlines")">
            @foreach (var dow in DayNames)
            {
                <div class="upcsg-planner__dow" role="columnheader">@dow</div>
            }

            @for (var blank = 0; blank < LeadingBlanks; blank++)
            {
                <div class="upcsg-planner__blank"></div>
            }

            @for (var day = 1; day <= DaysInMonth; day++)
            {
                var date = new DateTime(_month.Year, _month.Month, day);
                var entries = EntriesOn(date);
                var isToday = date == DateTime.Today;

                if (entries.Count == 0)
                {
                    <div class="upcsg-planner__day @(isToday ? "upcsg-planner__day--today" : null)">
                        <span class="upcsg-planner__num">@day</span>
                    </div>
                }
                else
                {
                    var picked = date;
                    <button type="button"
                            class="upcsg-planner__day upcsg-planner__day--marked @(isToday ? "upcsg-planner__day--today" : null) @(_selectedDate == date ? "upcsg-planner__day--selected" : null)"
                            aria-label="@DayLabel(date, entries)"
                            @onclick="() => SelectDayAsync(picked)">
                        <span class="upcsg-planner__num">@day</span>
                        <span class="upcsg-planner__entries">
                            @foreach (var entry in entries.Take(2))
                            {
                                <span class="upcsg-planner__entry @(entry.IsDeadline ? null : "upcsg-planner__entry--happens")">
                                    @entry.Item.Title
                                </span>
                            }
                            @if (entries.Count > 2)
                            {
                                <span class="upcsg-planner__more">+@(entries.Count - 2) more</span>
                            }
                        </span>
                    </button>
                }
            }
        </div>

        <div class="upcsg-planner__legend">
            <span><i></i> Deadline</span>
            <span><i class="is-happens"></i> Event day</span>
            <span><i class="is-today"></i> Today</span>
            <span class="upcsg-planner__summary">@MonthSummary</span>
        </div>
    </Chapter>

    <Chapter Field="night" Id="open">
        <SectionHeading Title="@(_selectedDate is null ? "Open now" : _selectedDate.Value.ToString("dddd, MMMM d"))"
                        Kicker="@ListKicker">
            <Action>
                @if (_selectedDate is not null)
                {
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button" OnClick="ClearSelection">
                        Show all @_open.Count
                    </MudButton>
                }
            </Action>
        </SectionHeading>

        @if (Listed.Count == 0)
        {
            <div class="upcsg-empty">
                <p>Nothing on @_selectedDate?.ToString("MMMM d").</p>
            </div>
        }
        else
        {
            <div class="upcsg-menu">
                @foreach (var (item, i) in Listed.Select((o, i) => (o, i)))
                {
                    <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 60)">
                        <OpportunityRow Opportunity="item" ShowBlurb="true"
                                        Id="@($"opportunity-{item.Id}")"
                                        Hit="IsHit(item)" />
                    </Reveal>
                }
            </div>
        }
    </Chapter>
}

@if (!_loading && _past.Count > 0)
{
    <Chapter Field="amethyst">
        <SectionHeading Title="Already closed" Kicker="@($"{_past.Count} on record")" />

        <div class="upcsg-menu">
            @foreach (var (item, i) in _past.Select((o, i) => (o, i)))
            {
                <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 60)">
                    <OpportunityRow Opportunity="item" Id="@($"opportunity-{item.Id}")" />
                </Reveal>
            }
        </div>
    </Chapter>
}

<Chapter Field="gold" Class="upcsg-close">
    <h2 class="upcsg-close__title">
        <span>Know of</span>
        <span>another?</span>
    </h2>
    <div class="upcsg-close__foot">
        <p>
            Seen a competition, scholarship or call other guilders should hear about? Send it our
            way and we'll put it on the board.
        </p>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="contact">Send it to the ExeCom</MudButton>
    </div>
</Chapter>

@code {
    private record Entry(OpportunityDto Item, bool IsDeadline);

    private static readonly string[] DayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];


    // Split on arrival and kept apart from there. Everything on this page above the Past
    // section - the calendar, its month range, the counts - is about what a reader can still
    // act on, so only _open feeds any of it.
    private List<OpportunityDto> _open = [];
    private List<OpportunityDto> _past = [];
    private bool _loading = true;

    private DateTime _month = FirstOf(DateTime.Today);
    private DateTime? _selectedDate;

    private DateTime FirstOfMonth => new(_month.Year, _month.Month, 1);
    private int DaysInMonth => DateTime.DaysInMonth(_month.Year, _month.Month);
    private int LeadingBlanks => (int)FirstOfMonth.DayOfWeek;

    // The reachable range is this month through the furthest date anything is pencilled in for.
    // Past months hold nothing, because the calendar is built from _open alone, and months
    // beyond the last deadline are empty grids nobody needs to page through.
    private DateTime EarliestMonth => FirstOf(DateTime.Today);

    private DateTime LatestMonth => _open
        .SelectMany(o => new[] { o.ClosesAt, o.HappensAt })
        .Where(d => d is not null)
        .Select(d => FirstOf(d!.Value.ToLocalTime().Date))
        .DefaultIfEmpty(EarliestMonth)
        .Max();

    private bool CanGoBack => _month > EarliestMonth;
    private bool CanGoForward => _month < LatestMonth;

    private string MonthSummary
    {
        get
        {
            var deadlines = _open.Count(o => InMonth(o.ClosesAt));
            var happenings = _open.Count(o => InMonth(o.HappensAt));

            if (deadlines == 0 && happenings == 0)
            {
                return $"Nothing on in {_month:MMMM}";
            }

            var parts = new List<string>();

            if (deadlines > 0)
            {
                parts.Add($"{deadlines} {(deadlines == 1 ? "deadline" : "deadlines")}");
            }

            if (happenings > 0)
            {
                parts.Add($"{happenings} running");
            }

            return $"{string.Join(", ", parts)} in {_month:MMMM}";
        }
    }

    private List<OpportunityDto> Listed => _selectedDate is null
        ? _open
        : [.. _open.Where(IsHit)];

    private string ListKicker => _selectedDate is not null
        ? _selectedDate.Value.ToString("dddd, MMMM d")
        : $"{_open.Count} open right now";

    private string ListTitle => _selectedDate is not null ? "That day" : "Everything open";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await OpportunityFeed.GetAllAsync();

            _open = [.. all.Where(o => !o.IsClosed)];

            // Most recently closed first: what just ended is the part still worth reading,
            // which is the reverse of how the open list is ordered.
            _past = [.. all.Where(o => o.IsClosed).OrderByDescending(o => o.ClosesAt)];
        }
        finally
        {
            _loading = false;
        }
    }

    private static DateTime FirstOf(DateTime date) => new(date.Year, date.Month, 1);

    private static DateTime? LocalDate(DateTimeOffset? moment) => moment?.ToLocalTime().Date;

    private bool InMonth(DateTimeOffset? moment) =>
        moment is not null && FirstOf(moment.Value.ToLocalTime().Date) == _month;

    // Deadlines lead the cell: on a day that holds both, the one you can still miss
    // matters more than the one you are just attending.
    private List<Entry> EntriesOn(DateTime date) =>
    [
        .. _open.Where(o => LocalDate(o.ClosesAt) == date).Select(o => new Entry(o, true)),
        .. _open.Where(o => LocalDate(o.HappensAt) == date).Select(o => new Entry(o, false)),
    ];

    private bool IsHit(OpportunityDto item) =>
        _selectedDate is not null
        && (LocalDate(item.ClosesAt) == _selectedDate || LocalDate(item.HappensAt) == _selectedDate);

    private static string DayLabel(DateTime date, List<Entry> entries)
    {
        var closing = entries.Count(e => e.IsDeadline);
        var running = entries.Count - closing;
        var parts = new List<string>();

        if (closing > 0)
        {
            parts.Add($"{closing} closing");
        }

        if (running > 0)
        {
            parts.Add($"{running} happening");
        }

        return $"{date:MMMM d}, {string.Join(", ", parts)}";
    }

    private void ShiftMonth(int delta)
    {
        _month = _month.AddMonths(delta);
        _selectedDate = null;
    }

    private void GoToThisMonth()
    {
        _month = EarliestMonth;
        _selectedDate = null;
    }

    private void ClearSelection() => _selectedDate = null;

    private async Task SelectDayAsync(DateTime date)
    {
        _selectedDate = date;

        var first = Listed.FirstOrDefault();
        if (first is null)
        {
            return;
        }

        StateHasChanged();
        await Task.Yield();

        await JS.InvokeVoidAsync("upcsgScrollToId", $"opportunity-{first.Id}");
    }
}
