@page "/events/{Id:guid}"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IEventService EventService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_event?.Title ?? "Event") - UPCSG</PageTitle>

@if (_loading)
{
    <Chapter Field="night" Class="upcsg-chapter--first">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="420px" Class="upcsg-skeleton" />
    </Chapter>
}
else if (_event is null)
{
    <Chapter Field="gold" Class="upcsg-chapter--first">
        <div class="upcsg-lost">
            <h1 class="upcsg-lost__title">Event not found</h1>
            <p>It may have been removed, or the link may be wrong.</p>
            <MudButton Variant="Variant.Filled" Class="upcsg-cta-button" Href="events">See this month's events</MudButton>
        </div>
    </Chapter>
}
else
{
    <section class="upcsg-eventhero" data-field="night">
        <CosmicImage Src="@_event.PosterUrl"
                     Alt="@($"Poster for {_event.Title}")"
                     Seed="@_event.Title"
                     Eager="true"
                     Class="upcsg-eventhero__art" />
        <div class="upcsg-eventhero__scrim"></div>

        <div class="upcsg-eventhero__inner">
            <p class="upcsg-eventhero__when">@HeroWhen</p>
            <h1 class="upcsg-eventhero__title">@_event.Title</h1>
            <p class="upcsg-eventhero__meta">
                A UP Computer Science Guild event@(string.IsNullOrWhiteSpace(_event.Location) ? "" : $" at {_event.Location}"). @EventTiming.StatusLabel(_event).
            </p>
            <div class="upcsg-eventhero__actions">
                <MudButton Variant="Variant.Filled" Class="upcsg-cta-button"
                           StartIcon="@Icons.Material.Outlined.Share" OnClick="ShareAsync">
                    Share this event
                </MudButton>
            </div>
        </div>
    </section>

    <Chapter Field="paper">
        <h2 class="upcsg-visually-hidden">At a glance</h2>
        <div class="upcsg-facts">
            <Reveal Variant="Reveal.RevealMotion.Up" Class="upcsg-fact">
                <span class="upcsg-fact__label">When</span>
                <span class="upcsg-fact__value">@GlanceWhen</span>
            </Reveal>
            <Reveal Variant="Reveal.RevealMotion.Up" Delay="80" Class="upcsg-fact">
                <span class="upcsg-fact__label">Time</span>
                <span class="upcsg-fact__value">@EventTiming.TimeRange(_event)</span>
            </Reveal>
            <Reveal Variant="Reveal.RevealMotion.Up" Delay="160" Class="upcsg-fact">
                <span class="upcsg-fact__label">Runs for</span>
                <span class="upcsg-fact__value">@EventTiming.DurationLabel(_event)</span>
            </Reveal>
            <Reveal Variant="Reveal.RevealMotion.Up" Delay="240" Class="upcsg-fact">
                <span class="upcsg-fact__label">Where</span>
                <span class="upcsg-fact__value">@_event.Location</span>
            </Reveal>
        </div>

        <div class="upcsg-facts__row">
            <span class="upcsg-facts__countdown">@EventTiming.Countdown(_event)</span>
        </div>

        @if (EventTiming.IsOnline(_event))
        {
            <p class="upcsg-facts__note">
                <MudIcon Icon="@Icons.Material.Outlined.Videocam" Size="Size.Small" />
                Runs online. The joining link goes out in the guild channels closer to the day.
            </p>
        }

        <div class="upcsg-readable" style="margin-top: clamp(64px, 8vw, 128px)">
            <h2>About this event</h2>
            <div class="upcsg-readable__body">
                @foreach (var paragraph in Paragraphs)
                {
                    <p>@paragraph</p>
                }
                <a class="upcsg-textlink" href="events">All events this month <span aria-hidden="true">&rarr;</span></a>
            </div>
        </div>
    </Chapter>

    @if (_others.Count > 0)
    {
        <Chapter Field="night">
            <SectionHeading Title="Also this month" Kicker="@($"{_others.Count} more")">
                <Action>
                    <a class="upcsg-textlink" href="events">The calendar <span aria-hidden="true">&rarr;</span></a>
                </Action>
            </SectionHeading>
            <div class="upcsg-menu">
                @foreach (var (other, i) in _others.Select((o, i) => (o, i)))
                {
                    <Reveal Variant="Reveal.RevealMotion.Up" Delay="@(i * 60)">
                        <EventRow Event="other" />
                    </Reveal>
                }
            </div>
        </Chapter>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private EventDto? _event;
    private List<EventDto> _others = [];
    private bool _loading = true;

    private DateTime? Starts => _event is null ? null : EventTiming.Starts(_event);

    // A coming-soon event has no confirmed day, so neither of these may state one. They fall
    // back to the pencilled-in month where there is one, and say so plainly where there is not.
    private string HeroWhen =>
        _event is null ? string.Empty
        : _event.IsScheduled && Starts is { } s ? s.ToString("dddd, MMMM d, yyyy")
        : EventTiming.PencilledIn(_event) is { } month ? $"Around {month}"
        : "Date to be announced";

    private string GlanceWhen =>
        _event is null ? string.Empty
        : _event.IsScheduled && Starts is { } s ? s.ToString("ddd, MMM d")
        : EventTiming.PencilledIn(_event) ?? "To be announced";

    private IEnumerable<string> Paragraphs =>
        (_event?.Description ?? string.Empty)
            .Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(p => p.Replace('\n', ' '));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _event = null;
        _others = [];

        try
        {
            _event = await EventService.GetEventAsync(Id);

            if (_event is not null)
            {
                var month = await EventService.GetThisMonthEventsAsync();
                _others = month
                    .Where(e => e.Id != Id)
                    .OrderBy(e => e.StartDateTime)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ShareAsync()
    {
        var result = await JS.InvokeAsync<string>("upcsgShare", _event?.Title ?? "UPCSG event", Navigation.Uri);

        switch (result)
        {
            case "shared":
                break;
            case "copied":
                Snackbar.Add("Link copied.", Severity.Success);
                break;
            case "cancelled":
                break;
            default:
                Snackbar.Add("Couldn't share. You can copy the link from the address bar.", Severity.Warning);
                break;
        }
    }
}
