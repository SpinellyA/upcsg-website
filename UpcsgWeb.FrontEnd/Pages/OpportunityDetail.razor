@page "/opportunities/{Id:guid}"
@using System.Globalization
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IOpportunityService OpportunityFeed
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_item?.Title ?? "Opportunity") - UPCSG</PageTitle>

@if (_loading)
{
    <div class="upcsg-page">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" Class="upcsg-skeleton my-6" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="90%" />
    </div>
}
else if (_item is null)
{
    <div class="upcsg-page">
        <MudAlert Severity="Severity.Warning">
            We couldn't find that opportunity. It may have closed, or the link may be wrong.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6 mt-4" Href="opportunities">
            Back to Opportunities
        </MudButton>
    </div>
}
else
{
    <section class="upcsg-oppmast">
        <div class="upcsg-flare upcsg-oppmast__flare"></div>
        <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 22%; right: 18%;"><span class="upcsg-star" style="width: 1.1rem; height: 1.1rem;"></span></span>
        <span class="upcsg-sparkle upcsg-sparkle--lilac upcsg-sparkle--delay-2" style="bottom: 26%; right: 34%;"><span class="upcsg-star" style="width: 0.7rem; height: 0.7rem;"></span></span>

        <div class="upcsg-oppmast__inner @(HasPoster ? null : "upcsg-oppmast__inner--plain")">
            <div class="upcsg-oppmast__text">
                <MudLink Href="opportunities" Class="upcsg-oppmast__back">&larr; All opportunities</MudLink>

                <div class="upcsg-oppmast__chips">
                    <span class="upcsg-chip">@OpportunityText.KindLabel(_item.Kind)</span>

                    @if (_item.IsFeatured)
                    {
                        <span class="upcsg-chip upcsg-chip--gold">Featured</span>
                    }
                </div>

                <h1 class="upcsg-oppmast__title">
                    <span class="upcsg-gradient-text">@_item.Title</span>
                </h1>

                <p class="upcsg-oppmast__meta">
                    @if (!string.IsNullOrWhiteSpace(_item.Organiser))
                    {
                        <span class="upcsg-oppmast__org">@_item.Organiser</span>
                    }

                    @if (!string.IsNullOrWhiteSpace(_item.Location))
                    {
                        <span class="upcsg-oppmast__where">
                            <MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" />
                            @_item.Location
                        </span>
                    }
                </p>
            </div>

            @if (HasPoster)
            {
                <CosmicImage Src="@_item.PosterUrl"
                             Alt="@($"Poster for {_item.Title}")"
                             Seed="@_item.Title"
                             Eager="true"
                             Class="upcsg-oppmast__plate" />
            }
        </div>
    </section>

    <div class="upcsg-page upcsg-page--after-hero">
        <Reveal Variant="Reveal.RevealMotion.Up">
            <section class="upcsg-surface upcsg-oppdeadline upcsg-oppdeadline--@OpportunityText.Urgency(_item)">
                <div class="upcsg-dial" style="@DialStyle">
                    <div class="upcsg-dial__face">
                        <span class="upcsg-dial__num">@OpportunityText.Countdown(_item)</span>
                        <span class="upcsg-dial__unit">@OpportunityText.CountdownUnit(_item)</span>
                    </div>
                </div>

                <div class="upcsg-oppdeadline__body">
                    <ol class="upcsg-oppstages">
                        <li class="upcsg-oppstages__step upcsg-oppstages__step--@StageState(_item.OpensAt)">
                            <span class="upcsg-oppstages__label">Opens</span>
                            <span class="upcsg-oppstages__value">@Stamp(_item.OpensAt, "Already open")</span>
                        </li>
                        <li class="upcsg-oppstages__step upcsg-oppstages__step--@StageState(_item.ClosesAt)">
                            <span class="upcsg-oppstages__label">Closes</span>
                            <span class="upcsg-oppstages__value">@Stamp(_item.ClosesAt, "No deadline")</span>
                        </li>
                        <li class="upcsg-oppstages__step upcsg-oppstages__step--@StageState(_item.HappensAt)">
                            <span class="upcsg-oppstages__label">Happens</span>
                            <span class="upcsg-oppstages__value">@Stamp(_item.HappensAt, "Not announced")</span>
                        </li>
                    </ol>

                    <div class="upcsg-oppdeadline__actions">
                        @if (!string.IsNullOrWhiteSpace(_item.Url))
                        {
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Large"
                                       Class="upcsg-cta-button px-8"
                                       EndIcon="@Icons.Material.Outlined.OpenInNew"
                                       Href="@_item.Url"
                                       Target="_blank">
                                @(_item.IsClosed ? "Visit the page" : "Register")
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Outlined"
                                   Class="upcsg-ghost-button px-6"
                                   StartIcon="@Icons.Material.Outlined.Share"
                                   OnClick="ShareAsync">
                            Share
                        </MudButton>
                    </div>
                </div>
            </section>
        </Reveal>

        @if (Paragraphs.Count > 0)
        {
            <Reveal Variant="Reveal.RevealMotion.Up" Delay="80">
                <article class="upcsg-oppbody">
                    <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> What it is</p>

                    <p class="upcsg-oppbody__lead">@Paragraphs[0]</p>

                    @foreach (var paragraph in Paragraphs.Skip(1))
                    {
                        <p class="upcsg-oppbody__para">@paragraph</p>
                    }
                </article>
            </Reveal>
        }

        @if (string.IsNullOrWhiteSpace(_item.Url))
        {
            <Reveal Variant="Reveal.RevealMotion.Fade" Delay="160">
                <MudAlert Severity="Severity.Info" Square="true" Elevation="0" Class="mt-6">
                    No link was posted with this one. Ask in the guild chat and an officer can
                    point you at the details.
                </MudAlert>
            </Reveal>
        }

        @if (_others.Count > 0)
        {
            <section class="upcsg-section">
                <SectionHeading Kicker="Still open" Title="More opportunities">
                    <Action>
                        <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="opportunities">
                            See the board
                        </MudButton>
                    </Action>
                </SectionHeading>

                <div class="upcsg-cardgrid upcsg-cardgrid--3">
                    @foreach (var (other, i) in _others.Take(3).Select((o, i) => (o, i)))
                    {
                        <Reveal Variant="Reveal.RevealMotion.Fade" Delay="@(i * 60)">
                            <OpportunityCard Opportunity="other" />
                        </Reveal>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OpportunityDto? _item;
    private List<OpportunityDto> _others = [];
    private bool _loading = true;

    private bool HasPoster => !string.IsNullOrWhiteSpace(_item?.PosterUrl);

    private List<string> Paragraphs =>
        [.. OpportunityText.Paragraphs(_item?.Description)];

    // How much of the application window has burned through. The window runs from when
    // applications opened - or, when no opening date was given, from the day the guild
    // posted it, which is the point it became something a reader could act on.
    private double? WindowProgress
    {
        get
        {
            if (_item?.ClosesAt is null)
            {
                return null;
            }

            var opens = (_item.OpensAt ?? _item.CreatedAt).ToLocalTime();
            var closes = _item.ClosesAt.Value.ToLocalTime();

            if (closes <= opens)
            {
                return 1;
            }

            var elapsed = (DateTimeOffset.Now - opens).TotalSeconds / (closes - opens).TotalSeconds;

            return Math.Clamp(elapsed, 0, 1);
        }
    }

    // Invariant formatting matters: a comma decimal separator is not a valid CSS number,
    // and this machine's culture is not the reader's.
    private string DialStyle => WindowProgress is null
        ? "--upcsg-dial-progress: 0"
        : $"--upcsg-dial-progress: {WindowProgress.Value.ToString("0.###", CultureInfo.InvariantCulture)}";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _item = null;
        _others = [];

        try
        {
            _item = await OpportunityFeed.GetAsync(Id);

            if (_item is not null)
            {
                // "More like this" points at things the reader can still enter, so closed
                // entries stay out of it even though this page will happily show one.
                _others = (await OpportunityFeed.GetAllAsync())
                    .Where(o => o.Id != Id && !o.IsClosed)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Stamp(DateTimeOffset? moment, string fallback) =>
        moment is null ? fallback : moment.Value.ToLocalTime().ToString("ddd, MMM d");

    // Past stages read as done, the rest as pending, so the row shows at a glance where
    // in its life the thing is. A stage with no date is neither.
    private static string StageState(DateTimeOffset? moment) => moment switch
    {
        null => "blank",
        var m when m.Value < DateTimeOffset.Now => "done",
        _ => "ahead",
    };

    private async Task ShareAsync()
    {
        var result = await JS.InvokeAsync<string>(
            "upcsgShare", _item?.Title ?? "UPCSG opportunity", Navigation.Uri);

        switch (result)
        {
            case "shared":
            case "cancelled":
                break;
            case "copied":
                Snackbar.Add("Link copied.", Severity.Success);
                break;
            default:
                Snackbar.Add("Couldn't share. You can copy the link from the address bar.", Severity.Warning);
                break;
        }
    }
}
