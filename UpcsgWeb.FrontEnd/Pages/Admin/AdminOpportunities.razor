@page "/admin/opportunities"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAdminContentService Admin
@inject NavigationManager Navigation

<PageTitle>Opportunities - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">Opportunities</h1>
        </div>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="admin/opportunities/new">
            New Opportunity
        </MudButton>
    </div>

    <AdminNav />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudTable Items="_items"
                  T="OpportunityDto"
                  Hover="true"
                  Class="upcsg-datatable mt-4"
                  Elevation="0"
                  Dense="true"
                  Loading="_loading"
                  LoadingProgressColor="Color.Primary"
                  Filter="new Func<OpportunityDto, bool>(Matches)"
                  AllowUnsorted="false"
                  OnRowClick="@(args => Open(args.Item))"
                  RowClass="upcsg-datatable__row">
            <ToolBarContent>
                <MudTextField @bind-Value="_search"
                              Immediate="true"
                              DebounceInterval="150"
                              Placeholder="Search opportunities"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Text"
                              Clearable="true"
                              Class="upcsg-datatable__search mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel T="OpportunityDto" SortBy="@(o => o.Title)">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="OpportunityDto" SortBy="@(o => o.Kind)">Kind</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="OpportunityDto" SortBy="@(o => o.Organiser ?? string.Empty)">Organiser</MudTableSortLabel></MudTh>
                <MudTh>
                    <MudTableSortLabel T="OpportunityDto"
                                       SortBy="@(o => o.ClosesAt ?? DateTimeOffset.MaxValue)"
                                       InitialDirection="SortDirection.Ascending">
                        Closes
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Kind">@KindLabel(context.Kind)</MudTd>
                <MudTd DataLabel="Organiser">@(context.Organiser ?? "—")</MudTd>
                <MudTd DataLabel="Closes">
                    @(context.ClosesAt is null ? "—" : context.ClosesAt.Value.ToLocalTime().ToString("MMM d, yyyy"))
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsClosed)
                    {
                        <span class="upcsg-statuspill upcsg-statuspill--cancelled">Closed</span>
                    }
                    else
                    {
                        <span class="upcsg-statuspill upcsg-statuspill--received">Open</span>
                    }

                    @if (context.IsFeatured)
                    {
                        <span class="upcsg-datatable__flag">Featured</span>
                    }
                </MudTd>
                <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <p class="upcsg-lede my-4">
                    @(string.IsNullOrWhiteSpace(_search)
                        ? "Nothing posted yet. Add the first opportunity."
                        : $"Nothing matches \"{_search}\".")
                </p>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="PageSizes" InfoFormat="{first_item}-{last_item} of {all_items} opportunities" />
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50];

    private List<OpportunityDto> _items = [];
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = await Admin.GetOpportunitiesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private bool Matches(OpportunityDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();

        return item.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (item.Organiser?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.Location?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || KindLabel(item.Kind).Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private void Open(OpportunityDto? item)
    {
        if (item is not null)
        {
            Navigation.NavigateTo($"admin/opportunities/{item.Id}");
        }
    }

    private static string KindLabel(OpportunityKindDto kind) => kind switch
    {
        OpportunityKindDto.CallForPapers => "Call for papers",
        _ => kind.ToString(),
    };
}
