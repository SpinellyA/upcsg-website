@* Collects the mandatory reason for cancellations and receipt rejections. The domain
   rejects a blank one, so the confirm button stays disabled until there's text. *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_reason"
                      Label="@Label"
                      Variant="Variant.Outlined"
                      Lines="3"
                      AutoFocus="true"
                      Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Never mind</MudButton>
        <MudButton Variant="Variant.Filled"
                   Class="upcsg-cta-button px-6"
                   Disabled="string.IsNullOrWhiteSpace(_reason)"
                   OnClick="Confirm">
            Confirm
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Label { get; set; } = "Reason";

    private string _reason = string.Empty;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(_reason.Trim()));

    private void Cancel() => MudDialog.Cancel();
}
