@using UpcsgWeb.FrontEnd.Services
@implements IDisposable
@inject EditModeState EditMode

@* The affordance itself. Renders nothing at all unless an officer has turned edit mode on,
   so the public markup is untouched for everybody else.

   Absolutely positioned against the nearest positioned ancestor — give the thing being
   edited `position: relative` and this parks in its top-right corner. *@

@if (EditMode.IsEditing)
{
    <AuthorizeView Policy="ExeCom">
        <button type="button"
                class="upcsg-pencil @(Large ? "upcsg-pencil--lg" : null)"
                title="@Label"
                aria-label="@Label"
                @onclick="OnEdit"
                @onclick:stopPropagation="true"
                @onclick:preventDefault="true">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="@(Large ? Size.Small : Size.Small)" />
        </button>
    </AuthorizeView>
}

@code {
    [Parameter, EditorRequired] public EventCallback OnEdit { get; set; }

    /// <summary>Announced to screen readers, so "Edit" alone isn't enough — say what.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "Edit";

    [Parameter] public bool Large { get; set; }

    protected override void OnInitialized() => EditMode.Changed += Refresh;

    public void Dispose() => EditMode.Changed -= Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);
}
