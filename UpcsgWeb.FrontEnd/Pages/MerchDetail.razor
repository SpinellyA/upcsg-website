@page "/merch/{Id:int}"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IMerchService MerchService
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_item?.Name ?? "Merch") - UPCSG</PageTitle>

@if (_loading)
{
    <div class="upcsg-page">
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    </div>
}
else if (_item is null)
{
    <div class="upcsg-page">
        <MudAlert Severity="Severity.Warning">
            We couldn't find that item. It may have been taken down, or the link may be wrong.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6 mt-4" Href="merch">
            Back to the store
        </MudButton>
    </div>
}
else
{
    <div class="upcsg-page upcsg-page--tight">
        <MudLink Href="merch" Class="mb-4 d-inline-block">&larr; Guild store</MudLink>

        <section class="upcsg-product">

            @* ---------- Gallery ---------- *@
            <div class="upcsg-gallery">
                <div class="upcsg-gallery__main">
                    @if (Photos.Count > 0)
                    {
                        <img src="@Photos[_photoIndex]" alt="@_item.Name"
                             onerror="this.closest('.upcsg-gallery__main').classList.add('upcsg-gallery__main--broken'); this.remove();" />
                    }
                    else
                    {
                        <img class="upcsg-merch-placeholder" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
                    }

                    <p class="upcsg-gallery__broken">Photo couldn't be loaded.</p>

                    @if (!_item.InStock)
                    {
                        <span class="upcsg-gallery__soldout">Sold out</span>
                    }
                    else if (_item.IsPreorder)
                    {
                        <span class="upcsg-gallery__badge upcsg-gallery__badge--preorder">Preorder</span>
                    }
                    else if (_item.HasActiveSale)
                    {
                        <span class="upcsg-gallery__badge upcsg-gallery__badge--sale">
                            @_item.SalePercentage.ToString("0.##")% off
                        </span>
                    }
                </div>

                @* Thumbnails only earn their space once there's more than one photo. *@
                @if (Photos.Count > 1)
                {
                    <div class="upcsg-gallery__strip" role="group" aria-label="Photos">
                        @for (var i = 0; i < Photos.Count; i++)
                        {
                            var index = i;
                            <button type="button"
                                    class="upcsg-gallery__thumb @(index == _photoIndex ? "upcsg-gallery__thumb--on" : null)"
                                    aria-label="@($"Photo {index + 1} of {Photos.Count}")"
                                    aria-pressed="@(index == _photoIndex ? "true" : "false")"
                                    @onclick="() => _photoIndex = index">
                                <img src="@Photos[index]" alt="" loading="lazy" />
                            </button>
                        }
                    </div>
                }
            </div>

            @* ---------- Buy panel ---------- *@
            <div class="upcsg-buy">
                <h1 class="upcsg-buy__name">@_item.Name</h1>

                <p class="upcsg-buy__price">
                    @if (_selected is null && _item.HasPriceRange)
                    {
                        <span class="upcsg-buy__from">from</span>
                    }
                    <span class="upcsg-gradient-text">&#8369;@UnitPrice.ToString("N2")</span>

                    @* Struck-through list price, so the saving is visible rather than
                       asserted. Only when a sale is actually active. *@
                    @if (_item.HasActiveSale && ListUnitPrice > UnitPrice)
                    {
                        <span class="upcsg-buy__was">&#8369;@ListUnitPrice.ToString("N2")</span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(Blurb))
                {
                    <p class="upcsg-buy__desc">@Blurb</p>
                }

                @if (_item.Variants.Count > 0)
                {
                    <div class="upcsg-buy__block">
                        <p class="upcsg-buy__label">
                            Variant
                            @if (_selected is null)
                            {
                                <span class="upcsg-buy__required">Pick one</span>
                            }
                        </p>

                        <div class="upcsg-variants" role="group" aria-label="Variant">
                            @foreach (var variant in _item.Variants)
                            {
                                var v = variant;
                                var soldOut = !_item.IsPreorder && v.Stock <= 0;

                                <button type="button"
                                        class="upcsg-variant @(_selected?.Id == v.Id ? "upcsg-variant--on" : null) @(soldOut ? "upcsg-variant--gone" : null)"
                                        aria-pressed="@(_selected?.Id == v.Id ? "true" : "false")"
                                        disabled="@soldOut"
                                        @onclick="() => SelectVariant(v)">
                                    <span class="upcsg-variant__name">@v.Name</span>

                                    @* Only show a per-variant price when they actually differ,
                                       otherwise every chip repeats the same number. *@
                                    @if (_item.HasPriceRange)
                                    {
                                        <span class="upcsg-variant__price">&#8369;@_item.PriceOf(v.Name).ToString("N2")</span>
                                    }

                                    @if (soldOut)
                                    {
                                        <span class="upcsg-variant__note">Sold out</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="upcsg-buy__block">
                    <p class="upcsg-buy__label">Quantity</p>
                    <div class="upcsg-qty">
                        <button type="button" class="upcsg-qty__step" aria-label="Fewer"
                                disabled="@(_quantity <= 1)" @onclick="() => SetQuantity(_quantity - 1)">&minus;</button>
                        <input class="upcsg-qty__value" type="number" inputmode="numeric"
                               min="1" max="@Ceiling" aria-label="Quantity"
                               value="@_quantity" @onchange="OnQuantityTyped" />
                        <button type="button" class="upcsg-qty__step" aria-label="More"
                                disabled="@(_quantity >= Ceiling)" @onclick="() => SetQuantity(_quantity + 1)">+</button>

                        @* Says which limit is biting: the per-line cap, or what's left. *@
                        <span class="upcsg-qty__cap">
                            @if (_item.IsPreorder || !HasSelection || Remaining > MaxPerLine)
                            {
                                <text>max @MaxPerLine</text>
                            }
                            else
                            {
                                <text>@Remaining left</text>
                            }
                        </span>
                    </div>
                </div>

                <div class="upcsg-buy__total">
                    <span>Subtotal</span>
                    <strong>&#8369;@(( UnitPrice * _quantity ).ToString("N2"))</strong>
                </div>

                <AuthorizeView>
                    <Authorized>
                        <div class="upcsg-buy__actions">
                            <MudButton Variant="Variant.Outlined" Size="Size.Large" FullWidth="true"
                                       Class="upcsg-ghost-button"
                                       Disabled="!CanBuy || _busy"
                                       OnClick="() => AddAsync(false)">
                                Add to cart
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Size="Size.Large" FullWidth="true"
                                       Class="upcsg-cta-button"
                                       Disabled="!CanBuy || _busy"
                                       OnClick="() => AddAsync(true)">
                                @(_item.IsPreorder ? "Preorder now" : "Buy now")
                            </MudButton>
                        </div>

                        @if (!_item.InStock)
                        {
                            <p class="upcsg-buy__note">This item is sold out right now.</p>
                        }
                        else if (_item.IsPreorderClosed)
                        {
                            <p class="upcsg-buy__note">The preorder window for this item has closed.</p>
                        }
                        else if (_selected is null && _item.Variants.Count > 0)
                        {
                            <p class="upcsg-buy__note">Choose a variant to continue.</p>
                        }
                        else if (_selected is not null && Remaining <= 0)
                        {
                            <p class="upcsg-buy__note">@_selected.Name is sold out. Try another variant.</p>
                        }
                        else if (_item.IsPreorder)
                        {
                            <p class="upcsg-buy__note">
                                Made to order, so there's no stock limit.
                                @if (_item.PreorderClosesAt is { } closes)
                                {
                                    <text>
                                        Preorders close @closes.ToLocalTime().ToString("MMMM d, h:mm tt").
                                    </text>
                                }
                            </p>
                        }
                        else if (Remaining is > 0 and <= LowStockThreshold)
                        {
                            <p class="upcsg-buy__note">Only @Remaining left.</p>
                        }
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Variant="Variant.Filled" Size="Size.Large" FullWidth="true"
                                   Class="upcsg-cta-button"
                                   Href="@($"login?returnUrl=merch/{Id}")">
                            Sign in to order
                        </MudButton>
                        <p class="upcsg-buy__note">
                            Ordering needs a guilder account so officers know whose order it is.
                        </p>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(_item.Description))
        {
            <section class="upcsg-section">
                <div class="upcsg-surface upcsg-product__about">
                    <p class="upcsg-kicker">Details</p>
                    @foreach (var paragraph in Prose.Paragraphs(_item.Description))
                    {
                        <p class="upcsg-product__para">@paragraph</p>
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    /// <summary>Mirrors Cart.MaxQuantityPerLine; the domain rejects anything above it.</summary>
    private const int MaxPerLine = 25;

    private MerchItemDto? _item;
    private MerchVariantDto? _selected;
    private int _quantity = 1;
    private int _photoIndex;
    private bool _loading = true;
    private bool _busy;

    /// <summary>Below this, saying how many are left creates useful urgency rather than noise.</summary>
    private const int LowStockThreshold = 5;

    private List<string> Photos => _item?.PhotosOf(_selected?.Name) ?? [];

    private decimal UnitPrice => _selected is null
        ? _item?.PriceFrom ?? 0m
        : _item!.PriceOf(_selected.Name);

    private decimal ListUnitPrice => _selected is null
        ? _item?.ListPriceFrom ?? 0m
        : _item!.ListPriceOf(_selected.Name);

    /// <summary>True once there is something concrete to count stock for.</summary>
    private bool HasSelection => _item is not null
        && (_selected is not null || _item.Variants.Count == 0);

    /// <summary>
    /// Units left for the current selection; int.MaxValue for a preorder.
    ///
    /// Before a variant is chosen there is nothing to count — falling back to the item's
    /// own stock would report 0 for any item whose stock lives on its variants, which
    /// reads as "sold out" on a page that is anything but.
    /// </summary>
    private int Remaining => HasSelection ? _item!.StockOf(_selected?.Name) : int.MaxValue;

    /// <summary>
    /// The quantity stepper stops at whichever limit bites first — the per-line cap or
    /// what's actually left — so the guilder can't build a basket the domain will refuse.
    /// </summary>
    private int Ceiling => Math.Max(1, Math.Min(MaxPerLine, Remaining));

    /// <summary>The variant's own blurb when it has one, else the item's opening line.</summary>
    private string Blurb => !string.IsNullOrWhiteSpace(_selected?.Description)
        ? _selected!.Description
        : Prose.Standfirst(_item?.Description);

    private bool CanBuy => _item is { InStock: true }
        && !_item.IsPreorderClosed
        && (_item.Variants.Count == 0 || _selected is not null)
        && _item.CanBuy(_selected?.Name, _quantity);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _item = null;
        _selected = null;
        _quantity = 1;
        _photoIndex = 0;

        try
        {
            _item = await MerchService.GetMerchItemAsync(Id);

            // Preselect when there's only one way to buy it — making someone click "One
            // size" before they can order is a pointless gate. Skipped when that single
            // variant is sold out, so the page doesn't open on a dead selection.
            if (_item is { Variants.Count: 1 } && _item.StockOf(_item.Variants[0].Name) > 0)
            {
                _selected = _item.Variants[0];
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectVariant(MerchVariantDto variant)
    {
        _selected = variant;

        // The gallery may now be showing a different set, so an index carried over from
        // the previous variant could point past the end.
        _photoIndex = 0;

        // Switching to a variant with less stock must pull the quantity down with it,
        // or the buttons would sit enabled on a basket that checkout will reject.
        SetQuantity(_quantity);
    }

    private void SetQuantity(int value) => _quantity = Math.Clamp(value, 1, Ceiling);

    private void OnQuantityTyped(ChangeEventArgs e) =>
        SetQuantity(int.TryParse(e.Value?.ToString(), out var typed) ? typed : 1);

    private async Task AddAsync(bool thenCheckout)
    {
        if (_item is null || !CanBuy)
        {
            return;
        }

        _busy = true;

        try
        {
            await CartService.AddAsync(_item.Id, _selected?.Name, _quantity);

            if (thenCheckout)
            {
                // "Buy now" still goes through the cart: it is where the total, the note and
                // the GCash step live, and duplicating that flow would mean two checkouts
                // to keep correct.
                Navigation.NavigateTo("cart");
                return;
            }

            Snackbar.Add($"Added {_quantity} × {_item.Name} to your cart.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
