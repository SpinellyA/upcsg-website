@page "/admin/orders/{Id:guid}"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Order #@OrderReference.For(Id) - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <MudLink Href="admin/orders" Class="mb-3 d-inline-block">&larr; All orders</MudLink>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_order is null)
    {
        <MudAlert Severity="Severity.Warning" Square="true" Elevation="0">Order not found.</MudAlert>
    }
    else
    {
        <div class="upcsg-section-head">
            <div>
                <p class="upcsg-kicker">
                    @(string.IsNullOrWhiteSpace(_order.GuilderName)
                        ? $"Guilder {OrderReference.For(_order.UserId)}"
                        : _order.GuilderName)
                    &middot; placed @_order.PlacedAt.ToLocalTime().ToString("MMMM d, yyyy")

                    @* When it last moved, which is what tells you whether anyone has
                       picked it up. The DTO has carried this all along without ever
                       showing it. *@
                    @if (_order.UpdatedAt > _order.PlacedAt.AddMinutes(1))
                    {
                        <text> &middot; last moved @Ago(_order.UpdatedAt)</text>
                    }
                </p>
                <h1 class="upcsg-title-xl">Order #@_order.Reference</h1>
                @if (!string.IsNullOrWhiteSpace(_order.GuilderEmail))
                {
                    <p class="upcsg-lede">@_order.GuilderEmail</p>
                }
            </div>
            <span class="upcsg-statuspill upcsg-statuspill--@OrderStatusDisplay.Slug(_order.Status)">
                @OrderStatusDisplay.Label(_order.Status)
            </span>
        </div>

        <AdminNav />

        @if (!string.IsNullOrWhiteSpace(_order.ReceiptRejectionReason)
             && _order.Status == OrderStatusDto.AwaitingPayment)
        {
            <MudAlert Severity="Severity.Warning" Square="true" Elevation="0" Class="mt-4">
                Receipt was sent back: @_order.ReceiptRejectionReason
            </MudAlert>
        }

        <div class="upcsg-orderdetail mt-4">
            <div>
                <MudPaper Square="true" Elevation="0" Class="upcsg-panel">
                    <MudText Typo="Typo.overline" Class="upcsg-panel__title">Items</MudText>

                    <MudTable Items="_order.Lines"
                              T="OrderLineDto"
                              Dense="true"
                              Hover="false"
                              Striped="false"
                              Bordered="false"
                              Elevation="0"
                              Class="upcsg-recordtable"
                              RowClassFunc="@((line, _) => line.Status == OrderLineStatusDto.ToFulfil ? string.Empty : "upcsg-line--short")"
                              CustomFooter="true">
                        <HeaderContent>
                            <MudTh>Item</MudTh>
                            <MudTh>Variant</MudTh>
                            <MudTh Class="upcsg-num">Unit</MudTh>
                            <MudTh Class="upcsg-num">Qty</MudTh>
                            <MudTh Class="upcsg-num">Total</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Item">
                                @context.ItemName

                                @if (context.Status == OrderLineStatusDto.RefundDue)
                                {
                                    <span class="upcsg-datatable__flag">Refund due</span>
                                    <span class="upcsg-line__reason">@context.ShortfallReason</span>
                                }
                                else if (context.Status == OrderLineStatusDto.Refunded)
                                {
                                    <span class="upcsg-line__refunded">Refunded</span>
                                }
                            </MudTd>
                            <MudTd DataLabel="Variant">@(string.IsNullOrWhiteSpace(context.Variant) ? "—" : context.Variant)</MudTd>
                            <MudTd DataLabel="Unit" Class="upcsg-num">&#8369;@context.UnitPrice.ToString("N2")</MudTd>
                            <MudTd DataLabel="Qty" Class="upcsg-num">@context.Quantity</MudTd>
                            <MudTd DataLabel="Total" Class="upcsg-num">&#8369;@context.LineTotal.ToString("N2")</MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTFootRow>
                                <MudTd colspan="4">@(_order.HasRefundDue || _order.RefundHasBeenSettled ? "Guilder paid" : "Total")</MudTd>
                                <MudTd Class="upcsg-num">&#8369;@((_order.AmountPaid ?? _order.Total).ToString("N2"))</MudTd>
                            </MudTFootRow>

                            @if (_order.HasRefundDue || _order.RefundHasBeenSettled)
                            {
                                <MudTFootRow>
                                    <MudTd colspan="4">Being handed over</MudTd>
                                    <MudTd Class="upcsg-num">&#8369;@_order.FulfilledTotal.ToString("N2")</MudTd>
                                </MudTFootRow>
                                <MudTFootRow Class="upcsg-line--short">
                                    <MudTd colspan="4">@(_order.RefundHasBeenSettled ? "Refunded" : "Refund due")</MudTd>
                                    <MudTd Class="upcsg-num">
                                        &#8369;@(((_order.AmountPaid ?? _order.Total) - _order.FulfilledTotal).ToString("N2"))
                                    </MudTd>
                                </MudTFootRow>
                            }
                        </FooterContent>
                    </MudTable>

                    <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
                        Prices shown are what the guilder was charged at checkout, even if the
                        item has been repriced since.
                    </MudText>

                    @if (!string.IsNullOrWhiteSpace(_order.Note))
                    {
                        <MudAlert Severity="Severity.Normal" Square="true" Elevation="0"
                                  Icon="@Icons.Material.Outlined.StickyNote2" Class="mt-3">
                            <strong>Guilder's note:</strong> @_order.Note
                        </MudAlert>
                    }
                </MudPaper>

                <MudPaper Square="true" Elevation="0" Class="upcsg-panel mt-4">
                    <MudText Typo="Typo.overline" Class="upcsg-panel__title">GCash receipt</MudText>

                    @if (_order.Receipt is null)
                    {
                        <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
                            No receipt yet. The guilder submits one from their order page, which is
                            what moves this into your queue.
                        </MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="6" Class="mb-4">
                            <div>
                                <MudText Typo="Typo.overline" Class="upcsg-fact__key">Reference</MudText>
                                <MudText Typo="Typo.body2" Class="upcsg-fact__mono">
                                    @(string.IsNullOrWhiteSpace(_order.Receipt.ReferenceNumber)
                                        ? "Not given — see screenshot"
                                        : _order.Receipt.ReferenceNumber)
                                </MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.overline" Class="upcsg-fact__key">Submitted</MudText>
                                <MudText Typo="Typo.body2">
                                    @_order.Receipt.SubmittedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                </MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.overline" Class="upcsg-fact__key">Amount due</MudText>
                                <MudText Typo="Typo.body2">&#8369;@_order.Total.ToString("N2")</MudText>
                            </div>
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(_order.Receipt.ScreenshotUrl))
                        {
                            <a class="upcsg-receipt" href="@_order.Receipt.ScreenshotUrl" target="_blank" rel="noopener">
                                <img src="@_order.Receipt.ScreenshotUrl"
                                     alt="GCash receipt for order @_order.Id"
                                     loading="lazy"
                                     onerror="upcsgReceiptBroken(this)" />
                                <span class="upcsg-receipt__zoom">Open full size &nearr;</span>
                                <span class="upcsg-receipt__broken">
                                    <strong>Screenshot didn't load.</strong>
                                    The link may be dead or private — open it directly, or ask the
                                    guilder to resend before confirming payment.
                                </span>
                            </a>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
                                Reference number only — no screenshot was attached. Verify against the
                                guild's GCash transaction log before confirming.
                            </MudText>
                        }
                    }
                </MudPaper>
            </div>

            <aside>
                <MudPaper Square="true" Elevation="0" Class="upcsg-panel">
                    <MudText Typo="Typo.overline" Class="upcsg-panel__title">Status</MudText>
                    <OrderStatusChain Order="_order" />
                </MudPaper>

                @if (_order.HasRefundDue || _order.RefundHasBeenSettled)
                {
                    <MudPaper Square="true" Elevation="0" Class="upcsg-panel upcsg-panel--owed mt-4">
                        <MudText Typo="Typo.overline" Class="upcsg-panel__title">
                            @(_order.RefundHasBeenSettled ? "Refund sent" : "Refund owed")
                        </MudText>

                        @if (_order.RefundHasBeenSettled)
                        {
                            <MudText Typo="Typo.body2">
                                &#8369;@(((_order.AmountPaid ?? _order.Total) - _order.FulfilledTotal).ToString("N2"))
                                returned on @_order.RefundSettledAt!.Value.ToLocalTime().ToString("MMM d, h:mm tt").
                            </MudText>
                            <MudText Typo="Typo.body2" Class="upcsg-fact__mono mt-1">
                                @_order.RefundReference
                            </MudText>
                            <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
                                Settled refunds are final — a restock can no longer put these lines back.
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.h6" Class="upcsg-gradient-text mb-2">
                                &#8369;@_order.RefundDue.ToString("N2")
                            </MudText>

                            <MudText Typo="Typo.caption" Class="upcsg-panel__hint mb-3">
                                Restocking is usually the better fix — send the money back only when
                                you genuinely can't supply the item.
                            </MudText>

                            <MudStack Spacing="2">
                                @foreach (var line in _order.Lines.Where(l => l.IsRefundDue))
                                {
                                    var l = line;
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Inventory"
                                               Disabled="_busy"
                                               OnClick="() => RefulfilAsync(l)">
                                        Fill @l.ItemName@(l.Variant is null ? "" : $" ({l.Variant})") from stock
                                    </MudButton>
                                }

                                <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.CurrencyExchange" DropShadow="false"
                                           Disabled="_busy" OnClick="SettleRefundAsync">
                                    Record refund sent
                                </MudButton>
                            </MudStack>
                        }
                    </MudPaper>
                }

                <MudPaper Square="true" Elevation="0" Class="upcsg-panel mt-4">
                    <MudText Typo="Typo.overline" Class="upcsg-panel__title">Actions</MudText>

                    @if (HasActions)
                    {
                        <MudStack Spacing="2">
                            @if (_order.Status == OrderStatusDto.Pending)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Check" DropShadow="false"
                                           Disabled="_busy" OnClick="() => TransitionAsync(OrderStatusDto.Acknowledged)">
                                    Confirm payment
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.Undo"
                                           Disabled="_busy" OnClick="RejectReceiptAsync">
                                    Reject receipt
                                </MudButton>
                            }
                            else if (_order.Status == OrderStatusDto.Acknowledged)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.LocalShipping" DropShadow="false"
                                           Disabled="_busy" OnClick="() => TransitionAsync(OrderStatusDto.Released)">
                                    Mark released
                                </MudButton>
                            }
                            else if (_order.Status == OrderStatusDto.Released)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.DoneAll" DropShadow="false"
                                           Disabled="_busy" OnClick="() => TransitionAsync(OrderStatusDto.Received)">
                                    Mark received
                                </MudButton>
                            }

                            @if (CanCancel)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true"
                                           Disabled="_busy" OnClick="CancelAsync">
                                    Cancel order
                                </MudButton>
                            }
                        </MudStack>
                    }

                    <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
                        @OrderStatusDisplay.OfficerHint(_order.Status)
                    </MudText>
                </MudPaper>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private OrderDto? _order;
    private bool _loading = true;
    private bool _busy;

    private bool CanCancel => _order is not null
        && _order.Status is OrderStatusDto.AwaitingPayment
                         or OrderStatusDto.Pending
                         or OrderStatusDto.Acknowledged;

    private bool HasActions => _order is not null
        && (CanCancel || _order.Status is OrderStatusDto.Pending
                                       or OrderStatusDto.Acknowledged
                                       or OrderStatusDto.Released);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _order = await OrderService.GetAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TransitionAsync(OrderStatusDto next)
    {
        _busy = true;

        try
        {
            _order = await OrderService.ChangeStatusAsync(Id, next, null);
            Snackbar.Add($"Order #{OrderReference.For(Id)} → {OrderStatusDisplay.Label(next)}", Severity.Success);
        }
        catch (Exception ex) when (next == OrderStatusDto.Acknowledged && LooksLikeShortfall(ex.Message))
        {
            _busy = false;
            await OfferShortfallAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool LooksLikeShortfall(string message) =>
        message.Contains("ordered,", StringComparison.OrdinalIgnoreCase)
        && message.Contains("left", StringComparison.OrdinalIgnoreCase);

    private async Task OfferShortfallAsync(string reason)
    {
        var proceed = await DialogService.ShowMessageBoxAsync(
            "Not enough stock",
            $"{reason}\n\nYou can acknowledge anyway: the guilder gets what's available, and "
            + "the rest is recorded as owed back. Restocking later can still fill it.",
            yesText: "Acknowledge and owe the difference",
            cancelText: "Leave it pending");

        if (proceed != true)
        {
            return;
        }

        _busy = true;

        try
        {
            _order = await OrderService.ChangeStatusAsync(
                Id, OrderStatusDto.Acknowledged, null, allowShortfall: true);

            Snackbar.Add($"Acknowledged. ₱{_order.RefundDue:N2} is owed back.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefulfilAsync(OrderLineDto line)
    {
        _busy = true;

        try
        {
            _order = await OrderService.RefulfilLineAsync(Id, line.MerchItemId, line.Variant);
            Snackbar.Add($"{line.ItemName} filled from stock.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SettleRefundAsync()
    {
        var reference = await PromptAsync(
            $"Record refund for #{OrderReference.For(Id)}",
            "GCash reference of the money you sent back");

        if (string.IsNullOrWhiteSpace(reference))
        {
            return;
        }

        _busy = true;

        try
        {
            _order = await OrderService.SettleRefundAsync(Id, reference);
            Snackbar.Add("Refund recorded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectReceiptAsync()
    {
        var reason = await PromptAsync($"Reject receipt for #{OrderReference.For(Id)}", "What's wrong with it?");
        if (string.IsNullOrWhiteSpace(reason))
        {
            return;
        }

        _busy = true;

        try
        {
            _order = await OrderService.RejectReceiptAsync(Id, reason);
            Snackbar.Add("Receipt sent back to the guilder.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync()
    {
        // Cancelling an acknowledged order now puts its stock back, which is a real
        // change to the shelf. Say so before it happens rather than after.
        if (_order?.Status == OrderStatusDto.Acknowledged)
        {
            var returning = _order.Lines
                .Where(l => l.Status == OrderLineStatusDto.ToFulfil)
                .Sum(l => l.Quantity);

            var ok = await DialogService.ShowMessageBoxAsync(
                "Cancel a confirmed order",
                $"This order was confirmed, so {returning} item(s) were already taken off the "
                + "shelf. Cancelling puts them back into stock.\n\nIf the guilder has paid, you "
                + "will still need to return the money yourself — cancelling does not send it.",
                yesText: "Continue",
                cancelText: "Keep the order");

            if (ok != true)
            {
                return;
            }
        }

        var reason = await PromptAsync($"Cancel order #{OrderReference.For(Id)}", "Reason (the guilder will see this)");
        if (string.IsNullOrWhiteSpace(reason))
        {
            return;
        }

        _busy = true;

        try
        {
            _order = await OrderService.ChangeStatusAsync(Id, OrderStatusDto.Cancelled, reason);
            Snackbar.Add($"Order #{OrderReference.For(Id)} cancelled.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Ago(DateTimeOffset when)
    {
        var span = DateTimeOffset.Now - when;

        return span switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalMinutes: < 60 } => $"{(int)span.TotalMinutes} minutes ago",
            { TotalHours: < 24 } => $"{(int)span.TotalHours} hours ago",
            { TotalDays: < 7 } => $"{(int)span.TotalDays} days ago",
            _ => when.ToLocalTime().ToString("MMM d"),
        };
    }

    private async Task<string?> PromptAsync(string title, string label)
    {
        var parameters = new DialogParameters<ReasonDialog> { { x => x.Label, label } };
        var dialog = await DialogService.ShowAsync<ReasonDialog>(title, parameters);
        var result = await dialog.Result;

        return result is { Canceled: false, Data: string reason } ? reason : null;
    }
}
