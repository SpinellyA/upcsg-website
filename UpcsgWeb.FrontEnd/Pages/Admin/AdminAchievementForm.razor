@page "/admin/achievements/new"
@page "/admin/achievements/{Id:guid}"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAchievementService Achievements
@inject IAdminContentService Admin
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "New entry" : _item.Title) - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <MudLink Href="admin/achievements" Class="mb-3 d-inline-block">&larr; All entries</MudLink>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    }
    else if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">That entry no longer exists.</MudAlert>
    }
    else
    {
        <div class="upcsg-section-head">
            <div>
                <p class="upcsg-kicker">Guild CMS</p>
                <h1 class="upcsg-title-xl">@(IsNew ? "New entry" : _item.Title)</h1>
            </div>
        </div>

        <AdminNav />

        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
            Only publish what the ExeCom can verify &mdash; the public page says so explicitly.
        </MudAlert>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Square="true" Elevation="0" Class="mt-4">@_error</MudAlert>
        }

        @* Laid out like the article it produces: the photo that heads the story, then
           the story. *@
        <div class="upcsg-merchform mt-4">
            <MudPaper Square="true" Elevation="0" Class="upcsg-panel">
                <MudText Typo="Typo.overline" Class="upcsg-panel__title">Photo</MudText>

                <SinglePhotoField Url="@_item.ImageUrl"
                                  UrlChanged="OnImageChanged"
                                  Folder="achievements"
                                  Alt="@($"Photo for {_item.Title}")"
                                  EmptyLabel="Upload photo" />

                <MudText Typo="Typo.caption" Class="upcsg-panel__hint">
                    Heads the entry's own page and its card in the hall. A photo of the team
                    beats a photo of a certificate.
                </MudText>
            </MudPaper>

            <MudPaper Square="true" Elevation="0" Class="upcsg-panel">
                <MudText Typo="Typo.overline" Class="upcsg-panel__title">Entry</MudText>

                <MudTextField @bind-Value="_item.Title" Immediate="true"
                              Label="Title" Variant="Variant.Outlined" Required="true"
                              HelperText="What was won or achieved, as it should read in the hall."
                              TextChanged="_ => Touch()" Class="mb-4" />

                <MudNumericField T="int" Value="_item.Year" ValueChanged="OnYearChanged"
                                 Label="Year" Variant="Variant.Outlined"
                                 Min="1900" Max="@(DateTime.Now.Year + 1)" Class="mb-4" />

                @* Free text with suggestions: the public page derives its filter chips
                   from whatever is stored here, so consistency matters more than choice. *@
                <MudAutocomplete T="string" Value="_item.Category" ValueChanged="OnCategoryChanged"
                                 Label="Category"
                                 Variant="Variant.Outlined"
                                 CoerceValue="true"
                                 SearchFunc="SearchCategories"
                                 HelperText="Reuse an existing one where it fits — each new value becomes a filter chip."
                                 Class="mb-4" />
            </MudPaper>
        </div>

        <MudPaper Square="true" Elevation="0" Class="upcsg-panel mt-4">
            <MudText Typo="Typo.overline" Class="upcsg-panel__title">The story</MudText>

            <MudTextField @bind-Value="_item.Description" Immediate="true"
                          Label="Description" Variant="Variant.Outlined" Lines="10"
                          HelperText="Leave a blank line between paragraphs. The first is the summary shown on the card."
                          TextChanged="_ => Touch()" />
        </MudPaper>

        <div class="upcsg-formbar">
            @if (!IsNew)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" Class="mr-auto"
                           StartIcon="@Icons.Material.Filled.DeleteOutline"
                           Disabled="_saving" OnClick="DeleteAsync">
                    Delete entry
                </MudButton>
            }

            @if (_dirty)
            {
                <span class="upcsg-savebar__dirty">Unsaved changes</span>
            }

            <MudButton Variant="Variant.Text" Disabled="_saving" OnClick="Leave">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                       Disabled="_saving || string.IsNullOrWhiteSpace(_item.Title)"
                       OnClick="SaveAsync">
                @(_saving ? "Saving…" : "Save entry")
            </MudButton>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private static readonly string[] Suggested =
        ["Competition", "Recognition", "Community", "Milestone"];

    private AchievementDto _item = new();
    private bool _loading = true;
    private bool _notFound;
    private bool _saving;
    private bool _dirty;
    private string? _error;

    /// <summary>
    /// True while the form is being populated. The numeric and autocomplete fields raise
    /// their Changed callbacks when a bound value is first set, not only when someone
    /// edits — without this, opening a record marks it dirty for no reason.
    /// </summary>
    private bool _populating;

    private bool IsNew => Id is null;

    protected override void OnAfterRender(bool firstRender) => _populating = false;

    private Task<IEnumerable<string>> SearchCategories(string? value, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? Suggested.AsEnumerable()
            : Suggested.Where(c => c.Contains(value, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _error = null;
        _dirty = false;

        try
        {
            if (Id is { } id)
            {
                var found = await Achievements.GetAchievementAsync(id);

                if (found is null)
                {
                    _notFound = true;
                }
                else
                {
                    // Armed immediately before the controls first receive these values.
                    _populating = true;
                    _item = found;
                }
            }
            else
            {
                _populating = true;
                _item = new AchievementDto { Year = DateTime.Now.Year, Category = "Competition" };
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Touch()
    {
        if (!_populating)
        {
            _dirty = true;
        }
    }

    private void OnYearChanged(int value)
    {
        _item.Year = value;
        Touch();
    }

    private void OnCategoryChanged(string? value)
    {
        _item.Category = value;
        Touch();
    }

    private void OnImageChanged(string? url)
    {
        _item.ImageUrl = url;
        Touch();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            var saved = await Admin.SaveAchievementAsync(_item);
            Snackbar.Add("Saved.", Severity.Success);

            // A new entry now has an id; land on its own URL so a reload doesn't create
            // a second copy.
            if (IsNew)
            {
                Navigation.NavigateTo($"admin/achievements/{saved.Id}", replace: true);
                return;
            }

            _populating = true;
            _item = saved;
            _dirty = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Delete entry",
            $"Delete \"{_item.Title}\"? This removes it from the hall and from its own page.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _saving = true;

        try
        {
            await Admin.DeleteAchievementAsync(_item.Id);
            Snackbar.Add("Deleted.", Severity.Success);

            _dirty = false;
            Navigation.NavigateTo("admin/achievements");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _saving = false;
        }
    }

    private async Task Leave()
    {
        if (_dirty)
        {
            var ok = await Dialogs.ShowMessageBoxAsync(
                "Discard changes?",
                "This entry has edits that haven't been saved.",
                yesText: "Discard", cancelText: "Keep editing");

            if (ok != true)
            {
                return;
            }
        }

        Navigation.NavigateTo("admin/achievements");
    }
}
