@using UpcsgWeb.Shared.Contracts

@* One place decides what a Hall of Fame image looks like, so the lead, the grid cards and
   the article can't drift apart. Most entries have no photo yet — the crest plate is the
   normal case, not an error state, so it gets a real design rather than a grey box.

   Renders inline-level elements only: callers place this inside <span> wrappers. *@

@if (string.IsNullOrWhiteSpace(Entry.ImageUrl))
{
    <span class="upcsg-achimg upcsg-achimg--placeholder">
        <img class="upcsg-achimg__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
        <span class="upcsg-achimg__year">@Entry.Year</span>
    </span>
}
else
{
    @* CMS-supplied URL, so it may be dead. Fall back to the same crest plate rather than
       collapsing to a 0-height gap. *@
    <span class="upcsg-achimg">
        @* onerror is cleared first: if the crest itself ever 404s, this would otherwise
           re-fire forever. *@
        <img src="@Entry.ImageUrl" alt="@Entry.Title" loading="lazy"
             onerror="this.onerror=null; this.src='img/upcsg-crest.png'; this.alt=''; this.classList.add('upcsg-achimg__crest'); this.closest('.upcsg-achimg').classList.add('upcsg-achimg--placeholder');" />
        <span class="upcsg-achimg__year">@Entry.Year</span>
    </span>
}

@code {
    [Parameter, EditorRequired] public AchievementDto Entry { get; set; } = default!;
}
