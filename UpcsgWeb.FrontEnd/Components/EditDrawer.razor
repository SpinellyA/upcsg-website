@using UpcsgWeb.FrontEnd.Services

@* Drawer chrome shared by every in-place editor. The page supplies the fields; this owns
   the frame, the dirty guard and the save/cancel buttons so all three pages behave the same.

   Overlay, not push: the page behind must not reflow when the drawer opens, or the officer
   is previewing a layout nobody will ever see. *@

<MudDrawer Open="Open"
           OpenChanged="OnOpenChanged"
           Anchor="Anchor.End"
           Elevation="0"
           Variant="@DrawerVariant.Temporary"
           Class="upcsg-editdrawer">
    <div class="upcsg-editdrawer__head">
        <div>
            <p class="upcsg-kicker">Editing</p>
            <h2 class="upcsg-editdrawer__title">@Title</h2>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       Title="Close editor"
                       OnClick="RequestCloseAsync" />
    </div>

    <div class="upcsg-editdrawer__body">
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            @* The domain's own message, verbatim: "Year 2031 is out of range." says more
               than anything this component could invent. *@
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@Error</MudAlert>
        }

        @ChildContent
    </div>

    <div class="upcsg-editdrawer__foot">
        @if (Dirty)
        {
            <span class="upcsg-editdrawer__dirty">Unsaved changes</span>
        }

        <MudButton Variant="Variant.Text" Disabled="Saving" OnClick="RequestCloseAsync">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Class="upcsg-cta-button px-6"
                   Disabled="Saving || !Dirty || !CanSave"
                   OnClick="OnSave">
            @(Saving ? "Saving…" : "Save")
        </MudButton>
    </div>
</MudDrawer>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "Edit";
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Saving { get; set; }

    /// <summary>False while a required field is empty; keeps the domain from 400-ing us.</summary>
    [Parameter] public bool CanSave { get; set; } = true;

    [Parameter] public string? Error { get; set; }

    /// <summary>
    /// Whether closing discards the edit. False when the drawer is a secondary panel over
    /// an edit that continues elsewhere — closing it there loses nothing, so prompting
    /// would train officers to click through a warning that never meant anything.
    /// </summary>
    [Parameter] public bool Guard { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    [Inject] private IDialogService Dialogs { get; set; } = default!;

    /// <summary>
    /// Confirms before discarding. Clicking the scrim is easy to do by accident, and losing
    /// three paragraphs of a write-up to a stray click is the kind of thing that stops
    /// people trusting the editor.
    /// </summary>
    private async Task RequestCloseAsync()
    {
        if (Dirty && Guard)
        {
            var ok = await Dialogs.ShowMessageBoxAsync(
                "Discard changes?",
                "This entry has edits that haven't been saved.",
                yesText: "Discard",
                cancelText: "Keep editing");

            if (ok != true)
            {
                return;
            }
        }

        await OnCancel.InvokeAsync();
    }

    // MudDrawer raises this for scrim clicks and Esc; route them through the same guard.
    private Task OnOpenChanged(bool open) => open ? Task.CompletedTask : RequestCloseAsync();
}
