# Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# Publish output. `publish/` is the frontend; `out/` is what the documented API build
# command produces. Neither is harmless to commit: a publish copies wwwroot/media, so it
# carries uploaded GCash receipts - guilders' payment proofs - into the repository.
publish/
out/
[Pp]ublish[Oo]utput/

# Secrets — the Supabase connection string and the JWT signing key live in
# appsettings.Development.local.json locally (matched below, so it cannot be committed)
# and in environment variables on Render. Nothing tracked should ever hold a credential;
# appsettings.json in particular is tracked and has been since the first commit.
appsettings.*.local.json
*.pfx
*.p12
.env
.env.*

# NuGet
*.nupkg
.nuget/
packages/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Local media store output. Development only - production writes to R2, and
# Render's disk is ephemeral anyway.
UpcsgWeb.Api/wwwroot/media/

# stdout/stderr and pid file from scripts/dev.ps1
.dev-logs/
