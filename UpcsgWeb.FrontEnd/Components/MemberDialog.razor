@using UpcsgWeb.Shared.Contracts

<MudDialog Class="upcsg-mdlg__paper"
           ContentClass="upcsg-mdlg__content"
           ActionsClass="upcsg-mdlg__actions">
    <DialogContent>
        <div class="upcsg-mdlg"
             tabindex="-1"
             @ref="_root"
             @onkeydown="OnKeyDownAsync">

            <MudIconButton Icon="@Icons.Material.Rounded.Close"
                           Size="Size.Small"
                           Class="upcsg-mdlg__close"
                           aria-label="Close"
                           OnClick="Close" />

            <div class="upcsg-mdlg__stage" @key="_index">

                @* Masthead: portrait cut into a disc over the nebula, name beside it.
                   The old layout had the name overlaid on the photo, which meant the
                   longer names sat on a face. *@
                <header class="upcsg-mdlg__head">
                    <div class="upcsg-mdlg__bloom" aria-hidden="true"></div>

                    <span class="upcsg-sparkle upcsg-sparkle--gold upcsg-mdlg__spark upcsg-mdlg__spark--a" aria-hidden="true">
                        <span class="upcsg-star"></span>
                    </span>
                    <span class="upcsg-sparkle upcsg-sparkle--lilac upcsg-sparkle--delay-2 upcsg-mdlg__spark upcsg-mdlg__spark--b" aria-hidden="true">
                        <span class="upcsg-star"></span>
                    </span>

                    <CosmicImage Src="@Current.PhotoUrl"
                                 Alt="@Current.Name"
                                 Seed="@Current.Name"
                                 ShowInitials="true"
                                 Eager="true"
                                 Class="upcsg-mdlg__portrait" />

                    <div class="upcsg-mdlg__title" aria-live="polite">
                        <p class="upcsg-mdlg__role">@Current.Role</p>
                        <h2 class="upcsg-mdlg__name">@Current.Name</h2>

                        @if (!string.IsNullOrWhiteSpace(Current.Committee))
                        {
                            <span class="upcsg-mdlg__chip">@Current.Committee</span>
                        }
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(Current.Quote))
                {
                    <blockquote class="upcsg-mdlg__quote">@Current.Quote</blockquote>
                }

                <div class="upcsg-mdlg__body">
                    @if (Paragraphs.Count > 0)
                    {
                        <div class="upcsg-mdlg__prose">
                            @foreach (var paragraph in Paragraphs)
                            {
                                <p>@paragraph</p>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="upcsg-mdlg__prose upcsg-mdlg__prose--none">
                            No profile has been written for @FirstName yet.
                        </p>
                    }

                    @if (Current.Achievements.Count > 0)
                    {
                        <section class="upcsg-mdlg__panel">
                            <h3 class="upcsg-mdlg__panel-title">Record</h3>

                            @* The year is a real gutter, not decoration: it sorts the list
                               and lets the eye scan down one column. Undated entries fall
                               to the bottom with the gutter left empty rather than filled
                               with a guess. *@
                            <ol class="upcsg-mdlg__record">
                                @foreach (var entry in Achievements)
                                {
                                    <li>
                                        <span class="upcsg-mdlg__year">@(entry.Year?.ToString() ?? "")</span>
                                        <span class="upcsg-mdlg__deed">@entry.Title</span>
                                    </li>
                                }
                            </ol>
                        </section>
                    }

                    @if (Current.Links.Count > 0)
                    {
                        <section class="upcsg-mdlg__panel">
                            <h3 class="upcsg-mdlg__panel-title">Reach them</h3>

                            <ul class="upcsg-mdlg__links">
                                @foreach (var link in Current.Links)
                                {
                                    <li>
                                        <a href="@link.Href"
                                           target="@(link.IsEmail ? null : "_blank")"
                                           rel="@(link.IsEmail ? null : "noopener noreferrer")">
                                            <MudIcon Icon="@IconFor(link.Kind)" Size="Size.Small" />
                                            <span class="upcsg-mdlg__linkkind">@link.Kind</span>
                                            <span class="upcsg-mdlg__linkvalue">@link.Display</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        @if (Members.Count > 1)
        {
            <div class="upcsg-mdlg__nav">
                <MudIconButton Icon="@Icons.Material.Rounded.ChevronLeft"
                               Class="upcsg-mdlg__arrow"
                               aria-label="@($"Previous officer, {Neighbour(-1)}")"
                               OnClick="Previous" />

                <span class="upcsg-mdlg__pos">
                    <span class="upcsg-mdlg__pos-now">@((_index + 1).ToString("00"))</span>
                    <span class="upcsg-mdlg__pos-of">/ @Members.Count.ToString("00")</span>
                </span>

                <MudIconButton Icon="@Icons.Material.Rounded.ChevronRight"
                               Class="upcsg-mdlg__arrow"
                               aria-label="@($"Next officer, {Neighbour(1)}")"
                               OnClick="Next" />
            </div>
        }
        else
        {
            <MudButton OnClick="Close">Close</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyList<MemberDto> Members { get; set; } = [];

    [Parameter] public int Index { get; set; }

    private int _index;
    private ElementReference _root;
    private bool _focused;

    private MemberDto Current => Members[_index];

    private string FirstName =>
        Current.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()
        ?? Current.Name;

    private List<string> Paragraphs =>
        [.. (Current.Profile ?? Current.Bio ?? string.Empty)
            .Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(p => p.Replace('\n', ' '))];

    // Newest first, and anything undated after everything dated.
    private List<MemberAchievementDto> Achievements =>
        [.. Current.Achievements
            .OrderByDescending(a => a.Year.HasValue)
            .ThenByDescending(a => a.Year)];

    private static string IconFor(MemberLinkKindDto kind) => kind switch
    {
        MemberLinkKindDto.Email => Icons.Material.Outlined.MailOutline,
        MemberLinkKindDto.Facebook => Icons.Custom.Brands.Facebook,
        MemberLinkKindDto.Instagram => Icons.Custom.Brands.Instagram,
        MemberLinkKindDto.LinkedIn => Icons.Custom.Brands.LinkedIn,
        MemberLinkKindDto.GitHub => Icons.Custom.Brands.GitHub,
        _ => Icons.Material.Outlined.Language,
    };

    protected override void OnParametersSet() =>
        _index = Math.Clamp(Index, 0, Math.Max(0, Members.Count - 1));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _focused)
        {
            return;
        }

        _focused = true;

        try
        {
            await Task.Delay(50);
            await _root.FocusAsync();
        }
        catch (JSException)
        {
        }
    }

    private void OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (Members.Count < 2)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowLeft":
                Previous();
                break;

            case "ArrowRight":
                Next();
                break;
        }
    }

    private void Previous() => _index = (_index - 1 + Members.Count) % Members.Count;

    private void Next() => _index = (_index + 1) % Members.Count;

    private string Neighbour(int offset)
    {
        var i = (_index + offset + Members.Count) % Members.Count;
        return Members[i].Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()
            ?? Members[i].Name;
    }

    private void Close() => MudDialog.Close();
}
