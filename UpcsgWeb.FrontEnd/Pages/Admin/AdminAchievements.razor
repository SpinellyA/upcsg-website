@page "/admin/achievements"
@attribute [Authorize(Policy = "ExeCom")]
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@using UpcsgWeb.FrontEnd.Components
@inject IAdminContentService Admin
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Hall of Fame - UPCSG Admin</PageTitle>

<div class="upcsg-page">
    <div class="upcsg-section-head">
        <div>
            <p class="upcsg-kicker">Guild CMS</p>
            <h1 class="upcsg-title-xl">Hall of Fame</h1>
        </div>
        <MudButton Variant="Variant.Filled" Class="upcsg-cta-button px-6"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">
            New Entry
        </MudButton>
    </div>

    <AdminNav />

    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
        Only publish what the ExeCom can verify &mdash; the public page says so explicitly.
    </MudAlert>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudTable Items="_items"
                  T="AchievementDto"
                  Hover="true"
                  Class="upcsg-datatable mt-4"
                  Elevation="0"
                  Dense="true"
                  Loading="_loading"
                  LoadingProgressColor="Color.Primary"
                  Filter="new Func<AchievementDto, bool>(Matches)"
                  AllowUnsorted="false"
                  OnRowClick="@(args => OpenAsync(args.Item))"
                  RowClass="upcsg-datatable__row">
            <ToolBarContent>
                <MudTextField @bind-Value="_search"
                              Immediate="true"
                              DebounceInterval="150"
                              Placeholder="Search title or category"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Variant="Variant.Text"
                              Clearable="true"
                              Class="upcsg-datatable__search mt-0" />
            </ToolBarContent>
            <HeaderContent>
                @* Most recent first — the newest win is the one being added. *@
                <MudTh Class="upcsg-num">
                    <MudTableSortLabel T="AchievementDto" SortBy="@(a => a.Year)" InitialDirection="SortDirection.Descending">Year</MudTableSortLabel>
                </MudTh>
                <MudTh><MudTableSortLabel T="AchievementDto" SortBy="@(a => a.Title)">Title</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="AchievementDto" SortBy="@(a => a.Category)">Category</MudTableSortLabel></MudTh>
                <MudTh Style="width:3rem"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Year" Class="upcsg-num">@context.Year</MudTd>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Category">@context.Category</MudTd>
                <MudTd Class="upcsg-num upcsg-datatable__chevron">&rsaquo;</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <p class="upcsg-lede my-4">
                    @(string.IsNullOrWhiteSpace(_search) ? "Nothing in the hall yet." : $"Nothing matches \"{_search}\".")
                </p>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="PageSizes" InfoFormat="{first_item}-{last_item} of {all_items} entries" />
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    private static readonly int[] PageSizes = [10, 25, 50];

    private List<AchievementDto> _items = [];
    private string _search = string.Empty;
    private bool _loading = true;
    private string? _error;

    private bool Matches(AchievementDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var term = _search.Trim();

        return item.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
            || (item.Category?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
            || item.Year.ToString().Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _items = await Admin.GetAchievementsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Rows are click-to-open; MudTable hands us the item that was clicked.</summary>
    private Task OpenAsync(AchievementDto? item) => item is null ? Task.CompletedTask : EditAsync(item);

    private async Task EditAsync(AchievementDto? existing)
    {
        var draft = existing is null
            ? new AchievementDto { Year = DateTime.Now.Year, Category = "Competition" }
            : new AchievementDto
            {
                Id = existing.Id,
                Title = existing.Title,
                Description = existing.Description,
                Year = existing.Year,
                Category = existing.Category,
                ImageUrl = existing.ImageUrl,
            };

        var parameters = new DialogParameters<AchievementEditDialog> { { x => x.Item, draft } };
        var dialog = await DialogService.ShowAsync<AchievementEditDialog>(
            existing is null ? "New entry" : $"Edit {existing.Title}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is EditDialogAction.Delete && existing is not null)
        {
            await DeleteAsync(existing);
            return;
        }

        try
        {
            await Admin.SaveAchievementAsync(draft);
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(AchievementDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete entry", $"Delete \"{item.Title}\"?", yesText: "Delete", cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Admin.DeleteAchievementAsync(item.Id);
            Snackbar.Add("Deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
