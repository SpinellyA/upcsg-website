@page "/contact"

<PageTitle>Contact - UPCSG</PageTitle>

<div class="upcsg-page">

<MudText Typo="Typo.h3" Class="upcsg-display" GutterBottom="true">Get in Touch</MudText>
<MudText Class="mb-8" Style="max-width: 60ch;">
    Questions about membership, events, or merch? Reach us through any of the channels below.
</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="upcsg-panel" Square="true" Elevation="0">
            <MudText Typo="Typo.h6" Class="upcsg-heading mb-3">Socials</MudText>
            <MudStack Spacing="2">
                <MudLink Href="https://facebook.com/upcsg" Target="_blank" Color="Color.Inherit">
                    <MudIcon Icon="@Icons.Custom.Brands.Facebook" Class="mr-2" /> /UPCSG
                </MudLink>
                <MudLink Href="https://instagram.com/upcsg" Target="_blank" Color="Color.Inherit">
                    <MudIcon Icon="@Icons.Custom.Brands.Instagram" Class="mr-2" /> @@upcsg
                </MudLink>
                <MudLink Href="mailto:upcsg.upcebu@gmail.com" Color="Color.Inherit">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2" /> upcsg.upcebu@gmail.com
                </MudLink>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="upcsg-panel" Square="true" Elevation="0">
            <MudText Typo="Typo.h6" Class="upcsg-heading mb-3">Join UPCSG</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                Open to all Computer Science majors at UP Cebu. Membership drives are announced at the
                start of each semester on our socials — watch out for the sign-up form.
            </MudText>
            <MudText Typo="Typo.body2">University of the Philippines Cebu</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

</div>
