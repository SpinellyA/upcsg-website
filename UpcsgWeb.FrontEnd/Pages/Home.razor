@page "/"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IEventService EventService
@inject IMerchService MerchService
@inject IMemberService MemberService
@inject IAchievementService AchievementService
@inject IOpportunityService OpportunityFeed
@inject MotionInterop Motion

<PageTitle>UPCSG</PageTitle>

<section class="upcsg-hero" @ref="_hero">
    <div class="upcsg-flare upcsg-hero__flare--orchid"></div>
    <img class="upcsg-hero__burst" src="img/starburst.png" alt="" aria-hidden="true" />

    <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 18%; right: 14%;"><span class="upcsg-star" style="width: 1.5rem; height: 1.5rem;"></span></span>
    <span class="upcsg-sparkle upcsg-sparkle--delay-1" style="top: 38%; right: 28%;"><span class="upcsg-star" style="width: 0.7rem; height: 0.7rem;"></span></span>
    <span class="upcsg-sparkle upcsg-sparkle--lilac upcsg-sparkle--delay-2" style="bottom: 26%; right: 20%;"><span class="upcsg-star" style="width: 1.1rem; height: 1.1rem;"></span></span>

    <div class="upcsg-hero__inner">
        <div class="upcsg-hero__content">
            <p class="upcsg-eyebrow"><span class="upcsg-star"></span> A.Y. 2026&ndash;2027</p>
            <h1 class="upcsg-hero__title">
                UP Computer<br />Science <span class="upcsg-gradient-text">Guild</span>
            </h1>
            <p class="upcsg-hero__lede">
                A diverse and dynamic community at UP Cebu nurturing the next generation of
                trailblazing technology leaders.
            </p>
            <div class="upcsg-hero__actions">
                <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8" Href="about">
                    Learn More
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Large" Class="upcsg-ghost-button px-8" Href="events">
                    See Events
                </MudButton>
            </div>
        </div>
    </div>

    <a class="upcsg-hero__scroll" href="#explore">
        <span>Explore</span>
        <span>&darr;</span>
    </a>
</section>

<Marquee Items="@Ticker" DurationSeconds="46" Class="upcsg-marquee--hero" />

<div class="upcsg-page upcsg-page--after-hero">

    <section id="explore" class="upcsg-section">
        <SectionHeading Kicker="@_month.ToString("MMMM yyyy")"
                        Title="What's on this month">
            <Action>
                <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="events">
                    All events
                </MudButton>
            </Action>
        </SectionHeading>

        @if (_loading)
        {
            <div class="upcsg-cardgrid upcsg-cardgrid--3">
                @for (var i = 0; i < 3; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px"
                                 Class="upcsg-skeleton" />
                }
            </div>
        }
        else if (_events.Count == 0)
        {
            <Reveal Variant="Reveal.RevealMotion.Fade">
                <div class="upcsg-empty">
                    <img src="img/upcsg-crest.png" alt="" aria-hidden="true" />
                    <p>This month's lineup hasn't been posted yet. Check back soon.</p>
                </div>
            </Reveal>
        }
        else
        {
            <div class="upcsg-cardgrid upcsg-cardgrid--3">
                @foreach (var (evt, i) in _events.Take(3).Select((e, i) => (e, i)))
                {
                    <Reveal Variant="Reveal.RevealMotion.Scale" Delay="@(i * 80)">
                        <EventCard Event="evt" />
                    </Reveal>
                }
            </div>
        }
    </section>

    @if (_opportunities.Count > 0)
    {
        <section class="upcsg-section">
            <SectionHeading Kicker="@DeadlineKicker" Title="Worth your time">
                <Action>
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="opportunities">
                        All opportunities
                    </MudButton>
                </Action>
            </SectionHeading>

            <div class="upcsg-cardgrid upcsg-cardgrid--3">
                @foreach (var (item, i) in _opportunities.Take(3).Select((o, i) => (o, i)))
                {
                    <Reveal Variant="Reveal.RevealMotion.Scale" Delay="@(i * 80)">
                        <OpportunityCard Opportunity="item" />
                    </Reveal>
                }
            </div>
        </section>
    }

    <section class="upcsg-section upcsg-feature">
        <Reveal Variant="Reveal.RevealMotion.Left" Class="upcsg-feature__body">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Know your officers</p>
            <h2 class="upcsg-title-xl">The people running it</h2>
            <p class="upcsg-lede">
                @_execCount elected guilders lead the org this year alongside our faculty advisers
                from the Department of Computer Science. They represent the membership, run the
                committees, and keep the guild's programs moving.
            </p>

            <FacePile Members="_members" Selected="_selected" SelectedChanged="SelectOfficer" />

            <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6 mt-6" Href="about">
                Meet the ExeCom
            </MudButton>
        </Reveal>

        <Reveal Variant="Reveal.RevealMotion.Right" Class="upcsg-feature__visual" Delay="120">
            @* Both officers are on the stage during a switch: the outgoing one is lifted out
               of flow and slides off to the right while the incoming one fades in from the
               left. The incoming plate stays in flow so it alone sizes the column. *@
            <div class="upcsg-officerstage">
                @if (_leaving is not null)
                {
                    <CosmicImage @key="@("leaving-" + _leaving.Name)"
                                 Src="@_leaving.PhotoUrl"
                                 Alt=""
                                 Seed="@_leaving.Name"
                                 ShowInitials="true"
                                 Class="upcsg-feature__plate upcsg-officerstage__leaving">
                        <Overlay>
                            <p class="upcsg-feature__plate-role">@_leaving.Role</p>
                            <p class="upcsg-feature__plate-name">@_leaving.Name</p>
                        </Overlay>
                    </CosmicImage>
                }

                @if (_selected is not null)
                {
                    <CosmicImage @key="@("current-" + _selected.Name)"
                                 Src="@_selected.PhotoUrl"
                                 Alt="@_selected.Name"
                                 Seed="@_selected.Name"
                                 ShowInitials="true"
                                 Class="upcsg-feature__plate upcsg-officerstage__current">
                        <Overlay>
                            <p class="upcsg-feature__plate-role">@_selected.Role</p>
                            <p class="upcsg-feature__plate-name">@_selected.Name</p>
                        </Overlay>
                    </CosmicImage>
                }
            </div>
        </Reveal>
    </section>

    <section class="upcsg-section upcsg-band">
        <SectionHeading Kicker="Guild store" Title="Wear the crest">
            <Action>
                <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="merch">
                    Shop all
                </MudButton>
            </Action>
        </SectionHeading>

        @if (_merch.Count == 0)
        {
            <Reveal Variant="Reveal.RevealMotion.Fade">
                <div class="upcsg-empty">
                    <img src="img/upcsg-crest.png" alt="" aria-hidden="true" />
                    <p>Nothing in the store right now. The next drop gets announced on our socials.</p>
                </div>
            </Reveal>
        }
        else
        {
            <div class="upcsg-cardgrid upcsg-cardgrid--4">
                @foreach (var (item, i) in _merch.Take(4).Select((m, i) => (m, i)))
                {
                    <Reveal Variant="Reveal.RevealMotion.Scale" Delay="@(i * 70)">
                        <MerchCard Item="item" />
                    </Reveal>
                }
            </div>
        }
    </section>

    @if (_latestAchievement is not null)
    {
        <section class="upcsg-section upcsg-feature upcsg-feature--reverse">
            <Reveal Variant="Reveal.RevealMotion.Right" Class="upcsg-feature__visual">
                <CosmicImage Src="@_latestAchievement.ImageUrl"
                             Alt="@_latestAchievement.Title"
                             Seed="@_latestAchievement.Title"
                             Badge="@_latestAchievement.Year.ToString()"
                             Class="upcsg-feature__plate" />
            </Reveal>

            <Reveal Variant="Reveal.RevealMotion.Left" Class="upcsg-feature__body" Delay="120">
                <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Hall of fame</p>
                <h2 class="upcsg-title-xl">@_latestAchievement.Title</h2>

                <p class="upcsg-lede">@FirstParagraph(_latestAchievement.Description)</p>

                <div class="upcsg-statrow">
                    <StatCounter Value="_achievements.Count" Label="Wins logged" />
                    <StatCounter Value="_execCount" Label="Officers serving" />
                    <StatCounter Value="_events.Count" Label="Events this month" />
                </div>

                <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6 mt-6"
                           Href="@($"hall-of-fame/{_latestAchievement.Id}")">
                    Read the story
                </MudButton>
            </Reveal>
        </section>
    }

    <section class="upcsg-section upcsg-closing">
        <div class="upcsg-flare upcsg-closing__flare"></div>

        <Reveal Variant="Reveal.RevealMotion.Up" Class="upcsg-closing__inner">
            <p class="upcsg-kicker"><span class="upcsg-star upcsg-star--tiny"></span> Already one of us</p>
            <h2 class="upcsg-title-xl">You're a guilder from day one</h2>
            <p class="upcsg-lede">
                Every Computer Science student at UP Cebu is part of the guild. Nothing to
                sign, nothing to pay. What's up to you is how far in you go: a committee, a
                competition, or just turning up to the next thing on the calendar.
            </p>
            <div class="upcsg-closing__actions">
                <MudButton Variant="Variant.Filled" Size="Size.Large" Class="upcsg-cta-button px-8" Href="events">
                    See what's on
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Large" Class="upcsg-ghost-button px-8" Href="contact">
                    Get in Touch
                </MudButton>
            </div>
        </Reveal>
    </section>

</div>

@code {
    private ElementReference _hero;

    private List<EventDto> _events = [];
    private List<MerchItemDto> _merch = [];
    private List<AchievementDto> _achievements = [];
    private List<OpportunityDto> _opportunities = [];
    private List<MemberDto> _members = [];
    private AchievementDto? _latestAchievement;
    private MemberDto? _lead;

    private MemberDto? _selected;
    private MemberDto? _leaving;
    private int _transition;

    private int _execCount;
    private bool _loading = true;

    private async Task SelectOfficer(MemberDto member) {
        if (_selected?.Name == member.Name) {
            return;
        }

        _leaving = _selected;
        _selected = member;
        var mine = ++_transition;
        StateHasChanged();

        // Hold the outgoing plate on the stage for the length of the animation, then drop
        // it. The transition id guards against a rapid second click clearing the plate that
        // a later switch is still animating out.
        await Task.Delay(450);
        if (mine == _transition) {
            _leaving = null;
            StateHasChanged();
        }
    }

    private DateTime _month = DateTime.Now;

    // The kicker earns its place by saying how urgent the list is, not by repeating the heading.
    private string DeadlineKicker
    {
        get
        {
            var soonest = _opportunities
                .Where(o => o.DaysLeft is not null)
                .Select(o => o.DaysLeft!.Value)
                .DefaultIfEmpty(int.MaxValue)
                .Min();

            return soonest switch
            {
                int.MaxValue => "Get involved",
                <= 0 => "Closing today",
                1 => "Closing tomorrow",
                <= 7 => $"Next deadline in {soonest} days",
                _ => $"{_opportunities.Count} open right now",
            };
        }
    }

    private static readonly string[] Ticker =
    [
        "Academic support", "Competitive programming", "Industry nights", "General assemblies",
        "Merch drops", "Study groups", "Hackathons", "UP Cebu",
    ];

    protected override async Task OnInitializedAsync()
    {
        var (year, month) = await EventService.GetDisplayMonthAsync();
        _month = new DateTime(year, month, 1);

        _events = (await EventService.GetThisMonthEventsAsync())
            .OrderBy(e => e.StartDateTime)
            .ToList();

        _merch = await MerchService.GetMerchAsync();

        _opportunities = await OpportunityFeed.GetOpenAsync();

        _achievements = await AchievementService.GetAchievementsAsync();
        _latestAchievement = _achievements
            .OrderByDescending(a => a.Year)
            .ThenByDescending(a => a.CreatedAt)
            .FirstOrDefault();

        _members = await MemberService.GetMembersAsync();
        _execCount = _members.Count(m => m.Category == MemberCategory.ExeCom);

        _lead = _members
            .Where(m => m.Category == MemberCategory.ExeCom)
            .OrderBy(m => m.DisplayOrder)
            .FirstOrDefault();

        _selected = _lead;

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Motion.TrackScrollAsync(_hero);
        }
    }

    private static string FirstParagraph(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var end = text.IndexOf("\n\n", StringComparison.Ordinal);
        return end > 0 ? text[..end].Trim() : text.Trim();
    }
}
