@page "/events/{Id:guid}"
@using UpcsgWeb.Shared.Contracts
@using UpcsgWeb.FrontEnd.Services
@inject IEventService EventService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_event?.Title ?? "Event") - UPCSG</PageTitle>

@if (_loading)
{
    <div class="upcsg-page">
        <MudProgressLinear Indeterminate="true" Class="my-8" />
    </div>
}
else if (_event is null)
{
    <div class="upcsg-page">
        <MudAlert Severity="Severity.Warning">
            We couldn't find that event. It may have been removed, or the link may be wrong.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6 mt-4" Href="events">
            Back to Events
        </MudButton>
    </div>
}
else
{
    <section class="upcsg-banner upcsg-eventhero">
        <img class="upcsg-banner__crest" src="img/upcsg-crest.png" alt="" aria-hidden="true" />
        <span class="upcsg-sparkle upcsg-sparkle--gold" style="top: 24%; right: 30%;">
            <span class="upcsg-star" style="width: 1rem; height: 1rem;"></span>
        </span>

        <div class="upcsg-banner__inner">
            <p class="upcsg-eyebrow">
                <span class="upcsg-star"></span>
                @Starts.ToString("dddd, MMMM d, yyyy")
            </p>
            <h1 class="upcsg-banner__title">@_event.Title</h1>

            <div class="upcsg-eventhero__meta">
                <span class="upcsg-statuspill upcsg-statuspill--@StatusSlug">@StatusLabel</span>
                <span class="upcsg-eventhero__where">
                    <MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" />
                    @_event.Location
                </span>
            </div>
        </div>
    </section>

    <div class="upcsg-page upcsg-page--after-hero">
        <MudLink Href="events" Class="mb-4 d-inline-block">&larr; All events this month</MudLink>

        @* The facts run across the top rather than down a rail beside the copy. A tall
           column of prose next to a short column of labels never balances, and the
           mismatch only gets worse the more an officer writes. *@
        <MudPaper Elevation="0" Class="upcsg-surface upcsg-glance mb-6">
            <MudGrid Spacing="3">
                <MudItem xs="6" md="3">
                    <p class="upcsg-glance__label">When</p>
                    <p class="upcsg-glance__value">@Starts.ToString("ddd, MMM d")</p>
                </MudItem>

                <MudItem xs="6" md="3">
                    <p class="upcsg-glance__label">Time</p>
                    @* – rather than a literal en dash: this file has been through a
                       tool that mangles non-ASCII, and an escape cannot be corrupted. *@
                    <p class="upcsg-glance__value">
                        @Starts.ToString("h:mm tt")@(Ends is { } e ? $" – {e:h:mm tt}" : "")
                    </p>
                </MudItem>

                <MudItem xs="6" md="3">
                    <p class="upcsg-glance__label">Runs for</p>
                    <p class="upcsg-glance__value">
                        @(Ends is { } ends ? DurationLabel(ends - Starts) : "Not announced")
                    </p>
                </MudItem>

                <MudItem xs="6" md="3">
                    <p class="upcsg-glance__label">Where</p>
                    <p class="upcsg-glance__value">@_event.Location</p>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap"
                      AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                @* Takes its colour from the status rather than always being gold, so a
                   finished event stops shouting the same way an upcoming one does. *@
                <span class="upcsg-glance__countdown upcsg-glance__countdown--@StatusSlug">
                    @Countdown
                </span>

                @* Share is the only action left, so it carries the filled treatment while
                   the event is still ahead and steps back once it's over. *@
                <MudButton Variant="@(HasEnded ? Variant.Outlined : Variant.Filled)"
                           Class="@(HasEnded ? "upcsg-ghost-button px-6" : "upcsg-cta-button px-6")"
                           StartIcon="@Icons.Material.Outlined.Share"
                           OnClick="ShareAsync">
                    Share
                </MudButton>
            </MudStack>

            @if (IsOnline)
            {
                <p class="upcsg-glance__note">
                    <MudIcon Icon="@Icons.Material.Outlined.Videocam" Size="Size.Small" />
                    Runs online. The joining link goes out in the guild channels closer to the day.
                </p>
            }
        </MudPaper>

        @* Poster beside the copy when there is one, copy full width when there isn't —
           rather than a fixed column that leaves a hole on text-only events. *@
        <MudGrid Spacing="4" Class="upcsg-section">
            @if (!string.IsNullOrWhiteSpace(_event.PosterUrl))
            {
                <MudItem xs="12" md="5">
                    @* Poster URLs come from the CMS, so treat a dead one the same way the
                       receipt panel does: say so rather than leaving a blank frame. *@
                    <MudPaper Elevation="0" Class="upcsg-surface upcsg-eventposter">
                        <img src="@_event.PosterUrl" alt="Poster for @_event.Title"
                             onerror="this.closest('.upcsg-eventposter').classList.add('upcsg-eventposter--broken')" />
                        <p class="upcsg-eventposter__broken">Poster image couldn't be loaded.</p>
                    </MudPaper>
                </MudItem>
            }

            <MudItem xs="12" md="@(string.IsNullOrWhiteSpace(_event.PosterUrl) ? 12 : 7)">
                <MudPaper Elevation="0" Class="upcsg-surface upcsg-eventbody">
                    <p class="upcsg-kicker">About this event</p>

                    @foreach (var paragraph in Paragraphs)
                    {
                        <p class="upcsg-eventbody__para">@paragraph</p>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>


        @if (_others.Count > 0)
        {
            <section class="upcsg-section">
                <div class="upcsg-section-head">
                    <div>
                        <p class="upcsg-kicker">Also on this month</p>
                        <h2 class="upcsg-title-xl">More events</h2>
                    </div>
                    <MudButton Variant="Variant.Outlined" Class="upcsg-ghost-button px-6" Href="events">
                        View calendar
                    </MudButton>
                </div>

                @* Cards in a grid rather than full-width bars: three short entries
                   shouldn't take the same vertical run as the article above them. *@
                <MudGrid Spacing="3">
                    @foreach (var other in _others)
                    {
                        var when = other.StartDateTime.ToLocalTime();

                        <MudItem xs="12" sm="6" md="4">
                            @* Flat ink rather than the gradient surface: these are a quiet
                               index at the foot of the page, and three more glowing cards
                               after the article competed with it. *@
                            <MudPaper Elevation="0" Class="upcsg-othercard"
                                      @onclick="@(() => Navigation.NavigateTo($"events/{other.Id}"))">
                                <span class="upcsg-datechip">
                                    <span class="upcsg-datechip__month">@when.ToString("MMM")</span>
                                    <span class="upcsg-datechip__day">@when.Day</span>
                                </span>
                                <div>
                                    <p class="upcsg-othercard__title">@other.Title</p>
                                    <p class="upcsg-othercard__meta">
                                        @when.ToString("h:mm tt") &middot; @other.Location
                                    </p>
                                </div>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </section>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private EventDto? _event;
    private List<EventDto> _others = [];
    private bool _loading = true;

    // The API hands back UTC; every other page renders event times with ToLocalTime, so
    // these convert once here rather than sprinkling it through the markup.
    private DateTime Starts => (_event?.StartDateTime ?? default).ToLocalTime();

    private DateTime? Ends => _event?.EndDateTime?.ToLocalTime();

    /// <summary>Blank-line-separated paragraphs, so long copy doesn't render as one wall.</summary>
    private IEnumerable<string> Paragraphs =>
        (_event?.Description ?? string.Empty)
            .Replace("\r\n", "\n")
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(p => p.Replace('\n', ' '));

    private bool HasEnded => _event is not null
        && (Ends ?? Starts) < DateTime.Now;

    private bool IsUnderway => _event is not null
        && Starts <= DateTime.Now
        && !HasEnded;

    private string StatusLabel => IsUnderway ? "Happening now" : HasEnded ? "Finished" : "Upcoming";

    // Reuses the order status pill colours: gold for "needs your attention now",
    // muted for done, lavender for pending.
    private string StatusSlug => IsUnderway ? "pending" : HasEnded ? "received" : "confirmed";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _event = null;
        _others = [];

        try
        {
            _event = await EventService.GetEventAsync(Id);

            if (_event is not null)
            {
                var month = await EventService.GetThisMonthEventsAsync();
                _others = month
                    .Where(e => e.Id != Id)
                    .OrderBy(e => e.StartDateTime)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string DurationLabel(TimeSpan span)
    {
        var hours = (int)span.TotalHours;
        var minutes = span.Minutes;

        if (hours == 0)
        {
            return $"{minutes} min";
        }

        return minutes == 0 ? $"{hours} hr" : $"{hours} hr {minutes} min";
    }

    /// <summary>
    /// Words that mean "there is nowhere to walk to". Checked against the location the
    /// officers type, since the record has no separate flag for it.
    /// </summary>
    private static readonly string[] OnlineWords =
        ["online", "google meet", "meet.google", "zoom", "discord", "virtual", "webinar", "stream"];

    private bool IsOnline => _event is not null
        && OnlineWords.Any(w => _event.Location.Contains(w, StringComparison.OrdinalIgnoreCase));

    /// <summary>How far off it is, in the terms someone would actually say it.</summary>
    private string Countdown
    {
        get
        {
            if (IsUnderway)
            {
                return "Happening now";
            }

            if (HasEnded)
            {
                var since = DateTime.Now - (Ends ?? Starts);
                return since.TotalDays >= 1
                    ? $"Finished {Describe(since)} ago"
                    : "Finished earlier today";
            }

            var until = Starts - DateTime.Now;

            return until.TotalMinutes < 60
                ? $"Starts in {Math.Max(1, (int)until.TotalMinutes)} min"
                : $"Starts in {Describe(until)}";
        }
    }

    private static string Describe(TimeSpan span)
    {
        var days = (int)span.TotalDays;

        if (days >= 14)
        {
            return $"{days / 7} weeks";
        }

        if (days >= 1)
        {
            return days == 1 ? "a day" : $"{days} days";
        }

        var hours = (int)span.TotalHours;
        return hours <= 1 ? "an hour" : $"{hours} hours";
    }

    private async Task ShareAsync()
    {
        // The phone's own share sheet is how this actually reaches a groupchat;
        // copying the link is the desktop fallback.
        var result = await JS.InvokeAsync<string>("upcsgShare", _event?.Title ?? "UPCSG event", Navigation.Uri);

        switch (result)
        {
            case "shared":
                break;
            case "copied":
                Snackbar.Add("Link copied.", Severity.Success);
                break;
            case "cancelled":
                break;
            default:
                Snackbar.Add("Couldn't share. You can copy the link from the address bar.", Severity.Warning);
                break;
        }
    }
}
