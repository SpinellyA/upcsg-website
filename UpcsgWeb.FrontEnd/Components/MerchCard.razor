@using UpcsgWeb.Shared.Contracts

<a class="upcsg-merchcard upcsg-merchcard--@Variant.ToString().ToLowerInvariant() @(Item.InStock ? null : "upcsg-merchcard--out")"
   href="@($"merch/{Item.Id}")">

    <CosmicImage Src="@Photo"
                 Alt="@Item.Name"
                 Seed="@Item.Name"
                 Badge="@Flag"
                 Class="upcsg-merchcard__thumb" />

    <span class="upcsg-merchcard__body">
        @if (Variant == Density.Feature)
        {
            <span class="upcsg-kicker">
                <span class="upcsg-star upcsg-star--tiny" aria-hidden="true"></span> This season's drop
            </span>
        }

        <span class="upcsg-merchcard__name">@Item.Name</span>

        @if (Variant == Density.Feature && !string.IsNullOrWhiteSpace(Item.Description))
        {
            <span class="upcsg-merchcard__blurb">@Prose.Standfirst(Item.Description)</span>
        }

        <span class="upcsg-merchcard__price">
            @if (Item.IsPreorder)
            {
                <span class="upcsg-merchcard__now">&#8369;@Item.PriceFrom.ToString("N2")</span>
            }
            else if (!Item.InStock)
            {
                <span class="upcsg-merchcard__gone">Sold out</span>
            }
            else
            {
                @if (Item.HasPriceRange)
                {
                    <span class="upcsg-merchcard__from">from</span>
                }

                <span class="upcsg-merchcard__now">&#8369;@Item.PriceFrom.ToString("N2")</span>

                @if (Item.HasActiveSale && Item.ListPriceFrom > Item.PriceFrom)
                {
                    <span class="upcsg-merchcard__was">&#8369;@Item.ListPriceFrom.ToString("N2")</span>
                }
            }
        </span>

        @if (Item.Variants.Count > 0)
        {
            <span class="upcsg-merchcard__variants">
                @foreach (var variant in Item.Variants)
                {
                    <span class="upcsg-chip">@variant.Name</span>
                }
            </span>
        }

        <span class="upcsg-merchcard__cue">
            @(Item.InStock ? "View item" : "See details") <span aria-hidden="true">&rarr;</span>
        </span>
    </span>
</a>

@code {
    public enum Density
    {
        Card,

        Feature,
    }

    [Parameter, EditorRequired] public MerchItemDto Item { get; set; } = default!;

    [Parameter] public Density Variant { get; set; } = Density.Card;

    private string? Photo =>
        Item.PhotoUrls.FirstOrDefault(u => !string.IsNullOrWhiteSpace(u)) ?? Item.ImageUrl;

    private string? Flag =>
        Item.IsPreorder ? "Pre-order"
        : Item.HasActiveSale ? $"-{Item.SalePercentage:0.#}%"
        : !Item.InStock ? "Sold out"
        : null;
}
